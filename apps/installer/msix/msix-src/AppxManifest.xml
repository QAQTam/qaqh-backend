<?xml version="1.0" encoding="utf-8"?>
<!--
  DeepX MSIX 壳包（sparse package / external location）清单。

  用途：
  - 为当前目录部署（%LOCALAPPDATA%\Programs\DeepX）提供 MSIX Identity；
  - 声明 Windows App Runtime 框架依赖（系统解析，免手动 Singleton 注册）；
  - 不打包任何文件——所有内容经 -ExternalLocation 指向真实安装目录。

  生命周期（spike 验证）：
    makeappx pack /d msix-src /p DeepX-shell.msix
    signtool sign /fd SHA256 /f DeepX.pfx /p <pw> DeepX-shell.msix
    Add-AppxPackage -Path DeepX-shell.msix -ExternalLocation "%LOCALAPPDATA%\Programs\DeepX"
  卸载：
    Remove-AppxPackage <PackageFullName>
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">

  <Identity
    Name="DeepX"
    Publisher="CN=DeepX"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>DeepX</DisplayName>
    <PublisherDisplayName>DeepX</PublisherDisplayName>
    <Description>DeepX desktop client (external-location shell package)</Description>
    <Logo>Assets\logo150.png</Logo>
    <!-- 允许文件位于包外（external location 注册） -->
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26200.0" />
    <!-- Windows App Runtime 框架依赖：系统解析，免 Bootstrap/Singleton 手动注册 -->
    <!-- 注意：Publisher 必须与框架包 Identity 的完整 DN 精确匹配（CBS 安装版含 O/L/S/C 段） -->
    <PackageDependency
      Name="Microsoft.WindowsAppRuntime.2"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US"
      MinVersion="2.3.1.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="DeepX" Executable="DeepX.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="DeepX"
        Description="DeepX desktop client"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\logo150.png"
        Square44x44Logo="Assets\logo44.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
