{
  "name": "deepx-renderer",
  "version": "1.0.0-beta.8",
  "description": "DeepX web renderer (hosted by the WinUI3 shell)",
  "author": "DeepX",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "vite dev",
