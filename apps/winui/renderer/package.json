    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@antv/g6": "^5.1.1",
    "@solidjs/web": "2.0.0-beta.28",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "24.13.3",
    "jsdom": "^30.0.1",
    "katex": "^0.18.1",
    "marked": "^18.0.7",
    "mermaid": "^11.16.0",
    "shiki": "^4.3.1",
    "solid-js": "2.0.0-beta.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-solid": "3.0.0-next.20",
    "vitest": "^4.1.10"
  }
}