{
  "name": "deepx-desktop",
  "version": "1.0.0-beta.7",
  "description": "DeepX desktop client",
  "author": "DeepX",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "start": "electron-vite preview",
    "prepare:daemon": "node scripts/prepare-daemon.mjs",
    "prepare:daemon:local": "node scripts/prepare-daemon.mjs --backend-root ../..",
    "package:asar": "node scripts/pack-frontend.mjs",
    "package:dir": "pnpm prepare:daemon && pnpm build && electron-builder --dir --win --x64 --publish never",
    "package:dir:local": "pnpm prepare:daemon:local && pnpm build && electron-builder --dir --win --x64 --publish never",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@antv/g6": "^5.1.1",
    "@electron/asar": "3.4.1",
    "@solidjs/web": "2.0.0-beta.28",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "24.13.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "jsdom": "^30.0.1",
    "katex": "^0.18.1",
    "marked": "^18.0.7",
    "mermaid": "^11.16.0",
    "shiki": "^4.3.1",
    "solid-js": "2.0.0-beta.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-solid": "3.0.0-next.20",
    "vitest": "^4.1.10"
  }
}