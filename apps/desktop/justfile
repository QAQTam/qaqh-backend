# DeepX Electron Desktop build system

default:
    @just --list

bootstrap:
    pnpm install --frozen-lockfile

check:
    pnpm typecheck

test:
    pnpm test

build:
    pnpm build

# ── Platform helpers ──────────────────────────────────────

_target  := if os_family() == "windows" { "win" } else { "linux" }
_arch    := if os_family() == "windows" { "x64" } else { "x64" }

# ── Dev ──────────────────────────────────────────────────

[unix]
dev backend="../DeepX":
    cargo build --manifest-path "{{backend}}/Cargo.toml" -p deepx-daemon
    DEEPX_BACKEND_ROOT="{{backend}}" pnpm dev

[windows]
dev backend="../DeepX":
    cargo build --manifest-path "{{backend}}/Cargo.toml" -p deepx-daemon
    $env:DEEPX_BACKEND_ROOT=(Resolve-Path "{{backend}}").Path; pnpm dev

# ── ASAR only ────────────────────────────────────────────

[unix]
package-asar:
    pnpm build
    node scripts/pack-frontend.mjs

[windows]
package-asar:
    pnpm build
    node scripts/pack-frontend.mjs

# ── Full package (dir) ───────────────────────────────────

[unix]
package: package-dir
    @echo "  → packaged for linux in release/"

[windows]
package: package-dir
    @echo "  → packaged for windows in release/"

package-dir:
    pnpm build
    pnpm exec electron-builder --dir --{{_target}} --{{_arch}} --publish never

# ── Full package with local backend ──────────────────────

package-local backend="../DeepX":
    node scripts/prepare-daemon.mjs --backend-root "{{backend}}"
    pnpm build
    pnpm exec electron-builder --dir --{{_target}} --{{_arch}} --publish never
