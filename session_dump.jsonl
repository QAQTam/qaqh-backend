t port = hp_port();\n43\t    if port == 0 {\n44\t        eprintln!(\"dsx-agent: HP not running (no hp.port) — continuing without AI\");\n45\t        return (None, None);\n46\t    }\n47\t\n48\t    let stream = match TcpStream::connect(format!(\"127.0.0.1:{port}\")) {\n49\t        Ok(s) => s,\n50\t        Err(e) => {\n51\t            eprintln!(\"dsx-agent: cannot connect HP: {e}\");\n52\t            return (None, None);\n53\t        }\n54\t    };\n55\t\n56\t    let pid = std::process::id();\n57\t    let reg_frame = format!(r#\"{{\"type\":\"register\",\"kind\":\"Agent\",\"name\":\"dsx-agent\",\"pid\":{pid}}}\"#);\n58\t    let mut writer = stream.try_clone().unwrap();\n59\t    write_frame(&mut writer, &reg_frame);\n60\t\n61\t    let reader = BufReader::new(Box::new(stream.try_clone().unwrap()) as Box<dyn std::io::Read + Send>);\n62\t\n63\t    eprintln!(\"dsx-agent: connected to HP on port {port}\");\n64\t    (Some(reader), Some(Box::new(writer) as Box<dyn std::io::Write + Send>))\n65\t}\n66\t\n67\t// ── Session initialization ──\n68\t\n69\t/// Initialize session: set seed, load previous session if available, init short-term memory.\n70\tfn init_session(agent: &mut AgentState) {\n71\t    // Check for live (interrupted) sessions\n72\t    let lives = session::find_live_sessions();\n73\t    if let Some(meta) = lives.first() {\n74\t        eprintln!(\"dsx-agent: found live session {} ({} msgs, {})\",\n75\t            meta.seed, meta.message_count, meta.last_summary);\n76\t        if let Some(file) = session::load_session(&meta.seed) {\n77\t            agent.session_seed = file.seed.clone();\n78\t            agent.session_start = file.created_at;\n79\t            // Import session messages into ContextAssembler\n80\t            let (ctx, repairs) = crate::conversation::ContextAssembler::from_legacy(file.messages);\n81\t            agent.ctx = ctx;\n82\t            agent.sync_messages();\n83\t            if !repairs.is_empty() {\n84\t                log::warn!(\"session restore repairs: {}\", repairs.join(\"; \"));\n85\t            }\n86\t            agent.short_mem = memory::ShortTermMemory::new(&file.seed, &file.model);\n87\t            // Restore task phase\n88\t            if let Some(phase) = file.task_phase {\n89\t                router::set_phase(phase, dsx_types::DebugLevel::Medium);\n90\t                agent.current_task_phase = phase;\n91\t            }\n92\t            dsc_log::set_session(&agent.session_seed);\n93\t            tools::set_current_session(&agent.session_seed);\n94\t            eprintln!(\"dsx-agent: session {} restored ({} messages)\", agent.session_seed, agent.messages.len());\n95\t            return;\n96\t        }\n97\t    }\n98\t\n99\t    // Fresh session\n100\t    agent.session_seed = session::generate_seed();"}]},"uuid":"a550b8c3-f34a-4d83-ad8e-f8111edc4062","timestamp":"2026-05-15T05:53:10.976Z","toolUseResult":{"type":"text","file":{"filePath":"/home/qaqtamsy/Desktop/dsx/crates/dsx-agent/src/runner.rs","content":"//! dsx-agent — central process. Connects TUI ↔ Agent ↔ Tools ↔ HP.\n//!\n//! Wires all intelligence modules (session, memory, orchestrator, context,\n//! skills, router, tokenizer, health) into the HP-bridged conversation loop.\n\nuse std::io::{BufRead, BufReader, Write};\nuse std::net::TcpStream;\nuse std::process::{Command, Stdio};\nuse crate::agent::{AgentState, ToolResultAppender};\nuse crate::config::Config;\nuse crate::dsc_log;\nuse crate::memory;\nuse crate::orchestrator::{gates, learning, phase_detector, tracker, turn_scorer, session_persistence};\nuse crate::router;\nuse crate::session;\nuse crate::tokenizer;\nuse crate::tools;\nuse dsx_types::{AgentPhase, Message, ToolCall, FunctionCall};\n\n// ── JSON-LP helpers ──\n\nfn read_frame(reader: &mut impl BufRead) -> Option<String> {\n    let mut line = String::new();\n    reader.read_line(&mut line).ok().filter(|n| *n > 0).map(|_| line.trim().to_string())\n}\n\nfn write_frame(writer: &mut impl Write, frame: &str) {\n    let _ = writeln!(writer, \"{frame}\");\n    let _ = writer.flush();\n}\n\n// ── HP connection ──\n\nfn hp_port() -> u16 {\n    let home = std::env::var(\"HOME\").unwrap_or_else(|_| \"/tmp\".into());\n    let path = std::path::PathBuf::from(home).join(\".dsx\").join(\"hp.port\");\n    std::fs::read_to_string(&path).ok().and_then(|s| s.trim().parse().ok()).unwrap_or(0)\n}\n\n/// Connect to HP, register, and return (read_handle, write_handle).\nfn connect_hp() -> (Option<BufReader<Box<dyn std::io::Read + Send>>>, Option<Box<dyn std::io::Write + Send>>) {\n    let port = hp_port();\n    if port == 0 {\n        eprintln!(\"dsx-agent: HP not running (no hp.port) — continuing without AI\");\n        return (None, None);\n    }\n\n    let stream = match TcpStream::connect(format!(\"127.0.0.1:{port}\")) {\n        Ok(s) => s,\n        Err(e) => {\n            eprintln!(\"dsx-agent: cannot connect HP: {e}\");\n            return (None, None);\n        }\n    };\n\n    let pid = std::process::id();\n    let reg_frame = format!(r#\"{{\"type\":\"register\",\"kind\":\"Agent\",\"name\":\"dsx-agent\",\"pid\":{pid}}}\"#);\n    let mut writer = stream.try_clone().unwrap();\n    write_frame(&mut writer, &reg_frame);\n\n    let reader = BufReader::new(Box::new(stream.try_clone().unwrap()) as Box<dyn std::io::Read + Send>);\n\n    eprintln!(\"dsx-agent: connected to HP on port {port}\");\n    (Some(reader), Some(Box::new(writer) as Box<dyn std::io::Write + Send>))\n}\n\n// ── Session initialization ──\n\n/// Initialize session: set seed, load previous session if available, init short-term memory.\nfn init_session(agent: &mut AgentState) {\n    // Check for live (interrupted) sessions\n    let lives = session::find_live_sessions();\n    if let Some(meta) = lives.first() {\n        eprintln!(\"dsx-agent: found live session {} ({} msgs, {})\",\n            meta.seed, meta.message_count, meta.last_summary);\n        if let Some(file) = session::load_session(&meta.seed) {\n            agent.session_seed = file.seed.clone();\n            agent.session_start = file.created_at;\n            // Import session messages into ContextAssembler\n            let (ctx, repairs) = crate::conversation::ContextAssembler::from_legacy(file.messages);\n            agent.ctx = ctx;\n            agent.sync_messages();\n            if !repairs.is_empty() {\n                log::warn!(\"session restore repairs: {}\", repairs.join(\"; \"));\n            }\n            agent.short_mem = memory::ShortTermMemory::new(&file.seed, &file.model);\n            // Restore task phase\n            if let Some(phase) = file.task_phase {\n                router::set_phase(phase, dsx_types::DebugLevel::Medium);\n                agent.current_task_phase = phase;\n            }\n            dsc_log::set_session(&agent.session_seed);\n            tools::set_current_session(&agent.session_seed);\n            eprintln!(\"dsx-agent: session {} restored ({} messages)\", agent.session_seed, agent.messages.len());\n            return;\n        }\n    }\n\n    // Fresh session\n    agent.session_seed = session::generate_seed();","numLines":100,"startLine":1,"totalLines":660}},"sourceToolAssistantUUID":"03543228-d30b-4b35-9852-0a0d790f78f0","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
