_ref().unwrap().try_clone().unwrap());\n                    if let Some(resp) = read_frame(&mut hp_r) {\n                        write_frame(&mut tui_writer, &resp);\n                    }\n                } else if frame.contains(\"\\\"type\\\":\\\"shutdown\\\"\") {\n                    write_frame(&mut tui_writer, r#\"{\"type\":\"shutdown_ack\"}\"#);\n                    break;\n                } else {\n                    write_frame(&mut tui_writer, &format!(r#\"{{\"type\":\"echo\",\"data\":{frame}}}\"#));\n                    write_frame(&mut tui_writer, r#\"{\"type\":\"done\"}\"#);\n                }\n            }\n            None => break,\n        }\n    }\n\n    // Cleanup\n    let _ = tools_child.wait();\n    if let Some(ref hp) = hp {\n        let mut hp_w = hp.try_clone().unwrap();\n        let frame = format!(r#\"{{\"type\":\"unregister\",\"pid\":{}}}\"#, std::process::id());\n        write_frame(&mut hp_w, &frame);\n    }\n    eprintln!(\"dsx-agent: shutdown complete\");\n}\n","structuredPatch":[{"oldStart":83,"oldLines":6,"newStart":83,"newLines":7,"lines":["                     if let Some(resp) = read_frame(&mut tools_reader) {","                         write_frame(&mut tui_writer, &resp);","                     }","+                    write_frame(&mut tui_writer, r#\"{\"type\":\"done\"}\"#);","                 } else if frame.contains(\"\\\"type\\\":\\\"api_request\\\"\") && hp.is_some() {","                     // Forward to HP","                     let mut hp_w = hp.as_ref().unwrap().try_clone().unwrap();"]},{"oldStart":91,"oldLines":6,"newStart":92,"newLines":7,"lines":["                     if let Some(resp) = read_frame(&mut hp_r) {","                         write_frame(&mut tui_writer, &resp);","                     }","+                    write_frame(&mut tui_writer, r#\"{\"type\":\"done\"}\"#);","                 } else if frame.contains(\"\\\"type\\\":\\\"shutdown\\\"\") {","                     write_frame(&mut tui_writer, r#\"{\"type\":\"shutdown_ack\"}\"#);","                     break;"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"30664027-b303-462c-857e-87f7ec7a8b73","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.141","gitBranch":"master","slug":"gentle-orbiting-karp"}
