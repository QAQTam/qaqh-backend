 \"query_balance\")]\n49\t    QueryBalance,\n50\t    #[serde(rename = \"mode_change\")]\n51\t    ModeChange {\n52\t        mode: String,\n53\t    },\n54\t    #[serde(rename = \"shutdown\")]\n55\t    Shutdown,\n56\t}\n57\t\n58\t/// Frames received from Agent → TUI via stdout (JSON-LP).\n59\t#[derive(Debug, Deserialize)]\n60\t#[serde(tag = \"t\")]\n61\tpub(crate) enum AgentFrame {\n62\t    #[serde(rename = \"payload\")]\n63\t    StreamPayload {\n64\t        delta: String,\n65\t        #[serde(default)]\n66\t        reasoning: Option<String>,\n67\t        #[serde(default)]\n68\t        tool_progress: Vec<(String, String)>,\n69\t    },\n70\t    #[serde(rename = \"done\")]\n71\t    StreamDone {\n72\t        #[serde(default)]\n73\t        usage: Option<UsageInfo>,\n74\t    },\n75\t    #[serde(rename = \"error\")]\n76\t    StreamError {\n77\t        message: String,\n78\t    },\n79\t    #[serde(rename = \"mode_req\")]\n80\t    TuiModeRequest {"}]},"uuid":"70b64db5-c83b-4159-a687-d7fe02963215","timestamp":"2026-05-15T04:00:19.786Z","toolUseResult":{"type":"text","file":{"filePath":"/home/qaqtamsy/Desktop/dsx/crates/dsx-tui/src/state.rs","content":"//! AppState — pure UI state, no agent/orchestrator/tool domains.\n//!\n//! Three structs:\n//!   - AppState: UI rendering state (~25 pure fields, no ctx/health/memory)\n//!   - StreamBuffer: accumulates streaming deltas from Agent\n//!   - AgentConnection: spawns Agent subprocess, manages JSON-LP IPC\n\nuse std::io::{BufRead, BufReader, Write};\nuse std::process::{Child, Command, Stdio};\nuse std::sync::mpsc as std_mpsc;\nuse std::thread;\nuse std::time::Instant;\n\nuse serde::{Deserialize, Serialize};\n\nuse dsx_types::{Message, UsageInfo, SessionMeta, ToolCall, SafetyLevel};\nuse crate::stubs::config::Config;\nuse super::input::state::InputState;\nuse super::mode::Mode;\n/// Re-use gate/error types from legacy App (they live in app.rs during migration).\nuse super::app::{GateBlocked, ApiError, RetryProgress, RateLimitInfo};\n\n