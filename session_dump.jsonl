\n    if staged {\n        ToolResult::ok(run_cmd(\"git\", &[\"diff\", \"--cached\", \"--stat\"]))\n    } else {\n        ToolResult::ok(run_cmd(\"git\", &[\"diff\", \"--stat\"]))\n    }\n}\n\npub fn handle_log(ctx: ToolCallCtx) -> ToolResult {\n    let count = ctx.get_str(\"count\").unwrap_or(\"10\");\n    ToolResult::ok(run_cmd(\"git\", &[\"log\", \"--oneline\", \"-n\", count]))\n}\n\npub fn handle_commit(ctx: ToolCallCtx) -> ToolResult {","numLines":30,"startLine":1,"totalLines":129}},"sourceToolAssistantUUID":"d0a42ee4-b3e1-45b0-93ba-bd4e5445daa6","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
