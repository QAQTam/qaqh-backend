{"parentUuid":"058add5d-8e01-4157-82cd-3abf09737f39","isSidechain":false,"attachment":{"type":"file","filename":"/home/qaqtamsy/Desktop/dsx/crates/dsx/src/main.rs","content":{"type":"text","file":{"filePath":"/home/qaqtamsy/Desktop/dsx/crates/dsx/src/main.rs","content":"//! DSX — umbrella binary. All roles in one binary.\n\nfn main() {\n    let _ = std::env::set_var(\"DSX_SINGLE_BINARY\", \"1\");\n\n    let role = std::env::args().nth(1).unwrap_or_default();\n    match role.as_str() {\n        \"hp\" => dsx_hp::runner::run(),\n        \"agent\" => dsx_agent::runner::run(),\n        \"tools\" => dsx_tools::run(),\n        \"config\" | \"init\" => run_config(),\n        _ => {\n            if let Err(e) = dsx_tui::run() {\n                eprintln!(\"dsx: TUI error: {e}\");\n                std::process::exit(1);\n            }\n        }\n    }\n}\n\n/// Interactive setup wizard: writes ~/.dsx/config.json\nfn run_config() {\n    use std::io::Write;\n\n    let home = std::env::var(\"HOME\").unwrap_or_else(|_| \"/tmp\".into());\n    let dir = std::path::PathBuf::from(&home).join(\".dsx\");\n    let cfg_path = dir.join(\"config.json\");\n    let _ = std::fs::create_dir_all(&dir);\n\n    // Read existing values\n    let mut api_key = String::new();\n    let mut base_url = \"https://api.deepseek.com\".to_string();\n    let mut model = \"deepseek-v4-flash\".to_string();\n    let mut protocol = \"openai\".to_string();\n    let mut context_limit = 1_000_000u32;\n    if let Ok(data) = std::fs::read_to_string(&cfg_path) {\n        if let Ok(v) = serde_json::from_str::<serde_json::Value>(&data) {\n            if let Some(k) = v.get(\"api_key\").and_then(|k| k.as_str()) { api_key = k.to_string(); }\n            if let Some(u) = v.get(\"base_url\").and_then(|b| b.as_str()) { base_url = u.to_string(); }\n            if let Some(m) = v.get(\"model\").and_then(|m| m.as_str()) { model = m.to_string(); }\n            if let Some(p) = v.get(\"protocol\").and_then(|p| p.as_str()) { protocol = p.to_string(); }\n            if let Some(c) = v.get(\"context_limit\").and_then(|c| c.as_u64()) { context_limit = c as u32; }\n        }\n    }\n\n    println!();\n    println!(\"╔══════════════════════════════════════╗\");\n    println!(\"║   DSX — AI coding assistant setup    ║\");\n    println!(\"╚══════════════════════════════════════╝\");\n    println!(\"(leave blank to keep current value)\");\n    println!();\n\n    // Step 1: API protocol\n    println!(\"[1/5] API type\");\n    println!(\"  1) OpenAI compatible  (default, fast, wide model support)\");\n    println!(\"  2) Anthropic compatible  (for native Anthropic API endpoints)\");\n    print!(\"Choice [{}]: \", if protocol == \"anthropic\" { \"2\" } else { \"1\" });\n    std::io::stdout().flush().ok();\n    let mut input = String::new();\n    std::io::stdin().read_line(&mut input).ok();\n    match input.trim() {\n        \"2\" => protocol = \"anthropic\".to_string(),\n        _ => protocol = \"openai\".to_string(),\n    }\n\n    // Step 2: API endpoint URL\n    println!();\n    println!(\"[2/5] API endpoint URL\");\n    print!(\"  URL [{}]: \", base_url);\n    std::io::stdout().flush().ok();\n    input.clear();\n    std::io::stdin().read_line(&mut input).ok();\n    let trimmed = input.trim().to_string();\n    if !trimmed.is_empty() { base_url = trimmed; }\n\n    // Step 3: API key\n    println!();\n    println!(\"[3/5] API key (enter \\\"not-needed\\\" for local models)\");\n    print!(\"  Key [{}]: \", if api_key.is_empty() { \"(none)\" } else { \"****\" });\n    std::io::stdout().flush().ok();\n    input.clear();\n    std::io::stdin().read_line(&mut input).ok();\n    let trimmed = input.trim().to_string();\n    if !trimmed.is_empty() { api_key = trimmed; }\n\n    // Step 4: Model name\n    println!();\n    println!(\"[4/5] Model name\");\n    println!(\"  Common options:\");\n    println!(\"    deepseek-v4-flash    — Fast, general purpose (DeepSeek)\");\n    println!(\"    deepseek-v4-pro      — High capability (DeepSeek)\");\n    println!(\"    qwen/qwen3.5-9b      — Local via LM Studio / Ollama\");\n    println!(\"    qwen2.5-coder:7b     — Coding via Ollama\");\n    println!(\"    deepseek-r1:7b        — Reasoning via Ollama\");\n    print!(\"  Model [{}]: \", model);\n    std::io::stdout().flush().ok();\n    input.clear();\n    std::io::stdin().read_line(&mut input).ok();\n    let trimmed = input.trim().to_string();\n    if !trimmed.is_empty() { model = trimmed; }\n\n    // Step 5: Context limit\n    println!();\n    println!(\"[5/5] Max context tokens\");\n    println!(\"  DeepSeek API = 1,000,000  |  Local (12K) = 12000  |  OpenAI = 128000\");\n    print!(\"  Context limit [{}]: \", context_limit);\n    std::io::stdout().flush().ok();\n    input.clear();\n    std::io::stdin().read_line(&mut input).ok();\n    let trimmed = input.trim().to_string();\n    if !trimmed.is_empty() {\n        if let Ok(v) = trimmed.parse::<u32>() {\n            context_limit = v;\n        }\n    }\n\n    // Build and save config\n    let config = serde_json::json!({\n        \"api_key\": api_key,\n        \"base_url\": base_url,\n        \"model\": model,\n        \"protocol\": protocol,\n        \"context_limit\": context_limit,\n        \"auto_mode\": true,\n        \"prompt_lang\": \"zh\",\n    });\n    match std::fs::write(&cfg_path, serde_json::to_string_pretty(&config).unwrap()) {\n        Ok(_) => {\n            println!();\n            println!(\"Config saved to {}\", cfg_path.display());\n            println!(\"Run `dsx` to start.\");\n        }\n        Err(e) => eprintln!(\"Error saving config: {e}\"),\n    }\n}\n","numLines":136,"startLine":1,"totalLines":136}},"displayPath":"crates/dsx/src/main.rs"},"type":"attachment","uuid":"922783cc-dd05-4dd8-99f1-d518b0aa6d62","timestamp":"2026-05-15T12:08:14.527Z","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
{"parentUuid":"922783cc-dd05-4dd8-99f1-d518b0aa6d62","isSidechain":false,"attachment":{"type":"file","filename":"/home/qaqtamsy/Desktop/dsx/crates/dsx-hp/src/runner.rs","content":{"type":"text","file":{"filePath":"/home/qaqtamsy/Desktop/dsx/crates/dsx-hp/src/runner.rs","content":"//! dsx-hp — Health Platform daemon.\n//!\n//! A lightweight daemon that tracks process liveness, runs the health\n//! judgment pipeline, and exposes a `HealthProbe` service over TCP.\n//!\n//! ## IPC protocol\n//!\n//! JSON-LP frames over TCP `localhost`. Port written to\n//! `$XDG_RUNTIME_DIR/dsx/hp.port`.\n//!\n//! ## Build\n//!\n//! This is a separate binary target. Add to `Cargo.toml`:\n//!\n//! ```toml\n//! [[bin]]\n//! name = \"dsx-hp\"\n//! path = \"src/dsx-hp/main.rs\"\n//! ```\n//!\n//! ## Startup sequence\n//!\n//! 1. Parse CLI args (port, log level).\n//! 2. Bind TCP listener on `127.0.0.1:{port}`.\n//! 3. Write port to `$XDG_RUNTIME_DIR/dsx/hp.port`.\n//! 4. Enter accept loop — one thread per connection.\n//! 5. On SIGTERM/SIGINT: write empty port file, drain connections, exit.\n\nuse std::io::{BufRead, BufReader, Write};\nuse std::net::{TcpListener, TcpStream};\nuse std::sync::{mpsc, Arc, Mutex, OnceLock};\nuse std::thread;\nuse std::time::Duration;\n\nuse crate::config::Config;\nuse crate::ipc_traits::HealthProbe;\nuse crate::monitor;\nuse crate::pipeline::judge;\nuse crate::registry::ProcessRegistry;\nuse crate::types::{HpError, ProcessKind, Verdict};\nuse crate::StreamEvent;\nuse dsx_gateway::GatewayConfig;\n\nstatic HP_CONFIG: OnceLock<Config> = OnceLock::new();\n\n// ── Health service implementation ──\n\n/// Concrete implementation of the `HealthProbe` trait.\n///\n/// Owns the process registry and delegates pipeline judgment.\n/// Runs synchronously; the IPC layer wraps calls in async tasks.\nstruct HealthService {\n    registry: ProcessRegistry,\n}\n\nimpl HealthService {\n    fn new(timeout_secs: u64) -> Self {\n        Self {\n            registry: ProcessRegistry::new(timeout_secs),\n        }\n    }\n}\n\nimpl HealthProbe for HealthService {\n    fn register(\n        &mut self,\n        kind: ProcessKind,\n        name: &str,\n        pid: u32,\n    ) -> Result<(), HpError> {\n        self.registry.register(kind, name, pid)\n    }\n\n    fn heartbeat(&mut self, pid: u32) -> Result<(), HpError> {\n        self.registry.heartbeat(pid)\n    }\n\n    fn unregister(&mut self, pid: u32) -> Result<(), HpError> {\n        self.registry.unregister(pid)\n    }\n\n    fn judge(&self) -> Vec<Verdict> {\n        let monitor_state = monitor::MonitorState::new();\n        judge(&self.registry, &monitor_state)\n    }\n\n    fn query(&self, pid: u32) -> Result<crate::types::ProcessHealth, HpError> {\n        self.registry.health(pid)\n    }\n\n    fn list_processes(&self) -> Vec<crate::types::ProcessSummary> {\n        self.registry.summaries()\n    }\n}\n\n// ── Main ──\n\n/// Load API config: ~/.dsx/config.json, with env var override.\nfn load_hp_config() -> Config {\n    let mut protocol = std::env::var(\"DSX_PROTOCOL\").unwrap_or_default();\n    if protocol.is_empty() { protocol = \"openai\".into(); }\n\n    // Config file first (highest priority)\n    let cfg_path = std::path::PathBuf::from(\n        std::env::var(\"HOME\").unwrap_or_else(|_| \"/tmp\".into()),\n    ).join(\".dsx\").join(\"config.json\");\n\n    if let Ok(data) = std::fs::read_to_string(&cfg_path) {\n        if let Ok(v) = serde_json::from_str::<serde_json::Value>(&data) {\n            let api_key = v.get(\"api_key\").and_then(|k| k.as_str()).unwrap_or(\"\").to_string();\n            let base_url = v.get(\"base_url\").and_then(|b| b.as_str()).unwrap_or(\"https://api.deepseek.com\").to_string();\n            let proto = v.get(\"protocol\").and_then(|p| p.as_str()).unwrap_or(&protocol).to_string();\n            if !api_key.is_empty() {\n                return Config { base_url, api_key, protocol: proto };\n            }\n        }\n    }\n\n    // Fallback: env vars (for Claude Code / legacy setups)\n    let env_key = std::env::var(\"ANTHROPIC_AUTH_TOKEN\").unwrap_or_default();\n    let env_url = std::env::var(\"ANTHROPIC_BASE_URL\").unwrap_or_default();\n\n    if !env_key.is_empty() {\n        return Config {\n            base_url: if env_url.is_empty() { \"https://api.deepseek.com\".into() } else { env_url },\n            api_key: env_key,\n            protocol,\n        };\n    }\n\n    Config { base_url: \"https://api.deepseek.com\".into(), api_key: String::new(), protocol }\n}\n\npub fn run() {\n    // 0. Load API config\n    let hp_cfg = load_hp_config();\n    if hp_cfg.api_key.is_empty() {\n        eprintln!(\"dsx-hp: WARNING — no API key configured, run 'dsx config' to set up\");\n    } else {\n        let _ = HP_CONFIG.set(hp_cfg);\n        eprintln!(\"dsx-hp: API proxy configured\");\n    }\n\n    // 1. CLI defaults\n    let port = std::env::var(\"DSX_HP_PORT\")\n        .ok()\n        .and_then(|v| v.parse::<u16>().ok())\n        .unwrap_or(0); // 0 = OS-assigned\n\n    let timeout_secs = std::env::var(\"DSX_HP_TIMEOUT\")\n        .ok()\n        .and_then(|v| v.parse::<u64>().ok())\n        .unwrap_or(30);\n\n    let addr = format!(\"127.0.0.1:{port}\");\n\n    // 2. Bind TCP listener\n    let listener = TcpListener::bind(&addr).expect(\"dsx-hp: failed to bind TCP listener\");\n    let actual_port = listener.local_addr().unwrap().port();\n\n    // 3. Write port file\n    write_port_file(actual_port);\n    eprintln!(\"dsx-hp: listening on 127.0.0.1:{actual_port} (timeout={timeout_secs}s)\");\n\n    // 4. Create health service\n    let service = Arc::new(Mutex::new(HealthService::new(timeout_secs)));\n\n    // 5. Accept loop\n    let (_shutdown_tx, shutdown_rx) = mpsc::channel::<()>();\n\n    // Register self as the HP process\n    {\n        let mut svc = service.lock().unwrap();\n        svc.register(ProcessKind::Tui, \"dsx-hp\", std::process::id())\n            .ok();\n    }\n\n    // Heartbeat ticker — self-heartbeat every 15s\n    let svc_heartbeat = service.clone();\n    let _hb_ticker = thread::spawn(move || loop {\n        thread::sleep(Duration::from_secs(15));\n        if shutdown_rx.try_recv().is_ok() {\n            break;\n        }\n        if let Ok(mut svc) = svc_heartbeat.lock() {\n            svc.heartbeat(std::process::id()).ok();\n        }\n    });\n\n    // Signal handler (SIGINT/SIGTERM)\n    let svc_shutdown = service.clone();\n    let _sig_handler = thread::spawn(move || {\n        let _ = svc_shutdown;\n        thread::park();\n    });\n\n    // Accept connections\n    for stream in listener.incoming() {\n        match stream {\n            Ok(stream) => {\n                let svc = service.clone();\n                thread::spawn(|| handle_connection(stream, svc));\n            }\n            Err(e) => {\n                eprintln!(\"dsx-hp: accept error: {e}\");\n            }\n        }\n    }\n\n    // Cleanup on exit\n    clear_port_file();\n}\n\n// ── Connection handler ──\n\nfn handle_connection(\n    stream: TcpStream,\n    service: Arc<Mutex<HealthService>>,\n) {\n    let peer = stream.peer_addr().ok();\n    let mut reader = BufReader::new(stream.try_clone().unwrap());\n\n    let mut buf = String::new();\n    loop {\n        buf.clear();\n        match reader.read_line(&mut buf) {\n            Ok(0) => break, // EOF\n            Ok(_) => {\n                let trimmed = buf.trim();\n                if trimmed.is_empty() {\n                    continue;\n                }\n                if trimmed.contains(\"\\\"api_chat\\\"\") {\n                    if let Ok(mut w) = stream.try_clone() {\n                        handle_api_chat_streaming(trimmed, &mut w);\n                    }\n                } else {\n                    let response = dispatch_frame(trimmed, &service);\n                    if let Ok(mut w) = stream.try_clone() {\n                        let _ = writeln!(w, \"{response}\");\n                        let _ = w.flush();\n                    }\n                }\n            }\n            Err(_) => break,\n        }\n    }\n\n    if let Some(addr) = peer {\n        eprintln!(\"dsx-hp: connection closed: {addr}\");\n    }\n}\n\nfn dispatch_frame(\n    line: &str,\n    service: &Mutex<HealthService>,\n) -> String {\n    let frame_type: String = serde_json::from_str::<serde_json::Value>(line)\n        .ok()\n        .and_then(|v| v.get(\"type\").and_then(|v| v.as_str().map(String::from)))\n        .unwrap_or_default();\n\n    let mut svc = service.lock().unwrap();\n\n    match frame_type.as_str() {\n        \"register\" => {\n            let kind = if line.contains(\"Agent\") {\n                ProcessKind::Agent\n            } else if line.contains(\"Tools\") {\n                ProcessKind::Tools\n            } else {\n                ProcessKind::Tui\n            };\n            let pid = extract_pid(line).unwrap_or(0);\n            let name = extract_name(line).unwrap_or(\"unknown\");\n\n            match svc.register(kind, name, pid) {\n                Ok(()) => json_response(\"ok\", \"registered\"),\n                Err(e) => json_response(\"error\", &e.to_string()),\n            }\n        }\n        \"heartbeat\" => {\n            let pid = extract_pid(line).unwrap_or(0);\n            match svc.heartbeat(pid) {\n                Ok(()) => json_response(\"ok\", \"heartbeat recorded\"),\n                Err(e) => json_response(\"error\", &e.to_string()),\n            }\n        }\n        \"unregister\" => {\n            let pid = extract_pid(line).unwrap_or(0);\n            match svc.unregister(pid) {\n                Ok(()) => json_response(\"ok\", \"unregistered\"),\n                Err(e) => json_response(\"error\", &e.to_string()),\n            }\n        }\n        \"judge\" => {\n            let verdicts = svc.judge();\n            let json = serde_json::to_string(&verdicts).unwrap_or_else(|_| \"[]\".into());\n            format!(\"{{\\\"type\\\":\\\"verdicts\\\",\\\"data\\\":{json}}}\")\n        }\n        \"query\" => {\n            let pid = extract_pid(line).unwrap_or(0);\n            match svc.query(pid) {\n                Ok(health) => {\n                    let data = serde_json::to_string(&health).unwrap_or_default();\n                    format!(\"{{\\\"type\\\":\\\"health\\\",\\\"data\\\":{data}}}\")\n                }\n                Err(e) => json_response(\"error\", &e.to_string()),\n            }\n        }\n        \"list\" => {\n            let summaries = svc.list_processes();\n            let json = serde_json::to_string(&summaries).unwrap_or_else(|_| \"[]\".into());\n            format!(\"{{\\\"type\\\":\\\"process_list\\\",\\\"data\\\":{json}}}\")\n        }\n        _ => json_response(\"error\", &format!(\"unknown frame type: {frame_type}\")),\n    }\n}\n\n// ── Helpers ──\n\nfn json_response(status: &str, message: &str) -> String {\n    serde_json::json!({\"type\": status, \"message\": message}).to_string()\n}\n\n/// Streaming variant of `handle_api_chat` — writes content deltas to `writer`\n/// as they arrive from the LLM, then a final `api_response` frame.\nfn handle_api_chat_streaming(line: &str, writer: &mut impl Write) {\n    let config = match HP_CONFIG.get() {\n        Some(c) => c.clone(),\n        None => {\n            let _ = writeln!(writer, \"{}\", json_response(\"error\", \"HP not configured (no API key)\"));\n            let _ = writer.flush();\n            return;\n        }\n    };\n\n    let v: serde_json::Value = match serde_json::from_str(line) {\n        Ok(v) => v,\n        Err(e) => {\n            let _ = writeln!(writer, \"{}\", json_response(\"error\", &format!(\"invalid api_chat frame: {e}\")));\n            let _ = writer.flush();\n            return;\n        }\n    };\n\n    let model = v.get(\"model\").and_then(|v| v.as_str()).unwrap_or(\"deepseek-v4-flash\");\n    let system = v.get(\"system\").and_then(|v| v.as_str()).map(String::from);\n\n    let messages_val = match v.get(\"messages\").and_then(|v| v.as_array()) {\n        Some(arr) => arr,\n        None => {\n            let _ = writeln!(writer, \"{}\", json_response(\"error\", \"api_chat: missing messages array\"));\n            let _ = writer.flush();\n            return;\n        }\n    };\n\n    let protocol = config.protocol.clone();\n\n    let rt = match tokio::runtime::Runtime::new() {\n        Ok(r) => r,\n        Err(e) => {\n            let _ = writeln!(writer, \"{}\", json_response(\"error\", &format!(\"runtime error: {e}\")));\n            let _ = writer.flush();\n            return;\n        }\n    };\n\n    let tools: Option<Vec<dsx_types::ToolDef>> = v.get(\"tools\")\n        .and_then(|t| serde_json::from_value(t.clone()).ok());\n\n    let gateway_cfg = GatewayConfig {\n        base_url: config.base_url.clone(),\n        api_key: config.api_key.clone(),\n        protocol: protocol.clone(),\n    };\n\n    rt.block_on(async {\n        let (tx, mut rx) = tokio::sync::mpsc::channel::<StreamEvent>(64);\n\n        match protocol.as_str() {\n            \"openai\" => {\n                let msgs = messages_val.clone();\n                let model_o = model.to_string();\n                let sys = system;\n                let gw = gateway_cfg;\n                tokio::spawn(async move {\n                    let _ = dsx_gateway::chat_stream_openai(\n                        &gw, &model_o, sys, msgs, tools, None, 8192, tx,\n                    )\n                    .await;\n                });\n            }\n            _ => {\n                let msgs = messages_val.clone();\n                let model_o = model.to_string();\n                let sys = system;\n                let gw = gateway_cfg;\n                tokio::spawn(async move {\n                    let _ = dsx_gateway::chat_stream(\n                        &gw, &model_o, sys, msgs, true, None, tools, None, 8192, None, None, None, tx,\n                    )\n                    .await;\n                });\n            }\n        }\n\n        let mut full_content = String::new();\n        let mut reasoning = String::new();\n        while let Some(event) = rx.recv().await {\n            match event {\n                StreamEvent::ContentDelta(delta) => {\n                    full_content.push_str(&delta);\n                    let frame = serde_json::json!({\n                        \"type\": \"content_delta\",\n                        \"delta\": delta,\n                    });\n                    if let Ok(s) = serde_json::to_string(&frame) {\n                        let _ = writeln!(writer, \"{s}\");\n                        let _ = writer.flush();\n                    }\n                }\n                StreamEvent::ReasoningDelta(delta) => {\n                    reasoning.push_str(&delta);\n                    let frame = serde_json::json!({\n                        \"type\": \"content_delta\",\n                        \"delta\": \"\",\n                        \"reasoning\": delta,\n                    });\n                    if let Ok(s) = serde_json::to_string(&frame) {\n                        let _ = writeln!(writer, \"{s}\");\n                        let _ = writer.flush();\n                    }\n                }\n                StreamEvent::ToolCallProgress { name, args_so_far } => {\n                    let frame = serde_json::json!({\n                        \"type\": \"tool_progress\",\n                        \"id\": \"\",\n                        \"content\": format!(\"{name}({args_so_far})\"),\n                        \"stream_type\": \"progress\",\n                    });\n                    if let Ok(s) = serde_json::to_string(&frame) {\n                        let _ = writeln!(writer, \"{s}\");\n                        let _ = writer.flush();\n                    }\n                }\n                StreamEvent::Done { raw_message, stop_reason: sr, usage } => {\n                    if let Some(text) = raw_message.content {\n                        full_content = text;\n                    }\n                    let mut tool_calls: Vec<serde_json::Value> = Vec::new();\n                    if let Some(tcs) = raw_message.tool_calls {\n                        for tc in tcs {\n                            tool_calls.push(serde_json::json!({\n                                \"id\": tc.id,\n                                \"name\": tc.function.name,\n                                \"arguments\": tc.function.arguments,\n                            }));\n                        }\n                    }\n                    let mut resp = serde_json::json!({\n                        \"type\": \"api_response\",\n                        \"content\": full_content,\n                    });\n                    if !reasoning.is_empty() {\n                        resp[\"reasoning_content\"] = serde_json::json!(reasoning);\n                    }\n                    if let Some(ref sig) = raw_message.thinking_signature {\n                        resp[\"thinking_signature\"] = serde_json::json!(sig);\n                    }\n                    if !tool_calls.is_empty() {\n                        resp[\"tool_calls\"] = serde_json::Value::Array(tool_calls);\n                    }\n                    if let Some(ref s) = sr {\n                        resp[\"stop_reason\"] = serde_json::json!(s);\n                    }\n                    if let Some(ref u) = usage {\n                        resp[\"usage\"] = serde_json::json!({\n                            \"prompt_tokens\": u.prompt_tokens,\n                            \"completion_tokens\": u.completion_tokens,\n                            \"total_tokens\": u.total_tokens,\n                            \"prompt_cache_hit_tokens\": u.prompt_cache_hit_tokens,\n                            \"prompt_cache_miss_tokens\": u.prompt_cache_miss_tokens,\n                        });\n                    }\n                    if let Ok(s) = serde_json::to_string(&resp) {\n                        let _ = writeln!(writer, \"{s}\");\n                        let _ = writer.flush();\n                    }\n                    return;\n                }\n                StreamEvent::Error(e) => {\n                    let _ = writeln!(writer, \"{}\", json_response(\"error\", &e));\n                    let _ = writer.flush();\n                    return;\n                }\n            }\n        }\n    });\n}\n\n/// Extract `pid` field from a JSON-LP line (simple parser, no serde).\nfn extract_pid(line: &str) -> Option<u32> {\n    let after = line.split(\"\\\"pid\\\"\").nth(1)?;\n    let after_colon = after.split(':').nth(1)?;\n    let trimmed = after_colon.trim_start();\n    let digits: String = trimmed.chars().take_while(|c| c.is_ascii_digit()).collect();\n    digits.parse().ok()\n}\n\n/// Extract `name` field from a JSON-LP line (simple parser).\nfn extract_name(line: &str) -> Option<&str> {\n    let after = line.split(\"\\\"name\\\"\").nth(1)?;\n    let after_colon = after.split(':').nth(1)?;\n    let trimmed = after_colon.trim();\n    let start = trimmed.find('\"')? + 1;\n    let end = trimmed[start..].find('\"')?;\n    Some(&trimmed[start..start + end])\n}\n\n// ── Port file management ──\n\nfn port_file_path() -> std::path::PathBuf {\n    let home = std::env::var(\"HOME\").unwrap_or_else(|_| \"/tmp\".into());\n    std::path::PathBuf::from(home).join(\".dsx\").join(\"hp.port\")\n}\n\nfn write_port_file(port: u16) {\n    let path = port_file_path();\n    if let Some(parent) = path.parent() {\n        let _ = std::fs::create_dir_all(parent);\n    }\n    let _ = std::fs::write(&path, port.to_string());\n}\n\nfn clear_port_file() {\n    let _ = std::fs::write(port_file_path(), \"\");\n}\n","numLines":540,"startLine":1,"totalLines":540}},"displayPath":"crates/dsx-hp/src/runner.rs"},"type":"attachment","uuid":"0fb341fe-4c5e-45c0-90a6-333467358d59","timestamp":"2026-05-15T12:08:14.596Z","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
{"parentUuid":"0fb341fe-4c5e-45c0-90a6-333467358d59","isSidechain":false,"attachment":{"type":"file","filename":"/home/qaqtamsy/.config/dsx/config.json","content":{"type":"text","file":{"filePath":"/home/qaqtamsy/.config/dsx/config.json","content":"{\n  \"api_key\": \"not-needed\",\n  \"base_url\": \"http://127.0.0.1:1234/v1\",\n  \"model\": \"qwen/qwen3.5-9b\",\n  \"context_limit\": 12000,\n  \"auto_mode\": true,\n  \"prompt_lang\": \"zh\"\n}\n","numLines":9,"startLine":1,"totalLines":9}},"displayPath":"../../.config/dsx/config.json"},"type":"attachment","uuid":"41c7a6dd-9632-4f10-af86-f518ace03776","timestamp":"2026-05-15T12:08:14.452Z","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
