blocks.push(AnthropicContent::ToolUse {\n                    id: tc.id.clone(),\n                    name: tc.function.name.clone(),\n                    input,\n                });\n            }\n        }\n        AnthropicMessage {\n            role: \"assistant\".into(),\n            content: blocks,\n        }\n    }\n\n    /// Convert a tool-result Message into an Anthropic user message\n    /// with a ToolResult content block.\n    pub fn to_anthropic_tool_result(&self) -> AnthropicMessage {\n        let tc_id = self.tool_call_id.clone().unwrap_or_default();\n        let result_text = self.content.clone().unwrap_or_default();\n        let is_err = result_text.starts_with(\"[ERROR]\") || result_text.starts_with(\"[FAIL]\");\n        AnthropicMessage {\n            role: \"user\".into(),\n            content: vec![AnthropicContent::ToolResult {\n                tool_use_id: tc_id,\n                content: result_text,\n                is_error: if is_err { Some(true) } else { None },\n            }],\n        }\n    }\n\n    /// True if this is an assistant message containing tool_calls.\n    pub fn has_tool_calls(&self) -> bool {\n        self.tool_calls.as_ref().map_or(false, |v| !v.is_empty())\n    }\n}\n\nimpl AnthropicUsage {\n    /// Convert to the internal UsageInfo format.\n    pub fn to_usage_info(&self) -> UsageInfo {\n        UsageInfo {\n            prompt_tokens: self.input_tokens,\n            completion_tokens: self.output_tokens,\n            total_tokens: self.input_tokens + self.output_tokens,\n            prompt_cache_hit_tokens: self.cache_read_input_tokens,\n            prompt_cache_miss_tokens: self\n                .input_tokens\n                .saturating_sub(self.cache_read_input_tokens),\n            completion_tokens_details: None,\n        }\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":4,"lines":["-use crate::types::{AnthropicContent, AnthropicMessage, AnthropicUsage, Message, ToolCall, UsageInfo};","+use crate::{AnthropicContent, AnthropicMessage, AnthropicUsage, Message, ToolCall, UsageInfo};"," "," // ── Conversion: internal Message ↔ Anthropic API format ──"," "]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"e426a8da-f27f-446c-85bb-cfb3ff0c7148","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.141","gitBranch":"master","slug":"gentle-orbiting-karp"}
