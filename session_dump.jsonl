 let trimmed = after_colon.trim();\n    let start = trimmed.find('\"')? + 1;\n    let end = trimmed[start..].find('\"')?;\n    Some(&trimmed[start..start + end])\n}\n\n// ── Port file management ──\n\nfn port_file_path() -> std::path::PathBuf {\n    let base = std::env::var(\"XDG_RUNTIME_DIR\")\n        .map(std::path::PathBuf::from)\n        .unwrap_or_else(|_| std::path::PathBuf::from(\"/tmp\"));\n    base.join(\"dsx\").join(\"hp.port\")\n}\n\nfn write_port_file(port: u16) {\n    let path = port_file_path();\n    if let Some(parent) = path.parent() {\n        let _ = std::fs::create_dir_all(parent);\n    }\n    let _ = std::fs::write(&path, port.to_string());\n}\n\nfn clear_port_file() {\n    let _ = std::fs::write(port_file_path(), \"\");\n}\n","numLines":57,"startLine":304,"totalLines":360}},"sourceToolAssistantUUID":"68b0a45a-0b95-403c-801f-a147177e450c","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.141","gitBranch":"master","slug":"gentle-orbiting-karp"}
