emo: AgentEmotion, _label: &str,\n            ) {}\n        }\n\n        pub mod phase_detector {\n            use dsx_types::AgentPhase;\n\n            pub fn detect_phase(_reasoning: &str) -> (AgentPhase, f64) { (AgentPhase::Idle, 0.0) }\n        }\n    }\n}\n","numLines":449,"startLine":248,"totalLines":696}},"sourceToolAssistantUUID":"ac6ad2f8-30ea-44ee-a631-0d0ed331f3d9","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
