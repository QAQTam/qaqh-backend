te_frame(&mut tui_writer, &resp);\n                    }\n                    write_frame(&mut tui_writer, r#\"{\"type\":\"done\"}\"#);\n                } else if frame.contains(\"\\\"type\\\":\\\"user_input\\\"\") {\n                    handle_user_input(&frame, &mut hp_reader, &mut hp_writer, &mut conversation, &mut tui_writer);\n                    write_frame(&mut tui_writer, r#\"{\"type\":\"done\"}\"#);\n                } else if frame.contains(\"\\\"type\\\":\\\"shutdown\\\"\") {\n                    write_frame(&mut tui_writer, r#\"{\"type\":\"shutdown_ack\"}\"#);\n                    break;\n                } else {\n                    write_frame(&mut tui_writer, &format!(r#\"{{\"type\":\"echo\",\"data\":{frame}}}\"#));\n                    write_frame(&mut tui_writer, r#\"{\"type\":\"done\"}\"#);\n                }\n            }\n            None => break,\n        }\n    }\n\n    // Cleanup: close tools stdin first so tools exits, THEN wait\n    drop(tools_writer);\n    let _ = tools_child.wait();\n    // Unregister from HP\n    if let Some(ref mut w) = hp_writer {\n        let frame = format!(r#\"{{\"type\":\"unregister\",\"pid\":{}}}\"#, std::process::id());\n        write_frame(w, &frame);\n    }\n    eprintln!(\"dsx-agent: shutdown complete\");\n}\n","structuredPatch":[{"oldStart":142,"oldLines":7,"newStart":142,"newLines":7,"lines":[" "," // ── Main ──"," ","-fn main_impl() {","+pub fn run() {","     eprintln!(\"dsx-agent starting\");"," ","     // 1. Connect to HP — get persistent read/write handles"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"265879d3-2c03-4427-8722-7cb700c8d779","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.141","gitBranch":"master","slug":"gentle-orbiting-karp"}
