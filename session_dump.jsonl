elf) -> &'static super::tui_text::TuiText {\n        super::tui_text::tui_text(self.config_lang)\n    }\n\n    /// Display-ready token count.\n    pub fn tokens_used(&self) -> u32 {\n        self.api_usage.map(|u| u.total_tokens).unwrap_or(self.token_estimate)\n    }\n\n    /// Context usage ratio (0.0–1.0).\n    pub fn context_pct(&self) -> f64 {\n        dsx_types::context_usage_ratio(self.token_estimate, self.config_context_limit)\n    }\n}\n","numLines":264,"startLine":332,"totalLines":595}},"sourceToolAssistantUUID":"0eb3216e-81a9-4ee1-880c-ec8f165e71fc","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.141","gitBranch":"master","slug":"gentle-orbiting-karp"}
