            if resp.contains(\"done\") { break; }\n49\t        }\n50\t    } else if cli.list_skills {\n51\t        send(&mut agent_writer, r#\"{\"type\":\"list_skills\"}\"#);\n52\t        while let Some(resp) = read_line(&mut agent_reader) {\n53\t            println!(\"{resp}\");\n54\t            if resp.contains(\"done\") { break; }\n55\t        }\n56\t    } else {\n57\t        // Interactive mode — simple readline loop\n58\t        let stdin = std::io::stdin();\n59\t        let mut input = String::new();\n60\t        println!(\"dsx v{} — type /help for commands, Ctrl+D to exit\",\n61\t                 option_env!(\"CARGO_PKG_VERSION\").unwrap_or(\"4.0.0\"));\n62\t        loop {\n63\t            input.clear();\n64\t            print!(\"> \");\n65\t            let _ = std::io::stdout().flush();\n66\t            match stdin.read_line(&mut input) {\n67\t                Err(_) | Ok(0) => break, // error or EOF\n68\t                Ok(_) => {}\n69\t            }\n70\t            let msg = input.trim();\n71\t            if msg.is_empty() { continue; }\n72\t            if msg == \"/quit\" || msg == \"/exit\" {\n73\t                send(&mut agent_writer, r#\"{\"type\":\"shutdown\"}\"#);\n74\t                while let Some(resp) = read_line(&mut agent_reader) {\n75\t                    if resp.contains(\"\\\"shutdown_ack\\\"\") { break; }\n76\t                }\n77\t                break;\n78\t            }\n79\t            send(&mut agent_writer, &format!(r#\"{{\"type\":\"user_input\",\"text\":\"{}\"}}\"#, msg));\n80\t            while let Some(resp) = read_line(&mut agent_reader) {\n81\t                println!(\"  ← {resp}\");\n82\t                if resp.contains(\"\\\"done\\\"\") || resp.contains(\"\\\"error\\\"\") { break; }\n83\t            }\n84\t        }\n85\t    }\n86\t\n87\t    // Close agent's stdin pipe so agent sees EOF and exits cleanly\n88\t    drop(agent_writer);\n89\t    let _ = child.wait();\n90\t    Ok(())\n91\t}\n92\t"}]},"uuid":"6a6d03df-3190-461d-9f6f-97788f9b6c5d","timestamp":"2026-05-15T03:42:36.966Z","toolUseResult":{"type":"text","file":{"filePath":"/home/qaqtamsy/Desktop/dsx/crates/dsx-tui/src/main.rs","content":"//! dsx-tui — terminal frontend. Spawns dsx-agent and communicates via stdin/stdout.\n\nuse clap::Parser;\nuse std::io::{BufRead, BufReader, Write};\nuse std::process::{Command, Stdio};\n\nfn read_line(reader: &mut BufReader<impl std::io::Read>) -> Option<String> {\n    let mut line = String::new();\n    reader.read_line(&mut line).ok().filter(|n| *n > 0).map(|_| line.trim().to_string())\n}\n\nfn send(writer: &mut impl Write, frame: &str) {\n    let _ = writeln!(writer, \"{frame}\");\n    let _ = writer.flush();\n}\n\n#[derive(Parser)]\n#[command(name = \"dsx\", about = \"DeepSeek X\")]\nstruct Cli {\n    #[arg(long)] resume: bool,\n    #[arg(long)] list_sessions: bool,\n    #[arg(long)] list_skills: bool,\n}\n\nfn main() -> anyhow::Result<()> {\n    let cli = Cli::parse();\n\n    // ── Spawn dsx-agent as child process ──\n    let exe = std::env::current_exe().unwrap();\n    let agent_path = exe.with_file_name(\"dsx-agent\");\n\n    let mut child = Command::new(&agent_path)\n        .stdin(Stdio::piped())\n        .stdout(Stdio::piped())\n        .stderr(Stdio::inherit())\n        .spawn()\n        .expect(\"dsx-tui: cannot spawn dsx-agent\");\n\n    let mut agent_reader = BufReader::new(child.stdout.take().unwrap());\n    let mut agent_writer = child.stdin.take().unwrap();\n\n    eprintln!(\"dsx-tui: agent started (pid={})\", child.id());\n\n    if cli.list_sessions {\n        send(&mut agent_writer, r#\"{\"type\":\"list_sessions\"}\"#);\n        while let Some(resp) = read_line(&mut agent_reader) {\n            println!(\"{resp}\");\n            if resp.contains(\"done\") { break; }\n        }\n    } else if cli.list_skills {\n        send(&mut agent_writer, r#\"{\"type\":\"list_skills\"}\"#);\n        while let Some(resp) = read_line(&mut agent_reader) {\n            println!(\"{resp}\");\n            if resp.contains(\"done\") { break; }\n        }\n    } else {\n        // Interactive mode — simple readline loop\n        let stdin = std::io::stdin();\n        let mut input = String::new();\n        println!(\"dsx v{} — type /help for commands, Ctrl+D to exit\",\n                 option_env!(\"CARGO_PKG_VERSION\").unwrap_or(\"4.0.0\"));\n        loop {\n            input.clear();\n            print!(\"> \");\n            let _ = std::io::stdout().flush();\n            match stdin.read_line(&mut input) {\n                Err(_) | Ok(0) => break, // error or EOF\n                Ok(_) => {}\n            }\n            let msg = input.trim();\n            if msg.is_empty() { continue; }\n            if msg == \"/quit\" || msg == \"/exit\" {\n                send(&mut agent_writer, r#\"{\"type\":\"shutdown\"}\"#);\n                while let Some(resp) = read_line(&mut agent_reader) {\n                    if resp.contains(\"\\\"shutdown_ack\\\"\") { break; }\n                }\n                break;\n            }\n            send(&mut agent_writer, &format!(r#\"{{\"type\":\"user_input\",\"text\":\"{}\"}}\"#, msg));\n            while let Some(resp) = read_line(&mut agent_reader) {\n                println!(\"  ← {resp}\");\n                if resp.contains(\"\\\"done\\\"\") || resp.contains(\"\\\"error\\\"\") { break; }\n            }\n        }\n    }\n\n    // Close agent's stdin pipe so agent sees EOF and exits cleanly\n    drop(agent_writer);\n    let _ = child.wait();\n    Ok(())\n}\n","numLines":92,"startLine":1,"totalLines":92}},"sourceToolAssistantUUID":"fcfe15a5-2010-45cf-a539-182d7ffc06fe","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.141","gitBranch":"master","slug":"gentle-orbiting-karp"}
