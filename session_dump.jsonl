{"parentUuid":"cbce9cf1-6889-4ebc-bbfa-2bf68d0c8c9c","isSidechain":false,"promptId":"b9acc303-5377-4986-b701-33e7c63744c7","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01_QBMpNqnMfnzZXTYh0TPI7844","type":"tool_result","content":"1\t//! OpenAI-compatible chat completion streaming client.\n2\t\n3\tuse crate::{AccumulatedToolCall, GatewayConfig, StreamEvent};\n4\tuse dsx_types::{Message, ToolCall, ToolDef, UsageInfo};\n5\tuse futures_util::StreamExt;\n6\tuse reqwest::Client as HttpClient;\n7\tuse serde::{Deserialize, Serialize};\n8\tuse std::collections::HashMap;\n9\tuse std::time::Duration;\n10\tuse tokio::sync::mpsc;\n11\t\n12\t// ── OpenAI request types ──\n13\t\n14\t#[derive(Serialize)]\n15\tstruct OpenAIMessage {\n16\t    role: String,\n17\t    #[serde(skip_serializing_if = \"Option::is_none\")]\n18\t    content: Option<String>,\n19\t    #[serde(skip_serializing_if = \"Option::is_none\")]\n20\t    tool_calls: Option<Vec<OpenAIToolCall>>,\n21\t    #[serde(skip_serializing_if = \"Option::is_none\")]\n22\t    tool_call_id: Option<String>,\n23\t    #[serde(skip_serializing_if = \"Option::is_none\")]\n24\t    reasoning_content: Option<String>,\n25\t}\n26\t\n27\t#[derive(Serialize)]\n28\tstruct OpenAIToolCall {\n29\t    id: String,\n30\t    #[serde(rename = \"type\")]\n31\t    call_type: String,\n32\t    function: OpenAIFunction,\n33\t}\n34\t\n35\t#[derive(Serialize)]\n36\tstruct OpenAIFunction {\n37\t    name: String,\n38\t    arguments: String,\n39\t}\n40\t\n41\t#[derive(Serialize)]\n42\tstruct OpenAIToolDef {\n43\t    #[serde(rename = \"type\")]\n44\t    tool_type: String,\n45\t    function: OpenAIToolFunctionDef,\n46\t}\n47\t\n48\t#[derive(Serialize)]\n49\tstruct OpenAIToolFunctionDef {\n50\t    name: String,\n51\t    description: String,\n52\t    parameters: serde_json::Value,\n53\t}\n54\t\n55\t#[derive(Serialize)]\n56\tstruct OpenAIChatRequest {\n57\t    model: String,\n58\t    messages: Vec<OpenAIMessage>,\n59\t    max_tokens: u32,\n60\t    stream: bool,\n61\t    #[serde(skip_serializing_if = \"Option::is_none\")]\n62\t    tools: Option<Vec<OpenAIToolDef>>,\n63\t    #[serde(skip_serializing_if = \"Option::is_none\")]\n64\t    tool_choice: Option<serde_json::Value>,\n65\t    #[serde(skip_serializing_if = \"Option::is_none\")]\n66\t    reasoning_effort: Option<String>,\n67\t}\n68\t\n69\t// ── OpenAI SSE response types ──\n70\t\n71\t#[derive(Deserialize)]\n72\tstruct OpenAIChatChunk {\n73\t    choices: Vec<OpenAIChoice>,\n74\t    #[serde(default)]\n75\t    usage: Option<OpenAIUsageInfo>,\n76\t}\n77\t\n78\t#[derive(Deserialize)]\n79\tstruct OpenAIChoice {\n80\t    delta: OpenAIDelta,\n81\t    #[serde(default)]\n82\t    finish_reason: Option<String>,\n83\t}\n84\t\n85\t#[derive(Deserialize, Default)]\n86\tstruct OpenAIDelta {\n87\t    #[serde(default)]\n88\t    role: Option<String>,\n89\t    #[serde(default)]\n90\t    content: Option<String>,\n91\t    #[serde(default)]\n92\t    reasoning_content: Option<String>,\n93\t    #[serde(default)]\n94\t    tool_calls: Option<Vec<OpenAIToolCallDelta>>,\n95\t}\n96\t\n97\t#[derive(Deserialize)]\n98\tstruct OpenAIToolCallDelta {\n99\t    index: usize,\n100\t    #[serde(default)]\n101\t    id: Option<String>,\n102\t    #[serde(default)]\n103\t    function: Option<OpenAIFunctionDelta>,\n104\t}\n105\t\n106\t#[derive(Deserialize, Default)]\n107\tstruct OpenAIFunctionDelta {\n108\t    #[serde(default)]\n109\t    name: Option<String>,\n110\t    #[serde(default)]\n111\t    arguments: Option<String>,\n112\t}\n113\t\n114\t#[derive(Deserialize)]\n115\tstruct OpenAIUsageInfo {\n116\t    prompt_tokens: u32,\n117\t    completion_tokens: u32,\n118\t    total_tokens: u32,\n119\t}\n120\t\n121\t// ── Public function ──\n122\t\n123\t/// Streaming chat via OpenAI-compatible `/chat/completions` endpoint.\n124\t///\n125\t/// Takes raw JSON messages from the caller (Agent/TUI) and converts them\n126\t/// to OpenAI format internally — no conversion needed upstream.\n127\tpub async fn chat_stream_openai(\n128\t    config: &GatewayConfig,\n129\t    model: &str,\n130\t    system: Option<String>,\n131\t    raw_messages: Vec<serde_json::Value>,\n132\t    tools: Option<Vec<ToolDef>>,\n133\t    tool_choice: Option<&str>,\n134\t    max_tokens: u32,\n135\t    tx: mpsc::Sender<StreamEvent>,\n136\t) -> anyhow::Result<()> {\n137\t    // Convert raw JSON messages to OpenAI format\n138\t    let mut openai_msgs: Vec<OpenAIMessage> = Vec::new();\n139\t\n140\t    // Prepend system message if provided\n141\t    if let Some(sys) = system {\n142\t        openai_msgs.push(OpenAIMessage {\n143\t            role: \"system\".into(),\n144\t            content: Some(sys),\n145\t            tool_calls: None,\n146\t            tool_call_id: None,\n147\t            reasoning_content: None,\n148\t        });\n149\t    }\n150\t\n151\t    for m in &raw_messages {\n152\t        let role = m.get(\"role\").and_then(|v| v.as_str()).unwrap_or(\"user\");\n153\t        let content = m.get(\"content\");\n154\t        let text = content.and_then(|c| c.as_str()).map(String::from);\n155\t        let tool_calls: Option<Vec<ToolCall>> = m\n156\t            .get(\"tool_calls\")\n157\t            .and_then(|t| serde_json::from_value(t.clone()).ok());\n158\t        let tool_call_id = m\n159\t            .get(\"tool_call_id\")\n160\t            .and_then(|i| i.as_str())\n161\t            .map(String::from);\n162\t        let reasoning_content = m\n163\t            .get(\"reasoning_content\")\n164\t            .and_then(|r| r.as_str())\n165\t            .map(String::from);\n166\t\n167\t        let oai_msg = if role == \"assistant\" && tool_calls.is_some() {\n168\t            let tcs: Vec<OpenAIToolCall> = tool_calls\n169\t                .unwrap_or_default()\n170\t                .into_iter()\n171\t                .map(|tc| OpenAIToolCall {\n172\t                    id: tc.id,\n173\t                    call_type: \"function\".into(),\n174\t                    function: OpenAIFunction {\n175\t                        name: tc.function.name,\n176\t                        arguments: tc.function.arguments,\n177\t                    },\n178\t                })\n179\t                .collect();\n180\t            OpenAIMessage {\n181\t                role: \"assistant\".into(),\n182\t                content: text,\n183\t                tool_calls: if tcs.is_empty() { None } else { Some(tcs) },\n184\t                tool_call_id: None,\n185\t                reasoning_content,\n186\t            }\n187\t        } else if role == \"tool\" {\n188\t            OpenAIMessage {\n189\t                role: \"tool\".into(),\n190\t                content: text,\n191\t                tool_calls: None,\n192\t                tool_call_id,\n193\t                reasoning_content: None,\n194\t            }\n195\t        } else {\n196\t            OpenAIMessage {\n197\t                role: role.to_string(),\n198\t                content: text,\n199\t                tool_calls: None,\n200\t                tool_call_id: None,\n201\t                reasoning_content: None,\n202\t            }\n203\t        };\n204\t        openai_msgs.push(oai_msg);\n205\t    }\n206\t\n207\t    // Convert ToolDef to OpenAI function format\n208\t    let openai_tools: Option<Vec<OpenAIToolDef>> = tools.map(|tds| {\n209\t        tds.into_iter()\n210\t            .map(|td| OpenAIToolDef {\n211\t                tool_type: \"function\".into(),\n212\t                function: OpenAIToolFunctionDef {\n213\t                    name: td.function.name,\n214\t                    description: td.function.description,\n215\t                    parameters: td.function.parameters,\n216\t                },\n217\t            })\n218\t            .collect()\n219\t    });\n220\t\n221\t    let tc = tool_choice.map(|s| match s {\n222\t        \"auto\" => serde_json::json!(\"auto\"),\n223\t        \"none\" => serde_json::json!(\"none\"),\n224\t        \"required\" => serde_json::json!(\"required\"),\n225\t        name => serde_json::json!({\"type\": \"function\", \"function\": {\"name\": name}}),\n226\t    });\n227\t\n228\t    // Determine URL for OpenAI-compatible endpoint.\n229\t    // Supports: full path, /v1 prefix, or just host (extracts origin).\n230\t    let url = {\n231\t        let raw = config.base_url.strip_suffix('/').unwrap_or(&config.base_url);\n232\t        if raw.ends_with(\"/chat/completions\") {\n233\t            raw.to_string()  // e.g. http://localhost:11434/v1/chat/completions\n234\t        } else if raw.ends_with(\"/v1\") {\n235\t            format!(\"{}/chat/completions\", raw)  // e.g. http://localhost:11434/v1\n236\t        } else {\n237\t            // Extract origin and append /chat/completions\n238\t            match raw.find(\"://\") {\n239\t                Some(scheme_end) => {\n240\t                    let after_scheme = &raw[scheme_end + 3..];\n241\t                    match after_scheme.find('/') {\n242\t                        Some(slash_pos) => format!(\"{}/chat/completions\", &raw[..scheme_end + 3 + slash_pos]),\n243\t                        None => format!(\"{raw}/chat/completions\"),\n244\t                    }\n245\t                }\n246\t                None => format!(\"{raw}/chat/completions\"),\n247\t            }\n248\t        }\n249\t    };\n250\t\n251\t    let is_deepseek = config.base_url.contains(\"deepseek.com\");\n252\t\n253\t    let request = OpenAIChatRequest {\n254\t        model: model.to_string(),\n255\t        messages: openai_msgs,\n256\t        max_tokens,\n257\t        stream: true,\n258\t        tools: openai_tools,\n259\t        tool_choice: tc,\n260\t        reasoning_effort: if is_deepseek {\n261\t            Some(\"high\".into())\n262\t        } else {\n263\t            None\n264\t        },\n265\t    };\n266\t\n267\t    let body_json = serde_json::to_value(&request)?;\n268\t\n269\t    log::info!(\n270\t        \"openai api request: {} model={} max_tokens={}\",\n271\t        &url,\n272\t        body_json[\"model\"],\n273\t        body_json[\"max_tokens\"]\n274\t    );\n275\t\n276\t    let http = HttpClient::builder()\n277\t        .connect_timeout(Duration::from_secs(10))\n278\t        .build()?;\n279\t\n280\t    let resp = http\n281\t        .post(&url)\n282\t        .header(\"Authorization\", format!(\"Bearer {}\", config.api_key))\n283\t        .header(\"Content-Type\", \"application/json\")\n284\t        .json(&body_json)\n285\t        .send()\n286\t        .await;\n287\t\n288\t    let resp = match resp {\n289\t        Ok(r) => {\n290\t            if !r.status().is_success() {\n291\t                let status = r.status();\n292\t                let text = r.text().await.unwrap_or_default();\n293\t                let msg = format!(\"OpenAI API {}: {}\", status, text);\n294\t                let _ = tx.send(StreamEvent::Error(msg.clone())).await;\n295\t                return Err(anyhow::anyhow!(\"{}\", msg));\n296\t            }\n297\t            r\n298\t        }\n299\t        Err(e) => {\n300\t            let msg = format!(\"OpenAI connection error: {}\", e);\n301\t            let _ = tx.send(StreamEvent::Error(msg.clone())).await;\n302\t            return Err(anyhow::anyhow!(\"{}\", msg));\n303\t        }\n304\t    };\n305\t\n306\t    let mut content = String::new();\n307\t    let mut reasoning = String::new();\n308\t    let mut tool_calls: HashMap<usize, AccumulatedToolCall> = HashMap::new();\n309\t    let mut usage_info: Option<UsageInfo> = None;\n310\t    let mut stop_reason: Option<String> = None;\n311\t\n312\t    let mut byte_stream = resp.bytes_stream();\n313\t    let mut sse_buffer = String::new();\n314\t    while let Some(chunk) = byte_stream.next().await {\n315\t        let chunk = match chunk {\n316\t            Ok(c) => c,\n317\t            Err(e) => {\n318\t                log::error!(\"OpenAI SSE transport error: {}\", e);\n319\t                let has_output = !content.is_empty() || !tool_calls.is_empty();\n320\t                if !has_output {\n321\t                    let _ = tx\n322\t                        .send(StreamEvent::Error(format!(\n323\t                            \"Stream connection lost before receiving output: {}\",\n324\t                            e\n325\t                        )))\n326\t                        .await;\n327\t                    return Err(anyhow::anyhow!(\"OpenAI SSE stream transport error: {}\", e));\n328\t                }\n329\t                log::warn!(\"OpenAI SSE transport error after receiving output, finalizing partial response\");\n330\t                break;\n331\t            }\n332\t        };\n333\t        sse_buffer.push_str(&String::from_utf8_lossy(&chunk));\n334\t\n335\t        while let Some(pos) = sse_buffer.find(\"\\n\\n\") {\n336\t            let event_text = sse_buffer[..pos].to_string();\n337\t            sse_buffer = sse_buffer[pos + 2..].to_string();\n338\t\n339\t            let mut data_str = String::new();\n340\t            for line in event_text.lines() {\n341\t                let line = line.trim();\n342\t                if let Some(dt) = line.strip_prefix(\"data: \") {\n343\t                    data_str = dt.to_string();\n344\t                }\n345\t            }\n346\t            if data_str.is_empty() || data_str == \"[DONE]\" {\n347\t                continue;\n348\t            }\n349\t\n350\t            let chunk: OpenAIChatChunk = match serde_json::from_str(&data_str) {\n351\t                Ok(c) => c,\n352\t                Err(_) => continue,\n353\t            };\n354\t\n355\t            for choice in chunk.choices {\n356\t                // Emit content delta\n357\t                if let Some(ref text) = choice.delta.content {\n358\t                    if !text.is_empty() {\n359\t                        content.push_str(text);\n360\t                        let _ = tx.send(StreamEvent::ContentDelta(text.clone())).await;\n361\t                    }\n362\t                }\n363\t\n364\t                // Emit reasoning delta\n365\t                if let Some(ref reasoning_text) = choice.delta.reasoning_content {\n366\t                    if !reasoning_text.is_empty() {\n367\t                        reasoning.push_str(reasoning_text);\n368\t                        let _ = tx\n369\t                            .send(StreamEvent::ReasoningDelta(reasoning_text.clone()))\n370\t                            .await;\n371\t                    }\n372\t                }\n373\t\n374\t                // Accumulate tool calls\n375\t                if let Some(ref tcs) = choice.delta.tool_calls {\n376\t                    for tc in tcs {\n377\t                        let entry = tool_calls.entry(tc.index).or_insert_with(|| {\n378\t                            AccumulatedToolCall {\n379\t                                id: String::new(),\n380\t                                name: String::new(),\n381\t                                arguments: String::new(),\n382\t                            }\n383\t                        });\n384\t                        if let Some(ref id) = tc.id {\n385\t                            entry.id = id.clone();\n386\t                        }\n387\t                        if let Some(ref func) = tc.function {\n388\t                            if let Some(ref name) = func.name {\n389\t                                entry.name = name.clone();\n390\t                            }\n391\t                            if let Some(ref args) = func.arguments {\n392\t                                entry.arguments.push_str(args);\n393\t                            }\n394\t                        }\n395\t                        if !entry.name.is_empty() {\n396\t                            let _ = tx\n397\t                                .send(StreamEvent::ToolCallProgress {\n398\t                                    name: entry.name.clone(),\n399\t                                    args_so_far: entry.arguments.clone(),\n400\t                                })\n401\t                                .await;\n402\t                        }\n403\t                    }\n404\t                }\n405\t\n406\t                if let Some(ref reason) = choice.finish_reason {\n407\t                    stop_reason = Some(reason.clone());\n408\t                }\n409\t            }\n410\t\n411\t            if let Some(ref usage) = chunk.usage {\n412\t                usage_info = Some(UsageInfo {\n413\t                    prompt_tokens: usage.prompt_tokens,\n414\t                    completion_tokens: usage.completion_tokens,\n415\t                    total_tokens: usage.total_tokens,\n416\t                    prompt_cache_hit_tokens: 0,\n417\t                    prompt_cache_miss_tokens: 0,\n418\t                    completion_tokens_details: None,\n419\t                });\n420\t            }\n421\t        }\n422\t    }\n423\t\n424\t    log::info!(\n425\t        \"openai stream ended: content_len={} reasoning_len={} tool_count={} stop_reason={:?}\",\n426\t        content.len(),\n427\t        reasoning.len(),\n428\t        tool_calls.len(),\n429\t        stop_reason\n430\t    );\n431\t\n432\t    let assembled_tool_calls: Vec<ToolCall> = if tool_calls.is_empty() {\n433\t        Vec::new()\n434\t    } else {\n435\t        let mut sorted: Vec<_> = tool_calls.into_values().collect();\n436\t        sorted.sort_by_key(|t| {\n437\t            t.id\n438\t                .chars()\n439\t                .filter(|c| c.is_ascii_digit())\n440\t                .collect::<String>()\n441\t                .parse::<u32>()\n442\t                .unwrap_or(0)\n443\t        });\n444\t        sorted\n445\t            .into_iter()\n446\t            .map(|atc| ToolCall {\n447\t                id: atc.id,\n448\t                call_type: \"function\".into(),\n449\t                function: dsx_types::FunctionCall {\n450\t                    name: atc.name,\n451\t                    arguments: atc.arguments,\n452\t                },\n453\t            })\n454\t            .collect()\n455\t    };\n456\t\n457\t    let raw_message = Message {\n458\t        role: \"assistant\".into(),\n459\t        content: if content.is_empty() {\n460\t            None\n461\t        } else {\n462\t            Some(content)\n463\t        },\n464\t        name: None,\n465\t        tool_calls: if assembled_tool_calls.is_empty() {\n466\t            None\n467\t        } else {\n468\t            Some(assembled_tool_calls)\n469\t        },\n470\t        tool_call_id: None,\n471\t        reasoning_content: if reasoning.is_empty() {\n472\t            None\n473\t        } else {\n474\t            Some(reasoning)\n475\t        },\n476\t        thinking_signature: None,\n477\t    };\n478\t\n479\t    let _ = tx\n480\t        .send(StreamEvent::Done {\n481\t            raw_message,\n482\t            usage: usage_info,\n483\t            stop_reason,\n484\t        })\n485\t        .await;\n486\t\n487\t    Ok(())\n488\t}\n489\t"}]},"uuid":"5a2f6e98-2131-4c22-9935-3a37d49a2ab2","timestamp":"2026-05-15T12:12:47.946Z","toolUseResult":{"type":"text","file":{"filePath":"/home/qaqtamsy/Desktop/dsx/crates/dsx-gateway/src/openai.rs","content":"//! OpenAI-compatible chat completion streaming client.\n\nuse crate::{AccumulatedToolCall, GatewayConfig, StreamEvent};\nuse dsx_types::{Message, ToolCall, ToolDef, UsageInfo};\nuse futures_util::StreamExt;\nuse reqwest::Client as HttpClient;\nuse serde::{Deserialize, Serialize};\nuse std::collections::HashMap;\nuse std::time::Duration;\nuse tokio::sync::mpsc;\n\n// ── OpenAI request types ──\n\n#[derive(Serialize)]\nstruct OpenAIMessage {\n    role: String,\n    #[serde(skip_serializing_if = \"Option::is_none\")]\n    content: Option<String>,\n    #[serde(skip_serializing_if = \"Option::is_none\")]\n    tool_calls: Option<Vec<OpenAIToolCall>>,\n    #[serde(skip_serializing_if = \"Option::is_none\")]\n    tool_call_id: Option<String>,\n    #[serde(skip_serializing_if = \"Option::is_none\")]\n    reasoning_content: Option<String>,\n}\n\n#[derive(Serialize)]\nstruct OpenAIToolCall {\n    id: String,\n    #[serde(rename = \"type\")]\n    call_type: String,\n    function: OpenAIFunction,\n}\n\n#[derive(Serialize)]\nstruct OpenAIFunction {\n    name: String,\n    arguments: String,\n}\n\n#[derive(Serialize)]\nstruct OpenAIToolDef {\n    #[serde(rename = \"type\")]\n    tool_type: String,\n    function: OpenAIToolFunctionDef,\n}\n\n#[derive(Serialize)]\nstruct OpenAIToolFunctionDef {\n    name: String,\n    description: String,\n    parameters: serde_json::Value,\n}\n\n#[derive(Serialize)]\nstruct OpenAIChatRequest {\n    model: String,\n    messages: Vec<OpenAIMessage>,\n    max_tokens: u32,\n    stream: bool,\n    #[serde(skip_serializing_if = \"Option::is_none\")]\n    tools: Option<Vec<OpenAIToolDef>>,\n    #[serde(skip_serializing_if = \"Option::is_none\")]\n    tool_choice: Option<serde_json::Value>,\n    #[serde(skip_serializing_if = \"Option::is_none\")]\n    reasoning_effort: Option<String>,\n}\n\n// ── OpenAI SSE response types ──\n\n#[derive(Deserialize)]\nstruct OpenAIChatChunk {\n    choices: Vec<OpenAIChoice>,\n    #[serde(default)]\n    usage: Option<OpenAIUsageInfo>,\n}\n\n#[derive(Deserialize)]\nstruct OpenAIChoice {\n    delta: OpenAIDelta,\n    #[serde(default)]\n    finish_reason: Option<String>,\n}\n\n#[derive(Deserialize, Default)]\nstruct OpenAIDelta {\n    #[serde(default)]\n    role: Option<String>,\n    #[serde(default)]\n    content: Option<String>,\n    #[serde(default)]\n    reasoning_content: Option<String>,\n    #[serde(default)]\n    tool_calls: Option<Vec<OpenAIToolCallDelta>>,\n}\n\n#[derive(Deserialize)]\nstruct OpenAIToolCallDelta {\n    index: usize,\n    #[serde(default)]\n    id: Option<String>,\n    #[serde(default)]\n    function: Option<OpenAIFunctionDelta>,\n}\n\n#[derive(Deserialize, Default)]\nstruct OpenAIFunctionDelta {\n    #[serde(default)]\n    name: Option<String>,\n    #[serde(default)]\n    arguments: Option<String>,\n}\n\n#[derive(Deserialize)]\nstruct OpenAIUsageInfo {\n    prompt_tokens: u32,\n    completion_tokens: u32,\n    total_tokens: u32,\n}\n\n// ── Public function ──\n\n/// Streaming chat via OpenAI-compatible `/chat/completions` endpoint.\n///\n/// Takes raw JSON messages from the caller (Agent/TUI) and converts them\n/// to OpenAI format internally — no conversion needed upstream.\npub async fn chat_stream_openai(\n    config: &GatewayConfig,\n    model: &str,\n    system: Option<String>,\n    raw_messages: Vec<serde_json::Value>,\n    tools: Option<Vec<ToolDef>>,\n    tool_choice: Option<&str>,\n    max_tokens: u32,\n    tx: mpsc::Sender<StreamEvent>,\n) -> anyhow::Result<()> {\n    // Convert raw JSON messages to OpenAI format\n    let mut openai_msgs: Vec<OpenAIMessage> = Vec::new();\n\n    // Prepend system message if provided\n    if let Some(sys) = system {\n        openai_msgs.push(OpenAIMessage {\n            role: \"system\".into(),\n            content: Some(sys),\n            tool_calls: None,\n            tool_call_id: None,\n            reasoning_content: None,\n        });\n    }\n\n    for m in &raw_messages {\n        let role = m.get(\"role\").and_then(|v| v.as_str()).unwrap_or(\"user\");\n        let content = m.get(\"content\");\n        let text = content.and_then(|c| c.as_str()).map(String::from);\n        let tool_calls: Option<Vec<ToolCall>> = m\n            .get(\"tool_calls\")\n            .and_then(|t| serde_json::from_value(t.clone()).ok());\n        let tool_call_id = m\n            .get(\"tool_call_id\")\n            .and_then(|i| i.as_str())\n            .map(String::from);\n        let reasoning_content = m\n            .get(\"reasoning_content\")\n            .and_then(|r| r.as_str())\n            .map(String::from);\n\n        let oai_msg = if role == \"assistant\" && tool_calls.is_some() {\n            let tcs: Vec<OpenAIToolCall> = tool_calls\n                .unwrap_or_default()\n                .into_iter()\n                .map(|tc| OpenAIToolCall {\n                    id: tc.id,\n                    call_type: \"function\".into(),\n                    function: OpenAIFunction {\n                        name: tc.function.name,\n                        arguments: tc.function.arguments,\n                    },\n                })\n                .collect();\n            OpenAIMessage {\n                role: \"assistant\".into(),\n                content: text,\n                tool_calls: if tcs.is_empty() { None } else { Some(tcs) },\n                tool_call_id: None,\n                reasoning_content,\n            }\n        } else if role == \"tool\" {\n            OpenAIMessage {\n                role: \"tool\".into(),\n                content: text,\n                tool_calls: None,\n                tool_call_id,\n                reasoning_content: None,\n            }\n        } else {\n            OpenAIMessage {\n                role: role.to_string(),\n                content: text,\n                tool_calls: None,\n                tool_call_id: None,\n                reasoning_content: None,\n            }\n        };\n        openai_msgs.push(oai_msg);\n    }\n\n    // Convert ToolDef to OpenAI function format\n    let openai_tools: Option<Vec<OpenAIToolDef>> = tools.map(|tds| {\n        tds.into_iter()\n            .map(|td| OpenAIToolDef {\n                tool_type: \"function\".into(),\n                function: OpenAIToolFunctionDef {\n                    name: td.function.name,\n                    description: td.function.description,\n                    parameters: td.function.parameters,\n                },\n            })\n            .collect()\n    });\n\n    let tc = tool_choice.map(|s| match s {\n        \"auto\" => serde_json::json!(\"auto\"),\n        \"none\" => serde_json::json!(\"none\"),\n        \"required\" => serde_json::json!(\"required\"),\n        name => serde_json::json!({\"type\": \"function\", \"function\": {\"name\": name}}),\n    });\n\n    // Determine URL for OpenAI-compatible endpoint.\n    // Supports: full path, /v1 prefix, or just host (extracts origin).\n    let url = {\n        let raw = config.base_url.strip_suffix('/').unwrap_or(&config.base_url);\n        if raw.ends_with(\"/chat/completions\") {\n            raw.to_string()  // e.g. http://localhost:11434/v1/chat/completions\n        } else if raw.ends_with(\"/v1\") {\n            format!(\"{}/chat/completions\", raw)  // e.g. http://localhost:11434/v1\n        } else {\n            // Extract origin and append /chat/completions\n            match raw.find(\"://\") {\n                Some(scheme_end) => {\n                    let after_scheme = &raw[scheme_end + 3..];\n                    match after_scheme.find('/') {\n                        Some(slash_pos) => format!(\"{}/chat/completions\", &raw[..scheme_end + 3 + slash_pos]),\n                        None => format!(\"{raw}/chat/completions\"),\n                    }\n                }\n                None => format!(\"{raw}/chat/completions\"),\n            }\n        }\n    };\n\n    let is_deepseek = config.base_url.contains(\"deepseek.com\");\n\n    let request = OpenAIChatRequest {\n        model: model.to_string(),\n        messages: openai_msgs,\n        max_tokens,\n        stream: true,\n        tools: openai_tools,\n        tool_choice: tc,\n        reasoning_effort: if is_deepseek {\n            Some(\"high\".into())\n        } else {\n            None\n        },\n    };\n\n    let body_json = serde_json::to_value(&request)?;\n\n    log::info!(\n        \"openai api request: {} model={} max_tokens={}\",\n        &url,\n        body_json[\"model\"],\n        body_json[\"max_tokens\"]\n    );\n\n    let http = HttpClient::builder()\n        .connect_timeout(Duration::from_secs(10))\n        .build()?;\n\n    let resp = http\n        .post(&url)\n        .header(\"Authorization\", format!(\"Bearer {}\", config.api_key))\n        .header(\"Content-Type\", \"application/json\")\n        .json(&body_json)\n        .send()\n        .await;\n\n    let resp = match resp {\n        Ok(r) => {\n            if !r.status().is_success() {\n                let status = r.status();\n                let text = r.text().await.unwrap_or_default();\n                let msg = format!(\"OpenAI API {}: {}\", status, text);\n                let _ = tx.send(StreamEvent::Error(msg.clone())).await;\n                return Err(anyhow::anyhow!(\"{}\", msg));\n            }\n            r\n        }\n        Err(e) => {\n            let msg = format!(\"OpenAI connection error: {}\", e);\n            let _ = tx.send(StreamEvent::Error(msg.clone())).await;\n            return Err(anyhow::anyhow!(\"{}\", msg));\n        }\n    };\n\n    let mut content = String::new();\n    let mut reasoning = String::new();\n    let mut tool_calls: HashMap<usize, AccumulatedToolCall> = HashMap::new();\n    let mut usage_info: Option<UsageInfo> = None;\n    let mut stop_reason: Option<String> = None;\n\n    let mut byte_stream = resp.bytes_stream();\n    let mut sse_buffer = String::new();\n    while let Some(chunk) = byte_stream.next().await {\n        let chunk = match chunk {\n            Ok(c) => c,\n            Err(e) => {\n                log::error!(\"OpenAI SSE transport error: {}\", e);\n                let has_output = !content.is_empty() || !tool_calls.is_empty();\n                if !has_output {\n                    let _ = tx\n                        .send(StreamEvent::Error(format!(\n                            \"Stream connection lost before receiving output: {}\",\n                            e\n                        )))\n                        .await;\n                    return Err(anyhow::anyhow!(\"OpenAI SSE stream transport error: {}\", e));\n                }\n                log::warn!(\"OpenAI SSE transport error after receiving output, finalizing partial response\");\n                break;\n            }\n        };\n        sse_buffer.push_str(&String::from_utf8_lossy(&chunk));\n\n        while let Some(pos) = sse_buffer.find(\"\\n\\n\") {\n            let event_text = sse_buffer[..pos].to_string();\n            sse_buffer = sse_buffer[pos + 2..].to_string();\n\n            let mut data_str = String::new();\n            for line in event_text.lines() {\n                let line = line.trim();\n                if let Some(dt) = line.strip_prefix(\"data: \") {\n                    data_str = dt.to_string();\n                }\n            }\n            if data_str.is_empty() || data_str == \"[DONE]\" {\n                continue;\n            }\n\n            let chunk: OpenAIChatChunk = match serde_json::from_str(&data_str) {\n                Ok(c) => c,\n                Err(_) => continue,\n            };\n\n            for choice in chunk.choices {\n                // Emit content delta\n                if let Some(ref text) = choice.delta.content {\n                    if !text.is_empty() {\n                        content.push_str(text);\n                        let _ = tx.send(StreamEvent::ContentDelta(text.clone())).await;\n                    }\n                }\n\n                // Emit reasoning delta\n                if let Some(ref reasoning_text) = choice.delta.reasoning_content {\n                    if !reasoning_text.is_empty() {\n                        reasoning.push_str(reasoning_text);\n                        let _ = tx\n                            .send(StreamEvent::ReasoningDelta(reasoning_text.clone()))\n                            .await;\n                    }\n                }\n\n                // Accumulate tool calls\n                if let Some(ref tcs) = choice.delta.tool_calls {\n                    for tc in tcs {\n                        let entry = tool_calls.entry(tc.index).or_insert_with(|| {\n                            AccumulatedToolCall {\n                                id: String::new(),\n                                name: String::new(),\n                                arguments: String::new(),\n                            }\n                        });\n                        if let Some(ref id) = tc.id {\n                            entry.id = id.clone();\n                        }\n                        if let Some(ref func) = tc.function {\n                            if let Some(ref name) = func.name {\n                                entry.name = name.clone();\n                            }\n                            if let Some(ref args) = func.arguments {\n                                entry.arguments.push_str(args);\n                            }\n                        }\n                        if !entry.name.is_empty() {\n                            let _ = tx\n                                .send(StreamEvent::ToolCallProgress {\n                                    name: entry.name.clone(),\n                                    args_so_far: entry.arguments.clone(),\n                                })\n                                .await;\n                        }\n                    }\n                }\n\n                if let Some(ref reason) = choice.finish_reason {\n                    stop_reason = Some(reason.clone());\n                }\n            }\n\n            if let Some(ref usage) = chunk.usage {\n                usage_info = Some(UsageInfo {\n                    prompt_tokens: usage.prompt_tokens,\n                    completion_tokens: usage.completion_tokens,\n                    total_tokens: usage.total_tokens,\n                    prompt_cache_hit_tokens: 0,\n                    prompt_cache_miss_tokens: 0,\n                    completion_tokens_details: None,\n                });\n            }\n        }\n    }\n\n    log::info!(\n        \"openai stream ended: content_len={} reasoning_len={} tool_count={} stop_reason={:?}\",\n        content.len(),\n        reasoning.len(),\n        tool_calls.len(),\n        stop_reason\n    );\n\n    let assembled_tool_calls: Vec<ToolCall> = if tool_calls.is_empty() {\n        Vec::new()\n    } else {\n        let mut sorted: Vec<_> = tool_calls.into_values().collect();\n        sorted.sort_by_key(|t| {\n            t.id\n                .chars()\n                .filter(|c| c.is_ascii_digit())\n                .collect::<String>()\n                .parse::<u32>()\n                .unwrap_or(0)\n        });\n        sorted\n            .into_iter()\n            .map(|atc| ToolCall {\n                id: atc.id,\n                call_type: \"function\".into(),\n                function: dsx_types::FunctionCall {\n                    name: atc.name,\n                    arguments: atc.arguments,\n                },\n            })\n            .collect()\n    };\n\n    let raw_message = Message {\n        role: \"assistant\".into(),\n        content: if content.is_empty() {\n            None\n        } else {\n            Some(content)\n        },\n        name: None,\n        tool_calls: if assembled_tool_calls.is_empty() {\n            None\n        } else {\n            Some(assembled_tool_calls)\n        },\n        tool_call_id: None,\n        reasoning_content: if reasoning.is_empty() {\n            None\n        } else {\n            Some(reasoning)\n        },\n        thinking_signature: None,\n    };\n\n    let _ = tx\n        .send(StreamEvent::Done {\n            raw_message,\n            usage: usage_info,\n            stop_reason,\n        })\n        .await;\n\n    Ok(())\n}\n","numLines":489,"startLine":1,"totalLines":489}},"sourceToolAssistantUUID":"cbce9cf1-6889-4ebc-bbfa-2bf68d0c8c9c","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
