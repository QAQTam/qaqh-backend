{"parentUuid":"99bc6221-6e87-4218-bdb4-1ba1a651640a","isSidechain":false,"promptId":"c24c0b5b-eac2-42d4-9ace-b75c34da52b1","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00_MVESzj25FReqi5CYgu1S2167","type":"tool_result","content":"1\t//! dsx-hp — Health Platform daemon.\n2\t//!\n3\t//! A lightweight daemon that tracks process liveness, runs the health\n4\t//! judgment pipeline, and exposes a `HealthProbe` service over TCP.\n5\t//!\n6\t//! ## IPC protocol\n7\t//!\n8\t//! JSON-LP frames over TCP `localhost`. Port written to\n9\t//! `$XDG_RUNTIME_DIR/dsx/hp.port`.\n10\t//!\n11\t//! ## Build\n12\t//!\n13\t//! This is a separate binary target. Add to `Cargo.toml`:\n14\t//!\n15\t//! ```toml\n16\t//! [[bin]]\n17\t//! name = \"dsx-hp\"\n18\t//! path = \"src/dsx-hp/main.rs\"\n19\t//! ```\n20\t//!\n21\t//! ## Startup sequence\n22\t//!\n23\t//! 1. Parse CLI args (port, log level).\n24\t//! 2. Bind TCP listener on `127.0.0.1:{port}`.\n25\t//! 3. Write port to `$XDG_RUNTIME_DIR/dsx/hp.port`.\n26\t//! 4. Enter accept loop — one thread per connection.\n27\t//! 5. On SIGTERM/SIGINT: write empty port file, drain connections, exit.\n28\t\n29\tuse std::io::{BufRead, BufReader, Write};\n30\tuse std::net::{TcpListener, TcpStream};\n31\tuse std::sync::{mpsc, Arc, Mutex};\n32\tuse std::thread;\n33\tuse std::time::Duration;\n34\t\n35\tuse dsx_hp::ipc_traits::HealthProbe;\n36\tuse dsx_hp::pipeline::judge;\n37\tuse dsx_hp::registry::ProcessRegistry;\n38\tuse dsx_hp::types::{HpError, ProcessKind, Verdict};\n39\tuse dsx_hp::monitor;\n40\t\n41\t// ── Health service implementation ──\n42\t\n43\t/// Concrete implementation of the `HealthProbe` trait.\n44\t///\n45\t/// Owns the process registry and delegates pipeline judgment.\n46\t/// Runs synchronously; the IPC layer wraps calls in async tasks.\n47\tstruct HealthService {\n48\t    registry: ProcessRegistry,\n49\t}\n50\t\n51\timpl HealthService {\n52\t    fn new(timeout_secs: u64) -> Self {\n53\t        Self {\n54\t            registry: ProcessRegistry::new(timeout_secs),\n55\t        }\n56\t    }\n57\t}\n58\t\n59\timpl HealthProbe for HealthService {\n60\t    fn register(\n61\t        &mut self,\n62\t        kind: ProcessKind,\n63\t        name: &str,\n64\t        pid: u32,\n65\t    ) -> Result<(), HpError> {\n66\t        self.registry.register(kind, name, pid)\n67\t    }\n68\t\n69\t    fn heartbeat(&mut self, pid: u32) -> Result<(), HpError> {\n70\t        self.registry.heartbeat(pid)\n71\t    }\n72\t\n73\t    fn unregister(&mut self, pid: u32) -> Result<(), HpError> {\n74\t        self.registry.unregister(pid)\n75\t    }\n76\t\n77\t    fn judge(&self) -> Vec<Verdict> {\n78\t        // monitor_state is placeholder — in production the Agent\n79\t        // pushes MonitorState updates via IPC frames.\n80\t        let monitor_state = monitor::MonitorState::new();\n81\t        judge(&self.registry, &monitor_state)\n82\t    }\n83\t\n84\t    fn query(&self, pid: u32) -> Result<dsx_hp::types::ProcessHealth, HpError> {\n85\t        self.registry.health(pid)\n86\t    }\n87\t\n88\t    fn list_processes(&self) -> Vec<dsx_hp::types::ProcessSummary> {\n89\t        self.registry.summaries()\n90\t    }\n91\t}\n92\t\n93\t// ── Main ──\n94\t\n95\tfn main() {\n96\t    // 1. CLI defaults\n97\t    let port = std::env::var(\"DSX_HP_PORT\")\n98\t        .ok()\n99\t        .and_then(|v| v.parse::<u16>().ok())\n100\t        .unwrap_or(0); // 0 = OS-assigned\n101\t\n102\t    let timeout_secs = std::env::var(\"DSX_HP_TIMEOUT\")\n103\t        .ok()\n104\t        .and_then(|v| v.parse::<u64>().ok())\n105\t        .unwrap_or(30);\n106\t\n107\t    let addr = format!(\"127.0.0.1:{port}\");\n108\t\n109\t    // 2. Bind TCP listener\n110\t    let listener = TcpListener::bind(&addr).expect(\"dsx-hp: failed to bind TCP listener\");\n111\t    let actual_port = listener.local_addr().unwrap().port();\n112\t\n113\t    // 3. Write port file\n114\t    write_port_file(actual_port);\n115\t    eprintln!(\"dsx-hp: listening on 127.0.0.1:{actual_port} (timeout={timeout_secs}s)\");\n116\t\n117\t    // 4. Create health service\n118\t    let service = Arc::new(Mutex::new(HealthService::new(timeout_secs)));\n119\t\n120\t    // 5. Accept loop\n121\t    let (_shutdown_tx, shutdown_rx) = mpsc::channel::<()>();\n122\t\n123\t    // Register self as the HP process\n124\t    {\n125\t        let mut svc = service.lock().unwrap();\n126\t        svc.register(ProcessKind::Tui, \"dsx-hp\", std::process::id())\n127\t            .ok();\n128\t    }\n129\t\n130\t    // Heartbeat ticker — self-heartbeat every 15s\n131\t    let svc_heartbeat = service.clone();\n132\t    let _hb_ticker = thread::spawn(move || loop {\n133\t        thread::sleep(Duration::from_secs(15));\n134\t        if shutdown_rx.try_recv().is_ok() {\n135\t            break;\n136\t        }\n137\t        if let Ok(mut svc) = svc_heartbeat.lock() {\n138\t            svc.heartbeat(std::process::id()).ok();\n139\t        }\n140\t    });\n141\t\n142\t    // Signal handler (SIGINT/SIGTERM) — write empty port file, then exit\n143\t    let svc_shutdown = service.clone();\n144\t    let _sig_handler = thread::spawn(move || {\n145\t        // Read from stdin or use a simpler signal handling mechanism\n146\t        // In production, use a signal library or tokio signal.\n147\t        // For now, Ctrl+C will kill the process and port cleanup happens\n148\t        // via the drop handler below.\n149\t        let _ = svc_shutdown;\n150\t        thread::park();\n151\t    });\n152\t\n153\t    // Accept connections\n154\t    for stream in listener.incoming() {\n155\t        match stream {\n156\t            Ok(stream) => {\n157\t                let svc = service.clone();\n158\t                thread::spawn(|| handle_connection(stream, svc));\n159\t            }\n160\t            Err(e) => {\n161\t                eprintln!(\"dsx-hp: accept error: {e}\");\n162\t            }\n163\t        }\n164\t    }\n165\t\n166\t    // Cleanup on exit\n167\t    clear_port_file();\n168\t}\n169\t\n170\t// ── Connection handler ──\n171\t\n172\t/// Process a single TCP connection.\n173\t///\n174\t/// Reads JSON-LP frames from the stream, dispatches to `HealthProbe`,\n175\t/// writes JSON-LP response frames.\n176\tfn handle_connection(\n177\t    stream: TcpStream,\n178\t    service: Arc<Mutex<HealthService>>,\n179\t) {\n180\t    let peer = stream.peer_addr().ok();\n181\t    let mut reader = BufReader::new(stream.try_clone().unwrap());\n182\t\n183\t    let mut buf = String::new();\n184\t    loop {\n185\t        buf.clear();\n186\t        match reader.read_line(&mut buf) {\n187\t            Ok(0) => break, // EOF\n188\t            Ok(_) => {\n189\t                let trimmed = buf.trim();\n190\t                if trimmed.is_empty() {\n191\t                    continue;\n192\t                }\n193\t                let response = dispatch_frame(trimmed, &service);\n194\t                if let Ok(mut w) = stream.try_clone() {\n195\t                    let _ = writeln!(w, \"{response}\");\n196\t                    let _ = w.flush();\n197\t                }\n198\t            }\n199\t            Err(_) => break,\n200\t        }\n201\t    }\n202\t\n203\t    if let Some(addr) = peer {\n204\t        eprintln!(\"dsx-hp: connection closed: {addr}\");\n205\t    }\n206\t}\n207\t\n208\t/// Parse a JSON-LP frame and dispatch to the health service.\n209\t///\n210\t/// Frame format (JSON one-line):\n211\t/// ```json\n212\t/// {\"type\": \"register\", \"kind\": \"Agent\", \"name\": \"...\", \"pid\": 1234}\n213\t/// {\"type\": \"heartbeat\", \"pid\": 1234}\n214\t/// {\"type\": \"unregister\", \"pid\": 1234}\n215\t/// {\"type\": \"judge\"}\n216\t/// {\"type\": \"query\", \"pid\": 1234}\n217\t/// {\"type\": \"list\"}\n218\t/// ```\n219\tfn dispatch_frame(\n220\t    line: &str,\n221\t    service: &Mutex<HealthService>,\n222\t) -> String {\n223\t    // Parse the type field from the JSON line\n224\t    let frame_type: String = serde_json::from_str::<serde_json::Value>(line)\n225\t        .ok()\n226\t        .and_then(|v| v.get(\"type\").and_then(|v| v.as_str().map(String::from)))\n227\t        .unwrap_or_default();\n228\t\n229\t    let mut svc = service.lock().unwrap();\n230\t\n231\t    match frame_type.as_str() {\n232\t        \"register\" => {\n233\t            // Minimal parsing — production should use serde\n234\t            let kind = if line.contains(\"Agent\") {\n235\t                ProcessKind::Agent\n236\t            } else if line.contains(\"Tools\") {\n237\t                ProcessKind::Tools\n238\t            } else {\n239\t                ProcessKind::Tui\n240\t            };\n241\t            let pid = extract_pid(line).unwrap_or(0);\n242\t            let name = extract_name(line).unwrap_or(\"unknown\");\n243\t\n244\t            match svc.register(kind, name, pid) {\n245\t                Ok(()) => json_response(\"ok\", \"registered\"),\n246\t                Err(e) => json_response(\"error\", &e.to_string()),\n247\t            }\n248\t        }\n249\t        \"heartbeat\" => {\n250\t            let pid = extract_pid(line).unwrap_or(0);\n251\t            match svc.heartbeat(pid) {\n252\t                Ok(()) => json_response(\"ok\", \"heartbeat recorded\"),\n253\t                Err(e) => json_response(\"error\", &e.to_string()),\n254\t            }\n255\t        }\n256\t        \"unregister\" => {\n257\t            let pid = extract_pid(line).unwrap_or(0);\n258\t            match svc.unregister(pid) {\n259\t                Ok(()) => json_response(\"ok\", \"unregistered\"),\n260\t                Err(e) => json_response(\"error\", &e.to_string()),\n261\t            }\n262\t        }\n263\t        \"judge\" => {\n264\t            let verdicts = svc.judge();\n265\t            let json = serde_json::to_string(&verdicts).unwrap_or_else(|_| \"[]\".into());\n266\t            format!(\"{{\\\"type\\\":\\\"verdicts\\\",\\\"data\\\":{json}}}\")\n267\t        }\n268\t        \"query\" => {\n269\t            let pid = extract_pid(line).unwrap_or(0);\n270\t            match svc.query(pid) {\n271\t                Ok(health) => {\n272\t                    let data = serde_json::to_string(&health).unwrap_or_default();\n273\t                    format!(\"{{\\\"type\\\":\\\"health\\\",\\\"data\\\":{data}}}\")\n274\t                }\n275\t                Err(e) => json_response(\"error\", &e.to_string()),\n276\t            }\n277\t        }\n278\t        \"list\" => {\n279\t            let summaries = svc.list_processes();\n280\t            let json = serde_json::to_string(&summaries).unwrap_or_else(|_| \"[]\".into());\n281\t            format!(\"{{\\\"type\\\":\\\"process_list\\\",\\\"data\\\":{json}}}\")\n282\t        }\n283\t        _ => json_response(\"error\", &format!(\"unknown frame type: {frame_type}\")),\n284\t    }\n285\t}\n286\t\n287\t// ── Helpers ──\n288\t\n289\tfn json_response(status: &str, message: &str) -> String {\n290\t    format!(\"{{\\\"type\\\":\\\"{status}\\\",\\\"message\\\":\\\"{message}\\\"}}\")\n291\t}\n292\t\n293\t/// Extract `pid` field from a JSON-LP line (simple parser, no serde).\n294\tfn extract_pid(line: &str) -> Option<u32> {\n295\t    // Find `\"pid\":<digits>` or `\"pid\": <digits>`\n296\t    let after = line.split(\"\\\"pid\\\"\").nth(1)?;\n297\t    let after_colon = after.split(':').nth(1)?;\n298\t    let trimmed = after_colon.trim_start();\n299\t    let digits: String = trimmed.chars().take_while(|c| c.is_ascii_digit()).collect();\n300\t    digits.parse().ok()\n301\t}\n302\t\n303\t/// Extract `name` field from a JSON-LP line (simple parser).\n304\tfn extract_name(line: &str) -> Option<&str> {\n305\t    // Find `\"name\":\"<text>\"` or `\"name\": \"<text>\"`\n306\t    let after = line.split(\"\\\"name\\\"\") .nth(1)?;\n307\t    let after_colon = after.split(':').nth(1)?;\n308\t    let trimmed = after_colon.trim();\n309\t    let start = trimmed.find('\"')? + 1;\n310\t    let end = trimmed[start..].find('\"')?;\n311\t    Some(&trimmed[start..start + end])\n312\t}\n313\t\n314\t// ── Port file management ──\n315\t\n316\tfn port_file_path() -> std::path::PathBuf {\n317\t    let base = std::env::var(\"XDG_RUNTIME_DIR\")\n318\t        .map(std::path::PathBuf::from)\n319\t        .unwrap_or_else(|_| std::path::PathBuf::from(\"/tmp\"));\n320\t    base.join(\"dsx\").join(\"hp.port\")\n321\t}\n322\t\n323\tfn write_port_file(port: u16) {\n324\t    let path = port_file_path();\n325\t    if let Some(parent) = path.parent() {\n326\t        let _ = std::fs::create_dir_all(parent);\n327\t    }\n328\t    let _ = std::fs::write(&path, port.to_string());\n329\t}\n330\t\n331\tfn clear_port_file() {\n332\t    let _ = std::fs::write(port_file_path(), \"\");\n333\t}\n334\t"}]},"uuid":"04d76eb4-60ba-4b7c-975a-adddbadc48ef","timestamp":"2026-05-15T03:27:31.916Z","toolUseResult":{"type":"text","file":{"filePath":"/home/qaqtamsy/Desktop/dsx/crates/dsx-hp/src/main.rs","content":"//! dsx-hp — Health Platform daemon.\n//!\n//! A lightweight daemon that tracks process liveness, runs the health\n//! judgment pipeline, and exposes a `HealthProbe` service over TCP.\n//!\n//! ## IPC protocol\n//!\n//! JSON-LP frames over TCP `localhost`. Port written to\n//! `$XDG_RUNTIME_DIR/dsx/hp.port`.\n//!\n//! ## Build\n//!\n//! This is a separate binary target. Add to `Cargo.toml`:\n//!\n//! ```toml\n//! [[bin]]\n//! name = \"dsx-hp\"\n//! path = \"src/dsx-hp/main.rs\"\n//! ```\n//!\n//! ## Startup sequence\n//!\n//! 1. Parse CLI args (port, log level).\n//! 2. Bind TCP listener on `127.0.0.1:{port}`.\n//! 3. Write port to `$XDG_RUNTIME_DIR/dsx/hp.port`.\n//! 4. Enter accept loop — one thread per connection.\n//! 5. On SIGTERM/SIGINT: write empty port file, drain connections, exit.\n\nuse std::io::{BufRead, BufReader, Write};\nuse std::net::{TcpListener, TcpStream};\nuse std::sync::{mpsc, Arc, Mutex};\nuse std::thread;\nuse std::time::Duration;\n\nuse dsx_hp::ipc_traits::HealthProbe;\nuse dsx_hp::pipeline::judge;\nuse dsx_hp::registry::ProcessRegistry;\nuse dsx_hp::types::{HpError, ProcessKind, Verdict};\nuse dsx_hp::monitor;\n\n// ── Health service implementation ──\n\n/// Concrete implementation of the `HealthProbe` trait.\n///\n/// Owns the process registry and delegates pipeline judgment.\n/// Runs synchronously; the IPC layer wraps calls in async tasks.\nstruct HealthService {\n    registry: ProcessRegistry,\n}\n\nimpl HealthService {\n    fn new(timeout_secs: u64) -> Self {\n        Self {\n            registry: ProcessRegistry::new(timeout_secs),\n        }\n    }\n}\n\nimpl HealthProbe for HealthService {\n    fn register(\n        &mut self,\n        kind: ProcessKind,\n        name: &str,\n        pid: u32,\n    ) -> Result<(), HpError> {\n        self.registry.register(kind, name, pid)\n    }\n\n    fn heartbeat(&mut self, pid: u32) -> Result<(), HpError> {\n        self.registry.heartbeat(pid)\n    }\n\n    fn unregister(&mut self, pid: u32) -> Result<(), HpError> {\n        self.registry.unregister(pid)\n    }\n\n    fn judge(&self) -> Vec<Verdict> {\n        // monitor_state is placeholder — in production the Agent\n        // pushes MonitorState updates via IPC frames.\n        let monitor_state = monitor::MonitorState::new();\n        judge(&self.registry, &monitor_state)\n    }\n\n    fn query(&self, pid: u32) -> Result<dsx_hp::types::ProcessHealth, HpError> {\n        self.registry.health(pid)\n    }\n\n    fn list_processes(&self) -> Vec<dsx_hp::types::ProcessSummary> {\n        self.registry.summaries()\n    }\n}\n\n// ── Main ──\n\nfn main() {\n    // 1. CLI defaults\n    let port = std::env::var(\"DSX_HP_PORT\")\n        .ok()\n        .and_then(|v| v.parse::<u16>().ok())\n        .unwrap_or(0); // 0 = OS-assigned\n\n    let timeout_secs = std::env::var(\"DSX_HP_TIMEOUT\")\n        .ok()\n        .and_then(|v| v.parse::<u64>().ok())\n        .unwrap_or(30);\n\n    let addr = format!(\"127.0.0.1:{port}\");\n\n    // 2. Bind TCP listener\n    let listener = TcpListener::bind(&addr).expect(\"dsx-hp: failed to bind TCP listener\");\n    let actual_port = listener.local_addr().unwrap().port();\n\n    // 3. Write port file\n    write_port_file(actual_port);\n    eprintln!(\"dsx-hp: listening on 127.0.0.1:{actual_port} (timeout={timeout_secs}s)\");\n\n    // 4. Create health service\n    let service = Arc::new(Mutex::new(HealthService::new(timeout_secs)));\n\n    // 5. Accept loop\n    let (_shutdown_tx, shutdown_rx) = mpsc::channel::<()>();\n\n    // Register self as the HP process\n    {\n        let mut svc = service.lock().unwrap();\n        svc.register(ProcessKind::Tui, \"dsx-hp\", std::process::id())\n            .ok();\n    }\n\n    // Heartbeat ticker — self-heartbeat every 15s\n    let svc_heartbeat = service.clone();\n    let _hb_ticker = thread::spawn(move || loop {\n        thread::sleep(Duration::from_secs(15));\n        if shutdown_rx.try_recv().is_ok() {\n            break;\n        }\n        if let Ok(mut svc) = svc_heartbeat.lock() {\n            svc.heartbeat(std::process::id()).ok();\n        }\n    });\n\n    // Signal handler (SIGINT/SIGTERM) — write empty port file, then exit\n    let svc_shutdown = service.clone();\n    let _sig_handler = thread::spawn(move || {\n        // Read from stdin or use a simpler signal handling mechanism\n        // In production, use a signal library or tokio signal.\n        // For now, Ctrl+C will kill the process and port cleanup happens\n        // via the drop handler below.\n        let _ = svc_shutdown;\n        thread::park();\n    });\n\n    // Accept connections\n    for stream in listener.incoming() {\n        match stream {\n            Ok(stream) => {\n                let svc = service.clone();\n                thread::spawn(|| handle_connection(stream, svc));\n            }\n            Err(e) => {\n                eprintln!(\"dsx-hp: accept error: {e}\");\n            }\n        }\n    }\n\n    // Cleanup on exit\n    clear_port_file();\n}\n\n// ── Connection handler ──\n\n/// Process a single TCP connection.\n///\n/// Reads JSON-LP frames from the stream, dispatches to `HealthProbe`,\n/// writes JSON-LP response frames.\nfn handle_connection(\n    stream: TcpStream,\n    service: Arc<Mutex<HealthService>>,\n) {\n    let peer = stream.peer_addr().ok();\n    let mut reader = BufReader::new(stream.try_clone().unwrap());\n\n    let mut buf = String::new();\n    loop {\n        buf.clear();\n        match reader.read_line(&mut buf) {\n            Ok(0) => break, // EOF\n            Ok(_) => {\n                let trimmed = buf.trim();\n                if trimmed.is_empty() {\n                    continue;\n                }\n                let response = dispatch_frame(trimmed, &service);\n                if let Ok(mut w) = stream.try_clone() {\n                    let _ = writeln!(w, \"{response}\");\n                    let _ = w.flush();\n                }\n            }\n            Err(_) => break,\n        }\n    }\n\n    if let Some(addr) = peer {\n        eprintln!(\"dsx-hp: connection closed: {addr}\");\n    }\n}\n\n/// Parse a JSON-LP frame and dispatch to the health service.\n///\n/// Frame format (JSON one-line):\n/// ```json\n/// {\"type\": \"register\", \"kind\": \"Agent\", \"name\": \"...\", \"pid\": 1234}\n/// {\"type\": \"heartbeat\", \"pid\": 1234}\n/// {\"type\": \"unregister\", \"pid\": 1234}\n/// {\"type\": \"judge\"}\n/// {\"type\": \"query\", \"pid\": 1234}\n/// {\"type\": \"list\"}\n/// ```\nfn dispatch_frame(\n    line: &str,\n    service: &Mutex<HealthService>,\n) -> String {\n    // Parse the type field from the JSON line\n    let frame_type: String = serde_json::from_str::<serde_json::Value>(line)\n        .ok()\n        .and_then(|v| v.get(\"type\").and_then(|v| v.as_str().map(String::from)))\n        .unwrap_or_default();\n\n    let mut svc = service.lock().unwrap();\n\n    match frame_type.as_str() {\n        \"register\" => {\n            // Minimal parsing — production should use serde\n            let kind = if line.contains(\"Agent\") {\n                ProcessKind::Agent\n            } else if line.contains(\"Tools\") {\n                ProcessKind::Tools\n            } else {\n                ProcessKind::Tui\n            };\n            let pid = extract_pid(line).unwrap_or(0);\n            let name = extract_name(line).unwrap_or(\"unknown\");\n\n            match svc.register(kind, name, pid) {\n                Ok(()) => json_response(\"ok\", \"registered\"),\n                Err(e) => json_response(\"error\", &e.to_string()),\n            }\n        }\n        \"heartbeat\" => {\n            let pid = extract_pid(line).unwrap_or(0);\n            match svc.heartbeat(pid) {\n                Ok(()) => json_response(\"ok\", \"heartbeat recorded\"),\n                Err(e) => json_response(\"error\", &e.to_string()),\n            }\n        }\n        \"unregister\" => {\n            let pid = extract_pid(line).unwrap_or(0);\n            match svc.unregister(pid) {\n                Ok(()) => json_response(\"ok\", \"unregistered\"),\n                Err(e) => json_response(\"error\", &e.to_string()),\n            }\n        }\n        \"judge\" => {\n            let verdicts = svc.judge();\n            let json = serde_json::to_string(&verdicts).unwrap_or_else(|_| \"[]\".into());\n            format!(\"{{\\\"type\\\":\\\"verdicts\\\",\\\"data\\\":{json}}}\")\n        }\n        \"query\" => {\n            let pid = extract_pid(line).unwrap_or(0);\n            match svc.query(pid) {\n                Ok(health) => {\n                    let data = serde_json::to_string(&health).unwrap_or_default();\n                    format!(\"{{\\\"type\\\":\\\"health\\\",\\\"data\\\":{data}}}\")\n                }\n                Err(e) => json_response(\"error\", &e.to_string()),\n            }\n        }\n        \"list\" => {\n            let summaries = svc.list_processes();\n            let json = serde_json::to_string(&summaries).unwrap_or_else(|_| \"[]\".into());\n            format!(\"{{\\\"type\\\":\\\"process_list\\\",\\\"data\\\":{json}}}\")\n        }\n        _ => json_response(\"error\", &format!(\"unknown frame type: {frame_type}\")),\n    }\n}\n\n// ── Helpers ──\n\nfn json_response(status: &str, message: &str) -> String {\n    format!(\"{{\\\"type\\\":\\\"{status}\\\",\\\"message\\\":\\\"{message}\\\"}}\")\n}\n\n/// Extract `pid` field from a JSON-LP line (simple parser, no serde).\nfn extract_pid(line: &str) -> Option<u32> {\n    // Find `\"pid\":<digits>` or `\"pid\": <digits>`\n    let after = line.split(\"\\\"pid\\\"\").nth(1)?;\n    let after_colon = after.split(':').nth(1)?;\n    let trimmed = after_colon.trim_start();\n    let digits: String = trimmed.chars().take_while(|c| c.is_ascii_digit()).collect();\n    digits.parse().ok()\n}\n\n/// Extract `name` field from a JSON-LP line (simple parser).\nfn extract_name(line: &str) -> Option<&str> {\n    // Find `\"name\":\"<text>\"` or `\"name\": \"<text>\"`\n    let after = line.split(\"\\\"name\\\"\") .nth(1)?;\n    let after_colon = after.split(':').nth(1)?;\n    let trimmed = after_colon.trim();\n    let start = trimmed.find('\"')? + 1;\n    let end = trimmed[start..].find('\"')?;\n    Some(&trimmed[start..start + end])\n}\n\n// ── Port file management ──\n\nfn port_file_path() -> std::path::PathBuf {\n    let base = std::env::var(\"XDG_RUNTIME_DIR\")\n        .map(std::path::PathBuf::from)\n        .unwrap_or_else(|_| std::path::PathBuf::from(\"/tmp\"));\n    base.join(\"dsx\").join(\"hp.port\")\n}\n\nfn write_port_file(port: u16) {\n    let path = port_file_path();\n    if let Some(parent) = path.parent() {\n        let _ = std::fs::create_dir_all(parent);\n    }\n    let _ = std::fs::write(&path, port.to_string());\n}\n\nfn clear_port_file() {\n    let _ = std::fs::write(port_file_path(), \"\");\n}\n","numLines":334,"startLine":1,"totalLines":334}},"sourceToolAssistantUUID":"99bc6221-6e87-4218-bdb4-1ba1a651640a","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.141","gitBranch":"master","slug":"gentle-orbiting-karp"}
