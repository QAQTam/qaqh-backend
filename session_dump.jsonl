teScreen,\n        crossterm::cursor::Show,\n    );\n    crossterm::terminal::disable_raw_mode()?;\n    conn.shutdown();\n    result\n}","newString":"/// Pure ratatui demo mode — spawns agent with direct pipes (no AgentConnection thread).\nfn run_demo() -> anyhow::Result<()> {\n    use dsx_types::Message;\n    use std::io::{BufRead, Write};\n    use std::process::{Command, Stdio};\n\n    ensure_hp_running();\n\n    // Spawn agent directly (same as --readline, bypassing AgentConnection)\n    let exe = std::env::current_exe()?;\n    let agent_bin = if std::env::var(\"DSX_SINGLE_BINARY\").is_ok() { exe } else { exe.with_file_name(\"dsx-agent\") };\n    let mut cmd = Command::new(&agent_bin);\n    if std::env::var(\"DSX_SINGLE_BINARY\").is_ok() { cmd.arg(\"agent\"); }\n    let mut child = cmd\n        .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::inherit())\n        .spawn().map_err(|e| anyhow::anyhow!(\"cannot spawn agent: {e}\"))?;\n    let mut agent_writer = child.stdin.take().unwrap();\n    let mut agent_reader = BufReader::new(child.stdout.take().unwrap());\n    eprintln!(\"dsx-tui: agent started (pid={})\", child.id());\n\n    // Sample messages\n    let mut state = AppState::new(Mode::Chat);\n    state.push_message(Message::user(\"hello\"));\n    let mut reply = Message::assistant_empty();\n    reply.content = Some(\"Demo mode ready — agent is live.\".into());\n    state.push_message(reply);\n    let mut stream = StreamBuffer::new();\n\n    // Terminal\n    crossterm::terminal::enable_raw_mode()?;\n    let mut stdout = std::io::stdout();\n    crossterm::execute!(stdout,\n        crossterm::terminal::EnterAlternateScreen,\n        crossterm::cursor::Hide,\n    )?;\n    let mut terminal = ratatui::Terminal::new(ratatui::backend::CrosstermBackend::new(stdout))?;\n    terminal.clear()?;\n\n    let commands: Vec<(String, String)> = vec![\n        (\"/quit\".into(), \"Exit DSX\".into()),\n        (\"/exit\".into(), \"Exit DSX\".into()),\n    ];\n\n    // Keyboard reader thread (same as event_loop)\n    use crossterm::event::{Event, KeyCode, KeyModifiers};\n    use crate::input::action::InputAction;\n    let (key_tx, key_rx) = std::sync::mpsc::channel::<Event>();\n    let _reader = std::thread::Builder::new().name(\"kbd\".into())\n        .spawn(move || {\n            loop { match crossterm::event::read() {\n                Ok(e) => if key_tx.send(e).is_err() { break; },\n                Err(_) => break,\n            }}\n        }).ok();\n\n    let mut dirty = true;\n    let result = loop {\n        // Keyboard\n        while let Ok(event) = key_rx.try_recv() {\n            dirty = true;\n            if let Event::Key(key) = event {\n                if (key.code == KeyCode::Char('c') || key.code == KeyCode::Char('d'))\n                    && key.modifiers == KeyModifiers::CONTROL { break; }\n                let action = handle_chat_key(&mut state.input_state, key, &commands);\n                match action {\n                    InputAction::SendMessage(text) => {\n                        let t = text.trim().to_string();\n                        if t == \"/quit\" || t == \"/exit\" { break; }\n                        if !t.is_empty() {\n                            state.push_message(Message::user(&t));\n                            let _ = writeln!(agent_writer, r#\"{{\"type\":\"user_input\",\"text\":\"{t}\"}}\"#);\n                            let _ = agent_writer.flush();\n                            stream.clear();\n                            state.mode = Mode::Streaming;\n                        }\n                    }\n                    _ => {}\n                }\n            }\n        }\n\n        // Agent frames: read one line (non-blocking attempt)\n        // Read available bytes from agent stdout\n        loop {\n            let mut line = String::new();\n            match agent_reader.read_line(&mut line) {\n                Ok(0) | Err(_) => break,\n                Ok(_) => {\n                    dirty = true;\n                    let trimmed = line.trim();\n                    if trimmed.is_empty() { continue; }\n                    if trimmed.contains(\"\\\"api_response\\\"\") {\n                        if let Ok(v) = serde_json::from_str::<serde_json::Value>(trimmed) {\n                            if let Some(content) = v.get(\"content\").and_then(|c| c.as_str()) {\n                                stream.apply_payload(content, None, &[]);\n                            }\n                        }\n                    } else if trimmed.contains(\"\\\"done\\\"\") {\n                        let msg = stream.to_message();\n                        state.push_message(msg);\n                        stream.clear();\n                        state.mode = Mode::Chat;\n                    }\n                }\n            }\n        }\n\n        // Render\n        if dirty {\n            if terminal.draw(|f| crate::render::render_all(f, &state, &conn_stub, &stream)).is_err() {\n                break;\n            }\n            dirty = false;\n            std::thread::sleep(std::time::Duration::from_millis(33));\n        } else {\n            std::thread::sleep(std::time::Duration::from_millis(50));\n        }\n    };\n\n    let _ = terminal.clear();\n    let _ = crossterm::execute!(std::io::stdout(),\n        crossterm::terminal::LeaveAlternateScreen, crossterm::cursor::Show);\n    crossterm::terminal::disable_raw_mode()?;\n    drop(agent_writer);\n    let _ = child.wait();\n    result\n}","originalFile":null,"structuredPatch":[{"oldStart":178,"oldLines":22,"newStart":178,"newLines":35,"lines":["     result"," }"," ","-/// Pure ratatui demo mode — no HP, no agent, no tools, no network.","-/// Skeleton for isolating TUI rendering issues.","+/// Pure ratatui demo mode — spawns agent with direct pipes (no AgentConnection thread)."," fn run_demo() -> anyhow::Result<()> {","     use dsx_types::Message;","+    use std::io::{BufRead, Write};","+    use std::process::{Command, Stdio