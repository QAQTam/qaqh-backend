 pub mode: Mode,\n52\t\n53\t    // ── 斜杠菜单 ──\n54\t    pub slash_open: bool,\n55\t    pub slash_filter: String,\n56\t    pub slash_idx: usize,\n57\t    pub slash_items: Vec<(String, String)>,\n58\t    pub slash_submenu: Option<SubMenuState>,\n59\t    pub esc_just_closed_menu: bool,\n60\t    pub exit_prompt: bool,"}]},"uuid":"db8918d3-ef95-462e-80f1-326a8accda98","timestamp":"2026-05-14T13:52:23.907Z","toolUseResult":{"type":"text","file":{"filePath":"/home/qaqtamsy/Desktop/dsx/src/dsx-tui/DESIGN-E01-APP-CORE.md","content":"# DSX TUI — 应用核心设计文档\n\n**Team E (dsx-tui) · E01 应用核心**\n**设计范围：** AppState / AgentConnection / StreamBuffer / 主事件循环 / 斜杠命令 / 模式状态机\n\n---\n\n## 1. 架构总览\n\n```\n┌──────────────────────────────────────────────────────┐\n│                    Main Event Loop                     │\n│  ┌─────────────┐  ┌──────────────┐  ┌──────────────┐ │\n│  │ Keyboard     │  │ IPC          │  │ Render       │ │\n│  │ Event Poll   │  │ Event Poll   │  │ Tick (timer) │ │\n│  └──────┬───────┘  └──────┬───────┘  └──────┬───────┘ │\n│         │                 │                 │          │\n│         ▼                 ▼                 ▼          │\n│  ┌─────────────────────────────────────────────────┐  │\n│  │               AppState (read/write)               │  │\n│  │  ┌────────────┐  ┌───────────────┐               │  │\n│  │  │ AgentConn  │  │ StreamBuffer  │               │  │\n│  │  └────────────┘  └───────────────┘               │  │\n│  └─────────────────────────────────────────────────┘  │\n└──────────────────────────────────────────────────────┘\n```\n\n**核心拆分原则：** 将当前 app.rs (单文件 ~510 行, 50+ 字段) 按职责拆分为三个独立模块。\n\n---\n\n## 2. AppState — UI 状态\n\n### 职责\n仅管理 TUI 渲染和键盘交互所需的状态。与 Agent 通信无关。\n\n```rust\n// src/dsx-tui/app_state.rs\npub(crate) struct AppState {\n    // ── 输入状态 ──\n    pub input: String,\n    pub input_cursor: usize,\n\n    // ── 聊天显示 ──\n    pub messages: Vec<Message>,          // 扁平化消息快照（渲染唯读）\n    pub scroll_offset: usize,\n    pub auto_scroll: bool,\n    pub last_max_scroll: usize,\n\n    // ── 模式 ──\n    pub mode: Mode,\n\n    // ── 斜杠菜单 ──\n    pub slash_open: bool,\n    pub slash_filter: String,\n    pub slash_idx: usize,\n    pub slash_items: Vec<(String, String)>,\n    pub slash_submenu: Option<SubMenuState>,\n    pub esc_just_closed_menu: bool,\n    pub exit_prompt: bool,","numLines":60,"startLine":1,"totalLines":510}},"sourceToolAssistantUUID":"6988165a-5d50-4845-a657-afedae83354e","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.141","gitBranch":"master","slug":"gentle-orbiting-karp"}
