{"parentUuid":"76809e75-003c-4dd4-8d03-e212d01f11d0","isSidechain":false,"teamName":"dsx","promptId":"5724b6ea-c2f5-49af-a4ee-6f5499c7367a","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00_95ArW8duY2TyT7bITd8J5267","type":"tool_result","content":"31\tpub fn audit_session(messages: &[Message]) -> AuditResult {\n32\t    // Structural check via ContextAssembler (canonical validation authority)\n33\t    let (assembler, repairs) = ContextAssembler::from_legacy(messages.to_vec());\n34\t\n35\t    if !repairs.is_empty() {\n36\t        return AuditResult::Repairable {\n37\t            issues: repairs.clone(),\n38\t            fix_description: format!(\"{} issue(s) found: {}\", repairs.len(), repairs.join(\"; \")),\n39\t        };\n40\t    }\n41\t\n42\t    match assembler.validate() {\n43\t        Ok(()) => AuditResult::Clean,\n44\t        Err(e) => AuditResult::Corrupted { reason: e },\n45\t    }\n46\t}\n47\t\n48\t/// Repair a `ContextAssembler` in-place, returning the audit result\n49\t/// and list of repairs performed.\n50\t///\n51\t/// Ported from `repair_messages()` in `tui/app.rs`.\n52\tpub fn repair_session(ctx: &mut ContextAssembler) -> (AuditResult, Vec<String>) {\n53\t    let msgs = ctx.to_vec();\n54\t    let (new_ctx, repairs) = ContextAssembler::from_legacy(msgs);\n55\t    *ctx = new_ctx;"}]},"uuid":"f2390874-e6c3-43c1-8f7d-d5b237735342","timestamp":"2026-05-14T17:18:28.970Z","toolUseResult":{"type":"text","file":{"filePath":"/home/qaqtamsy/Desktop/dsx/crates/dsx-hp/src/audit.rs","content":"pub fn audit_session(messages: &[Message]) -> AuditResult {\n    // Structural check via ContextAssembler (canonical validation authority)\n    let (assembler, repairs) = ContextAssembler::from_legacy(messages.to_vec());\n\n    if !repairs.is_empty() {\n        return AuditResult::Repairable {\n            issues: repairs.clone(),\n            fix_description: format!(\"{} issue(s) found: {}\", repairs.len(), repairs.join(\"; \")),\n        };\n    }\n\