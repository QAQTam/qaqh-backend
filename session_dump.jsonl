work, we need periodic rendering. The approach:\n\n```rust\nloop {\n    // Check for keyboard with short timeout\n    if crossterm::event::poll(Duration::from_millis(100))? {\n        if let Event::Key(key) = crossterm::event::read()? {\n            // handle key\n        }\n    }\n    \n    // Drain agent frames\n    let has_frames = conn.drain_frames().len() > 0;\n    \n    // Only render when needed\n    if dirty || has_frames || stream.is_active() {\n        terminal.draw(...)?;\n    }\n    \n    // Sleep when idle\n    if !has_frames && !stream.is_active() {\n        std::thread::sleep(Duration::from_millis(50));\n    }\n}\n```\n\nThe 100ms poll timeout means max 10fps during idle, which is fine for a TUI. During streaming, has_frames keeps it rendering.\n\nLet me implement this clean version. I'll replace the current event loop with this simpler, proven pattern.\n\nLet me also add the `use` imports correctly and make sure the render function is called properly.","signature":"d19048be-4211-447b-bab0-afcb9fceb286"}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":129,"cache_creation_input_tokens":0,"cache_read_input_tokens":311168,"output_tokens":1244,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"},"stop_details":null},"type":"assistant","uuid":"6d027312-c72e-49bf-afd2-ea3f930263e7","timestamp":"2026-05-15T04:42:33.864Z","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
