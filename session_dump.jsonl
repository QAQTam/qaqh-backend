{"parentUuid":"413570a2-1f08-4a4f-9f35-b3a27d4e2d50","isSidechain":false,"teamName":"dsx-integration","attachment":{"type":"edited_text_file","filename":"/home/qaqtamsy/Desktop/dsx/crates/dsx-agent/src/runner.rs","snippet":"1\t//! dsx-agent — central process. Connects TUI ↔ Agent ↔ Tools ↔ HP.\n2\t//!\n3\t//! Wires all intelligence modules (session, memory, orchestrator, context,\n4\t//! skills, router, tokenizer, health) into the HP-bridged conversation loop.\n5\t//!\n6\t//! Uses shared dsx-proto types for all IPC channels (TUI, Tools, HP).\n7\t\n8\tuse std::io::{BufRead, BufReader, Write};\n9\tuse std::net::TcpStream;\n10\tuse std::process::{Command, Stdio};\n11\t\n12\tuse dsx_proto::{\n13\t    self, TuiToAgent, AgentToTui, AgentToTools, ToolsToAgent, AgentToHp, HpToAgent,\n14\t};\n15\t\n16\tuse crate::agent::{AgentState, ToolResultAppender};\n17\tuse crate::config::Config;\n18\tuse crate::dsc_log;\n19\tuse crate::memory;\n20\tuse crate::orchestrator::{gates, learning, phase_detector, tracker, turn_scorer, session_persistence};\n21\tuse crate::router;\n22\tuse crate::session;\n23\tuse crate::tokenizer;\n24\tuse crate::tools;\n25\tuse dsx_types::{AgentPhase, Message, ToolCall, FunctionCall};\n26\t\n27\t// ── HP connection ──\n28\t\n29\tfn hp_port() -> u16 {\n30\t    let home = std::env::var(\"HOME\").unwrap_or_else(|_| \"/tmp\".into());\n31\t    let path = std::path::PathBuf::from(home).join(\".dsx\").join(\"hp.port\");\n32\t    std::fs::read_to_string(&path).ok().and_then(|s| s.trim().parse().ok()).unwrap_or(0)\n33\t}\n34\t\n35\t/// Connect to HP, register, and return the TCP stream.\n36\t/// Uses set_nonblocking(false) + single stream for reliable read/write.\n37\tfn connect_hp() -> Option<TcpStream> {\n38\t    let port = hp_port();\n39\t    if port == 0 {\n40\t        eprintln!(\"dsx-agent: HP not running (no hp.port) — continuing without AI\");\n41\t        return None;\n42\t    }\n43\t\n44\t    let mut stream = match TcpStream::connect(format!(\"127.0.0.1:{port}\")) {\n45\t        Ok(s) => s,\n46\t        Err(e) => {\n47\t            eprintln!(\"dsx-agent: cannot connect HP: {e}\");\n48\t            return None;\n49\t        }\n50\t    };\n51\t\n52\t    let pid = std::process::id();\n53\t    let reg = AgentToHp::Register {\n54\t        kind: \"Agent\".into(),\n55\t        name: \"dsx-agent\".into(),\n56\t        pid,\n57\t    };\n58\t    let _ = dsx_proto::write_frame(&mut stream, &reg);\n59\t\n60\t    eprintln!(\"dsx-agent: connected to HP on port {port}\");\n61\t    Some(stream)\n62\t}\n63\t\n64\t// ── Session initialization ──\n65\t\n66\tfn init_session(agent: &mut AgentState) {\n67\t    // Always create a fresh session. Session restore is opt-in via --resume.\n68\t    agent.session_seed = session::generate_seed();\n69\t    agent.session_start = session::now_epoch();\n70\t    agent.short_mem = memory::ShortTermMemory::new(&agent.session_seed, &agent.config.model);\n71\t    dsc_log::set_session(&agent.session_seed);\n72\t    tools::set_current_session(&agent.session_seed);\n73\t    session::save_live_snapshot(\n74\t        &agent.session_seed, &agent.messages,\n75\t        &agent.config.model, agent.config.effort.as_deref(), None, None,\n76\t    );\n77\t    eprintln!(\"dsx-agent: new session {}\", agent.session_seed);\n78\t}\n79\t\n80\t/// Attempt to restore a previous live session. Returns true on success.\n81\t/// Only called when the user explicitly requests resume (e.g. via --resume flag).\n82\tfn try_restore_session(agent: &mut AgentState) -> bool {\n83\t    let lives = session::find_live_sessions();\n84\t    if let Some(meta) = lives.first() {\n85\t        eprintln!(\"dsx-agent: found live session {} ({} msgs, {})\",\n86\t            meta.seed, meta.message_count, meta.last_summary);\n87\t        if let Some(file) = session::load_session(&meta.seed) {\n88\t            agent.session_seed = file.seed.clone();\n89\t            agent.session_start = file.created_at;\n90\t            let (ctx, repairs) = crate::conversation::ContextAssembler::from_legacy(file.messages);\n91\t            agent.ctx = ctx;\n92\t            agent.sync_messages();\n93\t            if !repairs.is_empty() {\n94\t                log::warn!(\"session restore repairs: {}\", repairs.join(\"; \"));\n95\t            }\n96\t            agent.short_mem = memory::ShortTermMemory::new(&file.seed, &file.model);\n97\t            if let Some(phase) = file.task_phase {\n98\t                router::set_phase(phase, dsx_types::DebugLevel::Medium);\n99\t                agent.current_task_phase = phase;\n100\t            }\n101\t            dsc_log::set_session(&agent.session_seed);\n102\t            tools::set_current_session(&agent.session_seed);\n103\t            eprintln!(\"dsx-agent: session {} restored ({} messages)\", agent.session_seed, agent.messages.len());\n104\t            return true;\n105\t        }\n106\t    }\n107\t    false\n108\t}\n109\t\n110\tfn health_status(agent: &AgentState) -> String {\n111\t    let assessment = agent.health.assess();\n112\t    format!(\n113\t        \"[{} {} {} | tier:{:?} | {}% | t{}]\",\n114\t        if assessment.level == crate::health::HealthLevel::Red { \"RED\" }\n115\t        else if assessment.level == crate::health::HealthLevel::Yellow { \"YLW\" }\n116\t        else { \"OK\" },\n117\t        assessment.emotion.emoji(),\n118\t        assessment.emotion.label(),\n119\t        agent.health.context_tier,\n120\t        (assessment.success_rate * 100.0) as u32,\n121\t        agent.health.turn,\n122\t    )\n123\t}\n124\t\n125\t// ── Message conversion ──\n126\t\n127\t/// Parse DeepSeek v4 XML-style tool calls from text content.\n128\t///\n129\t/// DeepSeek v4 models output tool calls as XML in text content instead of\n130\t/// native Anthropic tool_use blocks:\n131\t///\n132\t/// ```xml\n133\t/// <tool_use>\n134\t/// <tool_name>search</tool_name>\n135\t/// {\"query\": \"latest kernel changes\"}\n136\t/// </tool_use>\n137\t/// ```\n138\t///\n139\t/// Returns (cleaned_content_wit