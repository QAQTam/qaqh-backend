{"parentUuid":"bce38327-b47c-4779-a47e-aafa4cda5602","isSidechain":false,"teamName":"dsx-integration","message":{"id":"719486d4-a0b0-4352-bfea-a0a5d6cc2730","type":"message","role":"assistant","model":"deepseek-v4-pro","content":[{"type":"tool_use","id":"call_00_jyVIjY9xU8chMSMLFcEG5088","name":"Read","input":{"file_path":"/home/qaqtamsy/Desktop/dsx/crates/dsx-tools/src/ipc.rs"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":166,"cache_creation_input_tokens":0,"cache_read_input_tokens":81152,"output_tokens":378,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"},"stop_details":null},"type":"assistant","uuid":"dfed9a3e-cfe8-4c43-93d0-f96cfb54097c","timestamp":"2026-05-15T05:44:02.145Z","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
{"parentUuid":"dfed9a3e-cfe8-4c43-93d0-f96cfb54097c","isSidechain":false,"teamName":"dsx-integration","promptId":"e8cab011-c873-483b-b840-3d27ded1852a","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00_jyVIjY9xU8chMSMLFcEG5088","type":"tool_result","content":"1\t//! JSON-LP IPC 协议帧定义与传输层。\n2\t//!\n3\t//! 协议：每行一个完整 JSON 对象（`\\n` 分隔），称为一帧。\n4\t//!\n5\t//! Agent → Tools: tools_init, tool_call_req, tool_cancel, tools_shutdown, tool_confirm_resp\n6\t//! Tools → Agent: tools_ready, tool_progress, tool_result, tool_result_message, tool_error, tool_confirm_req\n7\t\n8\tuse serde::{Deserialize, Serialize};\n9\t\n10\t// ── 入站帧（Agent → Tools）──\n11\t\n12\t#[derive(Debug, Deserialize)]\n13\t#[serde(tag = \"type\")]\n14\tpub enum InboundFrame {\n15\t    #[serde(rename = \"tools_init\")]\n16\t    Init {\n17\t        allowed_tools: Vec<String>,\n18\t        session_seed: String,\n19\t        auto_mode: bool,\n20\t    },\n21\t\n22\t    #[serde(rename = \"tool_call_req\")]\n23\t    CallReq {\n24\t        id: String,\n25\t        name: String,\n26\t        action: String,\n27\t        args: serde_json::Value,\n28\t        /// 超时覆盖（秒），None = 使用 handler 默认值。\n29\t        timeout_secs: Option<u64>,\n30\t    },\n31\t\n32\t    #[serde(rename = \"tool_cancel\")]\n33\t    Cancel {\n34\t        /// None = 取消所有，Some(id) = 取消指定工具。\n35\t        id: Option<String>,\n36\t    },\n37\t\n38\t    /// Agent 对 `tool_confirm_req` 的用户批准/拒绝回复。\n39\t    #[serde(rename = \"tool_confirm_resp\")]\n40\t    ConfirmResp {\n41\t        id: String,\n42\t        approved: bool,\n43\t    },\n44\t\n45\t    #[serde(rename = \"tools_shutdown\")]\n46\t    Shutdown,\n47\t}\n48\t\n49\t// ── 出站帧（Tools → Agent）──\n50\t\n51\t#[derive(Debug, Serialize)]\n52\t#[serde(tag = \"type\")]\n53\tpub enum OutboundFrame {\n54\t    /// Tools 进程就绪，附带可用工具定义列表。\n55\t    #[serde(rename = \"tools_ready\")]\n56\t    Ready {\n57\t        tools: Vec<dsx_types::ToolDef>,\n58\t    },\n59\t\n60\t    /// 流式进度输出。\n61\t    #[serde(rename = \"tool_progress\")]\n62\t    Progress {\n63\t        id: String,\n64\t        content: String,\n65\t        /// \"stdout\" | \"stderr\" | \"progress\"\n66\t        stream_type: String,\n67\t    },\n68\t\n69\t    /// 旧式工具结果（纯文本，向后兼容）。\n70\t    #[serde(rename = \"tool_result\")]\n71\t    Result {\n72\t        id: String,\n73\t        success: bool,\n74\t        content: String,\n75\t    },\n76\t\n77\t    /// 新式工具结果消息——包含构造 Message::tool() 所需的全部字段。\n78\t    /// Agent 收到此帧后可直接构造 conversation Message，无需额外解析。\n79\t    #[serde(rename = \"tool_result_message\")]\n80\t    ToolResultMessage {\n81\t        id: String,\n82\t        name: String,\n83\t        action: String,\n84\t        success: bool,\n85\t        content: String,\n86\t        /// Anthropic 协议：Some(true) 表示 is_error。\n87\t        #[serde(skip_serializing_if = \"Option::is_none\")]\n88\t        is_error: Option<bool>,\n89\t    },\n90\t\n91\t    /// 工具执行出错（拦截/未知工具/panic/超时）。\n92\t    #[serde(rename = \"tool_error\")]\n93\t    ToolError {\n94\t        id: String,\n95\t        error: String,\n96\t        /// \"UNKNOWN_TOOL\" | \"BLOCKED\" | \"TIMEOUT\" | \"PANIC\" | \"FORBIDDEN\"\n97\t        code: String,\n98\t    },\n99\t\n100\t    /// 请求用户确认（安全弹窗）。\n101\t    #[serde(rename = \"tool_confirm_req\")]\n102\t    ToolConfirmReq {\n103\t        id: String,\n104\t        tool_name: String,\n105\t        action: String,\n106\t        /// \"confirm\" | \"danger\"\n107\t        danger_level: String,\n108\t        prompt: String,\n109\t    },\n110\t}\n111\t\n112\t// ── 帧读写 ──\n113\t\n114\tuse std::io::{self, BufRead, Write};\n115\t\n116\t/// 从 reader 读取下一个入站帧。返回 None 表示 EOF。\n117\tpub fn read_frame(reader: &mut impl BufRead) -> io::Result<Option<InboundFrame>> {\n118\t    let mut line = String::new();\n119\t    let n = reader.read_line(&mut line)?;\n120\t    if n == 0 {\n121\t        return Ok(None); // EOF\n122\t    }\n123\t    let trimmed = line.trim();\n124\t    if trimmed.is_empty() {\n125\t        return Ok(None);\n126\t    }\n127\t    match serde_json::from_str::<InboundFrame>(trimmed) {\n128\t        Ok(frame) => Ok(Some(frame)),\n129\t        Err(e) => Err(io::Error::new(io::ErrorKind::InvalidData, e)),\n130\t    }\n131\t}\n132\t\n133\t/// 向 writer 写出站帧（自动追加 \\n 并 flush）。\n134\tpub fn write_frame(writer: &mut impl Write, frame: &OutboundFrame) -> io::Result<()> {\n135\t    let json = serde_json::to_string(frame)?;\n136\t    writeln!(writer, \"{}\", json)?;\n137\t    writer.flush()?;\n138\t    Ok(())\n139\t}\n140\t\n141\t// ── IPC 主循环 ──\n142\t\n143\tuse crate::ToolManager;\n144\t\n145\t/// IPC 主循环：从 stdin 读取 Agent 帧 → ToolManager 路由 → 写入 stdout。\n146\t///\n147\t/// 仅在收到 ToolsShutdown 或 EOF 时返回。\n148\tpub fn ipc_main_loop(manager: &mut ToolManager) {\n149\t    let stdin = io::stdin();\n150\t    let stdout = io::stdout();\n151\t    let mut reader = io::BufReader::new(stdin.lock());\n152\t    let mut writer = stdout.lock();\n153\t\n154\t    loop {\n155\t        let frame = match read_frame(&mut reader) {\n156\t            Ok(Some(f)) => f,\n157\t            Ok(None) => break,  // EOF\n158\t            Err(e) => {\n159\t                let _ = write_frame(&mut writer, &OutboundFrame::ToolError {\n160\t                    id: \"ipc\".into(),\n161\t                    error: format!(\"IPC parse error: {}\", e),\n162\t                    code: \"IPC_ERROR\".into(),\n163\t                });\n164\t                continue;\n165\t            }\n166\t        };\n167\t\n168\t        match frame {\n169\t            InboundFrame::Init { allowed_tools, session_seed, auto_mode } => {\n170\t                manager.apply_init(allowed_tools, &session_seed, auto_mode);\n171\t                let tools = manager.filtered_defs();\n172\t                if write_frame(&mut writer, &OutboundFrame::Ready { tools }).is_err() {\n173\t                    break; // stdout closed\n174\t                }\n175\t            }\n176\t\n177\t            InboundFrame::CallReq { id, name, action, args, timeout_secs } => {\n178\t                let response = manager.handle_req(id, &name, &action, args, timeout_secs);\n179\t                if write_frame(&mut writer, &response).is_err() {\n180\t                    break;\n181\t                }\n182\t            }\n183\t\n184\t            InboundFrame::Cancel { id } => {\n185\t                manager.cancel_tool(id.as_deref());\n186\t            }\n187\t\n188\t            InboundFrame::ConfirmResp { id, approved } => {\n189\t                // 暂未实现同步等待 ConfirmResp 的机制。\n190\t                // 当前版本：Confirm 级别工具直接返回 ToolConfirmReq 帧，\n191\t                // Agent 回复 ConfirmResp 时由 ToolManager 查找等待队列。\n192\t                // 简单实现：记录响应但不做处理（保持设计为未来扩展）。\n193\t                let _ = (id, approved);\n194\t            }\n195\t\n196\t            InboundFrame::Shutdown => break,\n197\t        }\n198\t    }\n199\t}\n200\t"}]},"uuid":"89fd8bc0-5230-4d7e-9f7c-95f9ee8db81b","timestamp":"2026-05-15T05:44:02.157Z","toolUseResult":{"type":"text","file":{"filePath":"/home/qaqtamsy/Desktop/dsx/crates/dsx-tools/src/ipc.rs","content":"//! JSON-LP IPC 协议帧定义与传输层。\n//!\n//! 协议：每行一个完整 JSON 对象（`\\n` 分隔），称为一帧。\n//!\n//! Agent → Tools: tools_init, tool_call_req, tool_cancel, tools_shutdown, tool_confirm_resp\n//! Tools → Agent: tools_ready, tool_progress, tool_result, tool_result_message, tool_error, tool_confirm_req\n\nuse serde::{Deserialize, Serialize};\n\n// ── 入站帧（Agent → Tools）──\n\n#[derive(Debug, Deserialize)]\n#[serde(tag = \"type\")]\npub enum InboundFrame {\n    #[serde(rename = \"tools_init\")]\n    Init {\n        allowed_tools: Vec<String>,\n        session_seed: String,\n        auto_mode: bool,\n    },\n\n    #[serde(rename = \"tool_call_req\")]\n    CallReq {\n        id: String,\n        name: String,\n        action: String,\n        args: serde_json::Value,\n        /// 超时覆盖（秒），None = 使用 handler 默认值。\n        timeout_secs: Option<u64>,\n    },\n\n    #[serde(rename = \"tool_cancel\")]\n    Cancel {\n        /// None = 取消所有，Some(id) = 取消指定工具。\n        id: Option<String>,\n    },\n\n    /// Agent 对 `tool_confirm_req` 的用户批准/拒绝回复。\n    #[serde(rename = \"tool_confirm_resp\")]\n    ConfirmResp {\n        id: String,\n        approved: bool,\n    },\n\n    #[serde(rename = \"tools_shutdown\")]\n    Shutdown,\n}\n\n// ── 出站帧（Tools → Agent）──\n\n#[derive(Debug, Serialize)]\n#[serde(tag = \"type\")]\npub enum OutboundFrame {\n    /// Tools 进程就绪，附带可用工具定义列表。\n    #[serde(rename = \"tools_ready\")]\n    Ready {\n        tools: Vec<dsx_types::ToolDef>,\n    },\n\n    /// 流式进度输出。\n    #[serde(rename = \"tool_progress\")]\n    Progress {\n        id: String,\n        content: String,\n        /// \"stdout\" | \"stderr\" | \"progress\"\n        stream_type: String,\n    },\n\n    /// 旧式工具结果（纯文本，向后兼容）。\n    #[serde(rename = \"tool_result\")]\n    Result {\n        id: String,\n        success: bool,\n        content: String,\n    },\n\n    /// 新式工具结果消息——包含构造 Message::tool() 所需的全部字段。\n    /// Agent 收到此帧后可直接构造 conversation Message，无需额外解析。\n    #[serde(rename = \"tool_result_message\")]\n    ToolResultMessage {\n        id: String,\n        name: String,\n        action: String,\n        success: bool,\n        content: String,\n        /// Anthropic 协议：Some(true) 表示 is_error。\n        #[serde(skip_serializing_if = \"Option::is_none\")]\n        is_error: Option<bool>,\n    },\n\n    /// 工具执行出错（拦截/未知工具/panic/超时）。\n    #[serde(rename = \"tool_error\")]\n    ToolError {\n        id: String,\n        error: String,\n        /// \"UNKNOWN_TOOL\" | \"BLOCKED\" | \"TIMEOUT\" | \"PANIC\" | \"FORBIDDEN\"\n        code: String,\n    },\n\n    /// 请求用户确认（安全弹窗）。\n    #[serde(rename = \"tool_confirm_req\")]\n    ToolConfirmReq {\n        id: String,\n        tool_name: String,\n        action: String,\n        /// \"confirm\" | \"danger\"\n        danger_level: String,\n        prompt: String,\n    },\n}\n\n// ── 帧读写 ──\n\nuse std::io::{self, BufRead, Write};\n\n/// 从 reader 读取下一个入站帧。返回 None 表示 EOF。\npub fn read_frame(reader: &mut impl BufRead) -> io::Result<Option<InboundFrame>> {\n    let mut line = String::new();\n    let n = reader.read_line(&mut line)?;\n    if n == 0 {\n        return Ok(None); // EOF\n    }\n    let trimmed = line.trim();\n    if trimmed.is_empty() {\n        return Ok(None);\n    }\n    match serde_json::from_str::<InboundFrame>(trimmed) {\n        Ok(frame) => Ok(Some(frame)),\n        Err(e) => Err(io::Error::new(io::ErrorKind::InvalidData, e)),\n    }\n}\n\n/// 向 writer 写出站帧（自动追加 \\n 并 flush）。\npub fn write_frame(writer: &mut impl Write, frame: &OutboundFrame) -> io::Result<()> {\n    let json = serde_json::to_string(frame)?;\n    writeln!(writer, \"{}\", json)?;\n    writer.flush()?;\n    Ok(())\n}\n\n// ── IPC 主循环 ──\n\nuse crate::ToolManager;\n\n/// IPC 主循环：从 stdin 读取 Agent 帧 → ToolManager 路由 → 写入 stdout。\n///\n/// 仅在收到 ToolsShutdown 或 EOF 时返回。\npub fn ipc_main_loop(manager: &mut ToolManager) {\n    let stdin = io::stdin();\n    let stdout = io::stdout();\n    let mut reader = io::BufReader::new(stdin.lock());\n    let mut writer = stdout.lock();\n\n    loop {\n        let frame = match read_frame(&mut reader) {\n            Ok(Some(f)) => f,\n            Ok(None) => break,  // EOF\n            Err(e) => {\n                let _ = write_frame(&mut writer, &OutboundFrame::ToolError {\n                    id: \"ipc\".into(),\n                    error: format!(\"IPC parse error: {}\", e),\n                    code: \"IPC_ERROR\".into(),\n                });\n                continue;\n            }\n        };\n\n        match frame {\n            InboundFrame::Init { allowed_tools, session_seed, auto_mode } => {\n                manager.apply_init(allowed_tools, &session_seed, auto_mode);\n                let tools = manager.filtered_defs();\n                if write_frame(&mut writer, &OutboundFrame::Ready { tools }).is_err() {\n                    break; // stdout closed\n                }\n            }\n\n            InboundFrame::CallReq { id, name, action, args, timeout_secs } => {\n                let response = manager.handle_req(id, &name, &action, args, timeout_secs);\n                if write_frame(&mut writer, &response).is_err() {\n                    break;\n                }\n            }\n\n            InboundFrame::Cancel { id } => {\n                manager.cancel_tool(id.as_deref());\n            }\n\n            InboundFrame::ConfirmResp { id, approved } => {\n                // 暂未实现同步等待 ConfirmResp 的机制。\n                // 当前版本：Confirm 级别工具直接返回 ToolConfirmReq 帧，\n                // Agent 回复 ConfirmResp 时由 ToolManager 查找等待队列。\n                // 简单实现：记录响应但不做处理（保持设计为未来扩展）。\n                let _ = (id, approved);\n            }\n\n            InboundFrame::Shutdown => break,\n        }\n    }\n}\n","numLines":200,"startLine":1,"totalLines":200}},"sourceToolAssistantUUID":"dfed9a3e-cfe8-4c43-93d0-f96cfb54097c","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
{"parentUuid":"89fd8bc0-5230-4d7e-9f7c-95f9ee8db81b","isSidechain":false,"teamName":"dsx-integration","message":{"id":"719486d4-a0b0-4352-bfea-a0a5d6cc2730","type":"message","role":"assistant","model":"deepseek-v4-pro","content":[{"type":"tool_use","id":"call_01_lHjEjjmRo8mjcBOXFKCf3228","name":"Read","input":{"file_path":"/home/qaqtamsy/Desktop/dsx/crates/dsx-tui/src/state.rs"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":166,"cache_creation_input_tokens":0,"cache_read_input_tokens":81152,"output_tokens":378,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"},"stop_details":null},"type":"assistant","uuid":"f3ca1c2a-d532-4f2e-a7bd-16d8a67e6297","timestamp":"2026-05-15T05:44:03.449Z","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
{"parentUuid":"f3ca1c2a-d532-4f2e-a7bd-16d8a67e6297","isSidechain":false,"teamName":"dsx-integration","promptId":"e8cab011-c873-483b-b840-3d27ded1852a","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01_lHjEjjmRo8mjcBOXFKCf3228","type":"tool_result","content":"1\t//! AppState — pure UI state, no agent/orchestrator/tool domains.\n2\t//!\n3\t//! Three structs:\n4\t//!   - AppState: UI rendering state (~25 pure fields, no ctx/health/memory)\n5\t//!   - StreamBuffer: accumulates streaming deltas from Agent\n6\t//!   - AgentConnection: spawns Agent subprocess, manages JSON-LP IPC\n7\t\n8\tuse std::io::{BufRead, BufReader, Write};\n9\tuse std::process::{Child, Command, Stdio};\n10\tuse std::sync::mpsc as std_mpsc;\n11\tuse std::thread;\n12\tuse std::time::Instant;\n13\t\n14\tuse serde::{Deserialize, Serialize};\n15\t\n16\tuse dsx_types::{Message, UsageInfo, SessionMeta, ToolCall, SafetyLevel};\n17\tuse crate::stubs::config::Config;\n18\tuse super::input::state::InputState;\n19\tuse super::mode::Mode;\n20\t/// Re-use gate/error types from legacy App (they live in app.rs during migration).\n21\tuse super::app::{GateBlocked, ApiError, RetryProgress, RateLimitInfo};\n22\t\n23\t// ─── AgentConnection ────────────────────────────────────────────────────\n24\t\n25\t/// Frames sent from TUI → Agent via stdin (JSON-LP).\n26\t#[derive(Debug, Serialize)]\n27\t#[serde(tag = \"type\")]\n28\tpub(crate) enum TuiFrame {\n29\t    #[serde(rename = \"user_input\")]\n30\t    UserInput {\n31\t        text: String,\n32\t    },\n33\t    #[serde(rename = \"shutdown\")]\n34\t    Shutdown,\n35\t}\n36\t\n37\t/// Frames received from Agent → TUI via stdout (JSON-LP).\n38\t#[derive(Debug, Deserialize)]\n39\t#[serde(tag = \"type\")]\n40\tpub(crate) enum AgentFrame {\n41\t    #[serde(rename = \"api_response\")]\n42\t    StreamPayload {\n43\t        content: String,\n44\t    },\n45\t    #[serde(rename = \"done\")]\n46\t    StreamDone,\n47\t    #[serde(rename = \"error\")]\n48\t    StreamError {\n49\t        message: String,\n50\t    },\n51\t    #[serde(rename = \"shutdown_ack\")]\n52\t    ShutdownAck,\n53\t}\n54\t\n55\t// ─── AgentConnection ────────────────────────────────────────────────────\n56\t\n57\t/// Manages the lifecycle of the Agent subprocess and JSON-LP IPC.\n58\t///\n59\t/// Spawns the agent binary on construction, writes JSON-LP frames to its\n60\t/// stdin, and reads JSON-LP frames from its stdout via a background reader\n61\t/// thread feeding a std::sync::mpsc channel.\n62\t///\n63\t/// Also tracks lightweight execution state needed by the render layer\n64\t/// (exec_pending, exec_started_at). Heavier agent concerns (health, memory,\n65\t/// turn scoring) live in dsx-agent, not here.\n66\tpub(crate) struct AgentConnection {\n67\t    child: Option<Child>,\n68\t    stdin: Option<Box<dyn Write + Send>>,\n69\t    frame_rx: std_mpsc::Receiver<AgentFrame>,\n70\t    config: Config,\n71\t    reader_handle: Option<thread::JoinHandle<()>>,\n72\t\n73\t    // ── Execution state (render-visible) ──\n74\t    pub exec_pending: usize,\n75\t    pub exec_started_at: Option<Instant>,\n76\t\n77\t    // ── Agent health state ──\n78\t    pub health: AgentHealth,\n79\t}\n80\t\n81\t/// Lightweight health summary of the Agent subprocess.\n82\t#[derive(Debug, Default)]\n83\tpub(crate) struct AgentHealth {\n84\t    pub has_orphan_tool_uses: bool,\n85\t}\n86\t\n87\timpl AgentConnection {\n88\t    /// Spawn the Agent subprocess and start the stdout reader thread.\n89\t    ///\n90\t    /// The `agent_bin` path points to the dsx-agent binary. If `None`,\n91\t    /// the connection is stubbed (for development/testing).\n92\t    pub fn spawn(\n93\t        agent_bin: Option<&str>,\n94\t        config: Config,\n95\t    ) -> anyhow::Result<Self> {\n96\t        // Bounded channel prevents memory growth if event loop can't keep up.\n97\t        // SyncSender blocks the reader thread (creating backpressure to the agent)\n98\t        // when the buffer is full — the agent itself will block on stdout writes.\n99\t        let (frame_tx, frame_rx) = std::sync::mpsc::sync_channel(100);\n100\t\n101\t        let (child, stdin, reader_handle) = if let Some(bin) = agent_bin {\n102\t            let mut child = Command::new(bin)\n103\t                .stdin(Stdio::piped())\n104\t                .stdout(Stdio::piped())\n105\t                .stderr(Stdio::inherit())\n106\t                .spawn()?;\n107\t\n108\t            let stdin = child.stdin.take()\n109\t                .map(|s| Box::new(s) as Box<dyn Write + Send>);\n110\t            let stdout = child.stdout.take()\n111\t                .expect(\"failed to capture agent stdout\");\n112\t\n113\t            // Background thread: reads JSON-LP lines from agent stdout\n114\t            let handle = thread::Builder::new()\n115\t                .name(\"agent-reader\".into())\n116\t                .spawn(move || {\n117\t                    let reader = BufReader::new(stdout);\n118\t                    for line in reader.lines() {\n119\t                        match line {\n120\t                            Ok(line) => {\n121\t                                if line.trim().is_empty() {\n122\t                                    continue;\n123\t                                }\n124\t                                match serde_json::from_str::<AgentFrame>(&line) {\n125\t                                    Ok(frame) => {\n126\t                                        // send() blocks when channel is full → backpressure to agent\n127\t                                        if frame_tx.send(frame).is_err() {\n128\t                                            break; // receiver dropped\n129\t                                        }\n130\t                                    }\n131\t                                    Err(e) => {\n132\t                                        log::warn!(\n133\t                                            \"agent: invalid frame: {}  line={}\",\n134\t                                            e, line\n135\t                                        );\n136\t                                    }\n137\t                                }\n138\t                            }\n139\t                            Err(e) => {\n140\t                                log::error!(\"agent: stdout read error: {}\", e);\n141\t                                break;\n142\t                            }\n143\t                        }\n144\t                    }\n145\t                })\n146\t                .ok();\n147\t\n148\t            (Some(child), stdin, handle)\n149\t        } else {\n150\t            // Stub mode: no agent binary, connection returns no frames\n151\t            (None, None, None)\n152\t        };\n153\t\n154\t        Ok(Self {\n155\t            child,\n156\t            stdin,\n157\t            frame_rx,\n158\t            config,\n159\t            reader_handle,\n160\t            exec_pending: 0,\n161\t            exec_started_at: None,\n162\t            health: AgentHealth::default(),\n163\t        })\n164\t    }\n165\t\n166\t    /// Send a frame to the Agent subprocess.\n167\t    pub fn send_frame(&mut self, frame: TuiFrame) {\n168\t        if let Some(ref mut stdin) = self.stdin {\n169\t            let mut line = serde_json::to_string(&frame)\n170\t                .unwrap_or_else(|_| r#\"{\"t\":\"error\",\"message\":\"serialize failed\"}\"#.into());\n171\t            line.push('\\n');\n172\t            if let Err(e) = stdin.write_all(line.as_bytes()) {\n173\t                log::warn!(\"agent: stdin write error: {}\", e);\n174\t            }\n175\t            if let Err(e) = stdin.flush() {\n176\t                log::warn!(\"agent: stdin flush error: {}\", e);\n177\t            }\n178\t        }\n179\t    }\n180\t\n181\t    /// Non-blocking: returns the next available Agent frame, if any.\n182\t    pub fn try_recv(&self) -> Option<AgentFrame> {\n183\t        self.frame_rx.try_recv().ok()\n184\t    }\n185\t\n186\t    /// Drain all available frames (non-blocking).\n187\t    pub fn drain_frames(&self) -> Vec<AgentFrame> {\n188\t        let mut frames = Vec::new();\n189\t        while let Ok(frame) = self.frame_rx.try_recv() {\n190\t            frames.push(frame);\n191\t        }\n192\t        frames\n193\t    }\n194\t\n195\t    /// Read-only access to config.\n196\t    pub fn config(&self) -> &Config {\n197\t        &self.config\n198\t    }\n199\t\n200\t    /// Mutable config access (for slash commands that modify settings).\n201\t    pub fn config_mut(&mut self) -> &mut Config {\n202\t        &mut self.config\n203\t    }\n204\t\n205\t    /// Forward config updates to the Agent subprocess.\n206\t    /// Currently a no-op — agent reads config directly.\n207\t    pub fn send_config_update(&mut self) {\n208\t    }\n209\t\n210\t    /// Shutdown the Agent subprocess gracefully.\n211\t    pub fn shutdown(&mut self) {\n212\t        self.send_frame(TuiFrame::Shutdown);\n213\t        if let Some(mut child) = self.child.take() {\n214\t            let _ = child.wait();\n215\t        }\n216\t    }\n217\t}\n218\t\n219\timpl Drop for AgentConnection {\n220\t    fn drop(&mut self) {\n221\t        self.send_frame(TuiFrame::Shutdown);\n222\t        if let Some(mut child) = self.child.take() {\n223\t            let _ = child.wait();\n224\t        }\n225\t    }\n226\t}\n227\t\n228\t// ─── StreamBuffer ───────────────────────────────────────────────────────\n229\t\n230\t/// Accumulates streaming content from the Agent.\n231\t///\n232\t/// Owned by the event loop; provides the source of truth for all\n233\t/// in-progress streaming output displayed by the render layer.\n234\tpub(crate) struct StreamBuffer {\n235\t    pub content: String,\n236\t    pub reasoning: String,\n237\t    pub tool_progress: Vec<(String, String)>,\n238\t    pub cancelled: bool,\n239\t    pub last_activity: Instant,\n240\t    /// Accumulated reasoning insights extracted during streaming\n241\t    pub reasoning_insights: Vec<String>,\n242\t}\n243\t\n244\timpl StreamBuffer {\n245\t    pub fn new() -> Self {\n246\t        Self {\n247\t            content: String::new(),\n248\t            reasoning: String::new(),\n249\t            tool_progress: Vec::new(),\n250\t            cancelled: false,\n251\t            last_activity: Instant::now(),\n252\t            reasoning_insights: Vec::new(),\n253\t        }\n254\t    }\n255\t\n256\t    /// Reset all streaming state for a new response.\n257\t    pub fn clear(&mut self) {\n258\t        self.content.clear();\n259\t        self.reasoning.clear();\n260\t        self.tool_progress.clear();\n261\t        self.cancelled = false;\n262\t        self.last_activity = Instant::now();\n263\t    }\n264\t\n265\t    /// Apply an Agent StreamPayload frame to the buffer.\n266\t    pub fn apply_payload(\n267\t        &mut self,\n268\t        delta: &str,\n269\t        reasoning: Option<&str>,\n270\t        progress: &[(String, String)],\n271\t    ) {\n272\t        self.content.push_str(delta);\n273\t        if let Some(r) = reasoning {\n274\t            self.reasoning.push_str(r);\n275\t        }\n276\t        self.tool_progress = progress.to_vec();\n277\t        self.last_activity = Instant::now();\n278\t    }\n279\t\n280\t    /// True if there is any content to display.\n281\t    pub fn is_active(&self) -> bool {\n282\t        !self.content.is_empty() || !self.reasoning.is_empty()\n283\t    }\n284\t\n285\t    /// Build a snapshot Message from accumulated stream content.\n286\t    pub fn to_message(&self) -> Message {\n287\t        let mut msg = Message::assistant_empty();\n288\t        if !self.content.is_empty() {\n289\t            msg.content = Some(self.content.clone());\n290\t        }\n291\t        if !self.reasoning.is_empty() {\n292\t            msg.reasoning_content = Some(self.reasoning.clone());\n293\t        }\n294\t        msg\n295\t    }\n296\t}\n297\t\n298\t// ─── AppState ───────────────────────────────────────────────────────────\n299\t\n300\t/// Pure UI state for the TUI — no agent/orchestrator/tool/health/memory domains.\n301\t///\n302\t/// All ~25 fields are directly related to rendering and user interaction.\n303\t/// Orchestration state lives in AgentConnection, streaming in StreamBuffer.\n304\tpub(crate) struct AppState {\n305\t    // ── Embedded input state (E02) ──\n306\t    pub input_state: InputState,\n307\t\n308\t    // ── Full TUI mode (includes Streaming, ApiConfig) ──\n309\t    pub mode: Mode,\n310\t\n311\t    // ── Message display ──\n312\t    /// Flat message snapshot synced from Agent via StreamDone\n313\t    pub messages: Vec<Message>,\n314\t    pub scroll_offset: usize,\n315\t    pub auto_scroll: bool,\n316\t    pub last_max_scroll: usize,\n317\t\n318\t    // ── Status bar ──\n319\t    pub status_msg: String,\n320\t    pub balance: Option<String>,\n321\t    pub token_estimate: u32,\n322\t    pub api_usage: Option<UsageInfo>,\n323\t\n324\t    // ── Tool code panel (bottom panel) ──\n325\t    pub tool_code_path: String,\n326\t    pub tool_code_content: String,\n327\t    pub tool_code_action: String,\n328\t    pub tool_code_status: Option<&'static str>,\n329\t    pub exec_scroll_offset: usize,\n330\t\n331\t    // ── Session ──\n332\t    pub session_seed: String,\n333\t    pub session_pick_idx: usize,\n334\t\n335\t    // ── Toggle flags ──\n336\t    pub tools_enabled: bool,\n337\t    pub auto_mode: bool,\n338\t    pub dev_mode: bool,\n339\t    pub skip_all: bool,\n340\t\n341\t    // ── Crash recovery ──\n342\t    pub dirty: bool,\n343\t    pub last_snapshot: Instant,\n344\t\n345\t    // ── Tool confirmation state (from Agent, relayed for render) ──\n346\t    pub pending_tools: Vec<(ToolCall, SafetyLevel, String)>,\n347\t    pub sudo_password: String,\n348\t\n349\t    // ── Gate/stream error state (from AgentFrame handlers) ──\n350\t    pub last_gate_block: Option<GateBlocked>,\n351\t    pub last_api_error: Option<ApiError>,\n352\t    pub retry_progress: Option<RetryProgress>,\n353\t    pub rate_limit_info: Option<RateLimitInfo>,\n354\t}\n355\t\n356\timpl AppState {\n357\t    pub fn new(initial_mode: Mode) -> Self {\n358\t        Self {\n359\t            input_state: InputState::default(),\n360\t            mode: initial_mode,\n361\t            messages: Vec::new(),\n362\t            scroll_offset: 0,\n363\t            auto_scroll: true,\n364\t            last_max_scroll: 0,\n365\t            status_msg: String::new(),\n366\t            balance: None,\n367\t            token_estimate: 0,\n368\t            api_usage: None,\n369\t            tool_code_path: String::new(),\n370\t            tool_code_content: String::new(),\n371\t            tool_code_action: String::new(),\n372\t            tool_code_status: None,\n373\t            exec_scroll_offset: 0,\n374\t            session_seed: String::new(),\n375\t            session_pick_idx: 0,\n376\t            tools_enabled: true,\n377\t            auto_mode: false,\n378\t            dev_mode: false,\n379\t            skip_all: false,\n380\t            dirty: false,\n381\t            last_snapshot: Instant::now(),\n382\t            pending_tools: Vec::new(),\n383\t            sudo_password: String::new(),\n384\t            last_gate_block: None,\n385\t            last_api_error: None,\n386\t            retry_progress: None,\n387\t            rate_limit_info: None,\n388\t        }\n389\t    }\n390\t\n391\t    /// Sync the flat message cache (called after StreamDone processing).\n392\t    pub fn set_messages(&mut self, msgs: Vec<Message>) {\n393\t        self.messages = msgs;\n394\t        self.dirty = true;\n395\t    }\n396\t\n397\t    /// Append a user or assistant message to the display cache.\n398\t    pub fn push_message(&mut self, msg: Message) {\n399\t        self.messages.push(msg);\n400\t        self.dirty = true;\n401\t    }\n402\t}\n403\t\n404\t// ─── RenderContext ──────────────────────────────────────────────────────\n405\t\n406\t/// Lightweight snapshot assembled once per render cycle.\n407\t///\n408\t/// Aggregates data from AppState + StreamBuffer + AgentConnection so that\n409\t/// render functions access a single coherent view. AgentConnection is\n410\t/// exposed as `ctx.agent` for agent-domain display data (health, exec, etc.).\n411\tpub(crate) struct RenderContext<'a> {\n412\t    // From AppState\n413\t    pub messages: &'a [Message],\n414\t    pub mode: &'a Mode,\n415\t    pub input_buffer: &'a str,\n416\t    pub input_cursor: usize,\n417\t    pub scroll_offset: usize,\n418\t    pub auto_scroll: bool,\n419\t    pub last_max_scroll: usize,\n420\t    pub status_msg: &'a str,\n421\t    pub balance: Option<&'a str>,\n422\t    pub token_estimate: u32,\n423\t    pub api_usage: Option<&'a UsageInfo>,\n424\t    pub tool_code_path: &'a str,\n425\t    pub tool_code_content: &'a str,\n426\t    pub tool_code_action: &'a str,\n427\t    pub tool_code_status: Option<&'a str>,\n428\t    pub exec_scroll_offset: usize,\n429\t    pub session_seed: &'a str,\n430\t    pub tools_enabled: bool,\n431\t    pub auto_mode: bool,\n432\t    pub dev_mode: bool,\n433\t    pub skip_all: bool,\n434\t    pub exit_prompt: bool,\n435\t\n436\t    // From InputState (sub-structs for render access)\n437\t    pub slash_open: bool,\n438\t    pub slash_items: &'a [(String, String)],\n439\t    pub slash_filter: &'a str,\n440\t    pub slash_idx: usize,\n441\t    pub slash_submenu: Option<&'a super::input::state::SlashSubMenu>,\n442\t    pub session_list: &'a [dsx_types::SessionMeta],\n443\t    pub intent_question: &'a str,\n444\t    pub intent_options: &'a [String],\n445\t\n446\t    // From StreamBuffer\n447\t    pub stream_content: &'a str,\n448\t    pub stream_reasoning: &'a str,\n449\t    pub stream_tool_progress: &'a [(String, String)],\n450\t    pub stream_cancelled: bool,\n451\t\n452\t    // Direct access to AgentConnection for agent-domain render data\n453\t    pub agent: &'a AgentConnection,\n454\t\n455\t    // Agent execution state (from AgentConnection)\n456\t    pub exec_pending: usize,\n457\t    pub exec_started_at: Option<Instant>,\n458\t\n459\t    // Stream buffer metadata (from StreamBuffer)\n460\t    pub last_activity: Instant,\n461\t\n462\t    // Config display fields (convenience copies from agent.config())\n463\t    pub config_model: &'a str,\n464\t    pub config_lang: &'a str,\n465\t    pub config_effort: Option<&'a str>,\n466\t    pub config_context_limit: u32,\n467\t\n468\t    // From AppState (gate/stream error)\n469\t    pub last_gate_block: Option<&'a GateBlocked>,\n470\t    pub last_api_error: Option<&'a ApiError>,\n471\t    pub retry_progress: Option<&'a RetryProgress>,\n472\t    pub rate_limit_info: Option<&'a RateLimitInfo>,\n473\t\n474\t    // Tool confirmation state (from AppState, relayed for render)\n475\t    pub pending_tools: &'a [(ToolCall, SafetyLevel, String)],\n476\t    pub sudo_password: &'a str,\n477\t    pub session_pick_idx: usize,\n478\t}\n479\t\n480\timpl<'a> RenderContext<'a> {\n481\t    pub fn from_parts(\n482\t        app: &'a AppState,\n483\t        buf: &'a StreamBuffer,\n484\t        agent: &'a AgentConnection,\n485\t    ) -> Self {\n486\t        let config = &agent.config;\n487\t        Self {\n488\t            messages: &app.messages,\n489\t            mode: &app.mode,\n490\t            input_buffer: &app.input_state.chat.buffer,\n491\t            input_cursor: app.input_state.chat.cursor,\n492\t            scroll_offset: app.scroll_offset,\n493\t            auto_scroll: app.auto_scroll,\n494\t            last_max_scroll: app.last_max_scroll,\n495\t            status_msg: &app.status_msg,\n496\t            balance: app.balance.as_deref(),\n497\t            token_estimate: app.token_estimate,\n498\t            api_usage: app.api_usage.as_ref(),\n499\t            tool_code_path: &app.tool_code_path,\n500\t            tool_code_content: &app.tool_code_content,\n501\t            tool_code_action: &app.tool_code_action,\n502\t            tool_code_status: app.tool_code_status,\n503\t            exec_scroll_offset: app.exec_scroll_offset,\n504\t            session_seed: &app.session_seed,\n505\t            tools_enabled: app.tools_enabled,\n506\t            auto_mode: app.auto_mode,\n507\t            dev_mode: app.dev_mode,\n508\t            skip_all: app.skip_all,\n509\t            exit_prompt: app.input_state.exit_prompt,\n510\t\n511\t            slash_open: app.input_state.slash.open,\n512\t            slash_items: &app.input_state.slash.items,\n513\t            slash_filter: &app.input_state.slash.filter,\n514\t            slash_idx: app.input_state.slash.idx,\n515\t            slash_submenu: app.input_state.slash.submenu.as_ref(),\n516\t            session_list: &app.input_state.session.list,\n517\t            intent_question: &app.input_state.intent.question,\n518\t            intent_options: &app.input_state.intent.options,\n519\t\n520\t            stream_content: &buf.content,\n521\t            stream_reasoning: &buf.reasoning,\n522\t            stream_tool_progress: &buf.tool_progress,\n523\t            stream_cancelled: buf.cancelled,\n524\t            last_activity: buf.last_activity,\n525\t\n526\t            agent,\n527\t            exec_pending: agent.exec_pending,\n528\t            exec_started_at: agent.exec_started_at,\n529\t\n530\t            config_model: &config.model,\n531\t            config_lang: &config.prompt_lang,\n532\t            config_effort: config.effort.as_deref(),\n533\t            config_context_limit: config.context_limit,\n534\t\n535\t            last_gate_block: app.last_gate_block.as_ref(),\n536\t            last_api_error: app.last_api_error.as_ref(),\n537\t            retry_progress: app.retry_progress.as_ref(),\n538\t            rate_limit_info: app.rate_limit_info.as_ref(),\n539\t\n540\t            pending_tools: &app.pending_tools,\n541\t            sudo_password: &app.sudo_password,\n542\t            session_pick_idx: app.session_pick_idx,\n543\t        }\n544\t    }\n545\t\n546\t    /// TUI i18n text bundle for the current config language.\n547\t    pub fn tt(&self) -> &'static super::tui_text::TuiText {\n548\t        super::tui_text::tui_text(self.config_lang)\n549\t    }\n550\t\n551\t    /// Display-ready token count.\n552\t    pub fn tokens_used(&self) -> u32 {\n553\t        self.api_usage.map(|u| u.total_tokens).unwrap_or(self.token_estimate)\n554\t    }\n555\t\n556\t    /// Context usage ratio (0.0–1.0).\n557\t    pub fn context_pct(&self) -> f64 {\n558\t        dsx_types::context_usage_ratio(self.token_estimate, self.config_context_limit)\n559\t    }\n560\t}\n561\t"}]},"uuid":"dc08412b-cc31-4263-a0cf-3cb30e9041d7","timestamp":"2026-05-15T05:44:03.454Z","toolUseResult":{"type":"text","file":{"filePath":"/home/qaqtamsy/Desktop/dsx/crates/dsx-tui/src/state.rs","content":"//! AppState — pure UI state, no agent/orchestrator/tool domains.\n//!\n//! Three structs:\n//!   - AppState: UI rendering state (~25 pure fields, no ctx/health/memory)\n//!   - StreamBuffer: accumulates streaming deltas from Agent\n//!   - AgentConnection: spawns Agent subprocess, manages JSON-LP IPC\n\nuse std::io::{BufRead, BufReader, Write};\nuse std::process::{Child, Command, Stdio};\nuse std::sync::mpsc as std_mpsc;\nuse std::thread;\nuse std::time::Instant;\n\nuse serde::{Deserialize, Serialize};\n\nuse dsx_types::{Message, UsageInfo, SessionMeta, ToolCall, SafetyLevel};\nuse crate::stubs::config::Config;\nuse super::input::state::InputState;\nuse super::mode::Mode;\n/// Re-use gate/error types from legacy App (they live in app.rs during migration).\nuse super::app::{GateBlocked, ApiError, RetryProgress, RateLimitInfo};\n\n// ─── AgentConnection ────────────────────────────────────────────────────\n\n/// Frames sent from TUI → Agent via stdin (JSON-LP).\n#[derive(Debug, Serialize)]\n#[serde(tag = \"type\")]\npub(crate) enum TuiFrame {\n    #[serde(rename = \"user_input\")]\n    UserInput {\n        text: String,\n    },\n    #[serde(rename = \"shutdown\")]\n    Shutdown,\n}\n\n/// Frames received from Agent → TUI via stdout (JSON-LP).\n#[derive(Debug, Deserialize)]\n#[serde(tag = \"type\")]\npub(crate) enum AgentFrame {\n    #[serde(rename = \"api_response\")]\n    StreamPayload {\n        content: String,\n    },\n    #[serde(rename = \"done\")]\n    StreamDone,\n    #[serde(rename = \"error\")]\n    StreamError {\n        message: String,\n    },\n    #[serde(rename = \"shutdown_ack\")]\n    ShutdownAck,\n}\n\n// ─── AgentConnection ────────────────────────────────────────────────────\n\n/// Manages the lifecycle of the Agent subprocess and JSON-LP IPC.\n///\n/// Spawns the agent binary on construction, writes JSON-LP frames to its\n/// stdin, and reads JSON-LP frames from its stdout via a background reader\n/// thread feeding a std::sync::mpsc channel.\n///\n/// Also tracks lightweight execution state needed by the render layer\n/// (exec_pending, exec_started_at). Heavier agent concerns (health, memory,\n/// turn scoring) live in dsx-agent, not here.\npub(crate) struct AgentConnection {\n    child: Option<Child>,\n    stdin: Option<Box<dyn Write + Send>>,\n    frame_rx: std_mpsc::Receiver<AgentFrame>,\n    config: Config,\n    reader_handle: Option<thread::JoinHandle<()>>,\n\n    // ── Execution state (render-visible) ──\n    pub exec_pending: usize,\n    pub exec_started_at: Option<Instant>,\n\n    // ── Agent health state ──\n    pub health: AgentHealth,\n}\n\n/// Lightweight health summary of the Agent subprocess.\n#[derive(Debug, Default)]\npub(crate) struct AgentHealth {\n    pub has_orphan_tool_uses: bool,\n}\n\nimpl AgentConnection {\n    /// Spawn the Agent subprocess and start the stdout reader thread.\n    ///\n    /// The `agent_bin` path points to the dsx-agent binary. If `None`,\n    /// the connection is stubbed (for development/testing).\n    pub fn spawn(\n        agent_bin: Option<&str>,\n        config: Config,\n    ) -> anyhow::Result<Self> {\n        // Bounded channel prevents memory growth if event loop can't keep up.\n        // SyncSender blocks the reader thread (creating backpressure to the agent)\n        // when the buffer is full — the agent itself will block on stdout writes.\n        let (frame_tx, frame_rx) = std::sync::mpsc::sync_channel(100);\n\n        let (child, stdin, reader_handle) = if let Some(bin) = agent_bin {\n            let mut child = Command::new(bin)\n                .stdin(Stdio::piped())\n                .stdout(Stdio::piped())\n                .stderr(Stdio::inherit())\n                .spawn()?;\n\n            let stdin = child.stdin.take()\n                .map(|s| Box::new(s) as Box<dyn Write + Send>);\n            let stdout = child.stdout.take()\n                .expect(\"failed to capture agent stdout\");\n\n            // Background thread: reads JSON-LP lines from agent stdout\n            let handle = thread::Builder::new()\n                .name(\"agent-reader\".into())\n                .spawn(move || {\n                    let reader = BufReader::new(stdout);\n                    for line in reader.lines() {\n                        match line {\n                            Ok(line) => {\n                                if line.trim().is_empty() {\n                                    continue;\n                                }\n                                match serde_json::from_str::<AgentFrame>(&line) {\n                                    Ok(frame) => {\n                                        // send() blocks when channel is full → backpressure to agent\n                                        if frame_tx.send(frame).is_err() {\n                                            break; // receiver dropped\n                                        }\n                                    }\n                                    Err(e) => {\n                                        log::warn!(\n                                            \"agent: invalid frame: {}  line={}\",\n                                            e, line\n                                        );\n                                    }\n                                }\n                            }\n                            Err(e) => {\n                                log::error!(\"agent: stdout read error: {}\", e);\n                                break;\n                            }\n                        }\n                    }\n                })\n                .ok();\n\n            (Some(child), stdin, handle)\n        } else {\n            // Stub mode: no agent binary, connection returns no frames\n            (None, None, None)\n        };\n\n        Ok(Self {\n            child,\n            stdin,\n            frame_rx,\n            config,\n            reader_handle,\n            exec_pending: 0,\n            exec_started_at: None,\n            health: AgentHealth::default(),\n        })\n    }\n\n    /// Send a frame to the Agent subprocess.\n    pub fn send_frame(&mut self, frame: TuiFrame) {\n        if let Some(ref mut stdin) = self.stdin {\n            let mut line = serde_json::to_string(&frame)\n                .unwrap_or_else(|_| r#\"{\"t\":\"error\",\"message\":\"serialize failed\"}\"#.into());\n            line.push('\\n');\n            if let Err(e) = stdin.write_all(line.as_bytes()) {\n                log::warn!(\"agent: stdin write error: {}\", e);\n            }\n            if let Err(e) = stdin.flush() {\n                log::warn!(\"agent: stdin flush error: {}\", e);\n            }\n        }\n    }\n\n    /// Non-blocking: returns the next available Agent frame, if any.\n    pub fn try_recv(&self) -> Option<AgentFrame> {\n        self.frame_rx.try_recv().ok()\n    }\n\n    /// Drain all available frames (non-blocking).\n    pub fn drain_frames(&self) -> Vec<AgentFrame> {\n        let mut frames = Vec::new();\n        while let Ok(frame) = self.frame_rx.try_recv() {\n            frames.push(frame);\n        }\n        frames\n    }\n\n    /// Read-only access to config.\n    pub fn config(&self) -> &Config {\n        &self.config\n    }\n\n    /// Mutable config access (for slash commands that modify settings).\n    pub fn config_mut(&mut self) -> &mut Config {\n        &mut self.config\n    }\n\n    /// Forward config updates to the Agent subprocess.\n    /// Currently a no-op — agent reads config directly.\n    pub fn send_config_update(&mut self) {\n    }\n\n    /// Shutdown the Agent subprocess gracefully.\n    pub fn shutdown(&mut self) {\n        self.send_frame(TuiFrame::Shutdown);\n        if let Some(mut child) = self.child.take() {\n            let _ = child.wait();\n        }\n    }\n}\n\nimpl Drop for AgentConnection {\n    fn drop(&mut self) {\n        self.send_frame(TuiFrame::Shutdown);\n        if let Some(mut child) = self.child.take() {\n            let _ = child.wait();\n        }\n    }\n}\n\n// ─── StreamBuffer ───────────────────────────────────────────────────────\n\n/// Accumulates streaming content from the Agent.\n///\n/// Owned by the event loop; provides the source of truth for all\n/// in-progress streaming output displayed by the render layer.\npub(crate) struct StreamBuffer {\n    pub content: String,\n    pub reasoning: String,\n    pub tool_progress: Vec<(String, String)>,\n    pub cancelled: bool,\n    pub last_activity: Instant,\n    /// Accumulated reasoning insights extracted during streaming\n    pub reasoning_insights: Vec<String>,\n}\n\nimpl StreamBuffer {\n    pub fn new() -> Self {\n        Self {\n            content: String::new(),\n            reasoning: String::new(),\n            tool_progress: Vec::new(),\n            cancelled: false,\n            last_activity: Instant::now(),\n            reasoning_insights: Vec::new(),\n        }\n    }\n\n    /// Reset all streaming state for a new response.\n    pub fn clear(&mut self) {\n        self.content.clear();\n        self.reasoning.clear();\n        self.tool_progress.clear();\n        self.cancelled = false;\n        self.last_activity = Instant::now();\n    }\n\n    /// Apply an Agent StreamPayload frame to the buffer.\n    pub fn apply_payload(\n        &mut self,\n        delta: &str,\n        reasoning: Option<&str>,\n        progress: &[(String, String)],\n    ) {\n        self.content.push_str(delta);\n        if let Some(r) = reasoning {\n            self.reasoning.push_str(r);\n        }\n        self.tool_progress = progress.to_vec();\n        self.last_activity = Instant::now();\n    }\n\n    /// True if there is any content to display.\n    pub fn is_active(&self) -> bool {\n        !self.content.is_empty() || !self.reasoning.is_empty()\n    }\n\n    /// Build a snapshot Message from accumulated stream content.\n    pub fn to_message(&self) -> Message {\n        let mut msg = Message::assistant_empty();\n        if !self.content.is_empty() {\n            msg.content = Some(self.content.clone());\n        }\n        if !self.reasoning.is_empty() {\n            msg.reasoning_content = Some(self.reasoning.clone());\n        }\n        msg\n    }\n}\n\n// ─── AppState ───────────────────────────────────────────────────────────\n\n/// Pure UI state for the TUI — no agent/orchestrator/tool/health/memory domains.\n///\n/// All ~25 fields are directly related to rendering and user interaction.\n/// Orchestration state lives in AgentConnection, streaming in StreamBuffer.\npub(crate) struct AppState {\n    // ── Embedded input state (E02) ──\n    pub input_state: InputState,\n\n    // ── Full TUI mode (includes Streaming, ApiConfig) ──\n    pub mode: Mode,\n\n    // ── Message display ──\n    /// Flat message snapshot synced from Agent via StreamDone\n    pub messages: Vec<Message>,\n    pub scroll_offset: usize,\n    pub auto_scroll: bool,\n    pub last_max_scroll: usize,\n\n    // ── Status bar ──\n    pub status_msg: String,\n    pub balance: Option<String>,\n    pub token_estimate: u32,\n    pub api_usage: Option<UsageInfo>,\n\n    // ── Tool code panel (bottom panel) ──\n    pub tool_code_path: String,\n    pub tool_code_content: String,\n    pub tool_code_action: String,\n    pub tool_code_status: Option<&'static str>,\n    pub exec_scroll_offset: usize,\n\n    // ── Session ──\n    pub session_seed: String,\n    pub session_pick_idx: usize,\n\n    // ── Toggle flags ──\n    pub tools_enabled: bool,\n    pub auto_mode: bool,\n    pub dev_mode: bool,\n    pub skip_all: bool,\n\n    // ── Crash recovery ──\n    pub dirty: bool,\n    pub last_snapshot: Instant,\n\n    // ── Tool confirmation state (from Agent, relayed for render) ──\n    pub pending_tools: Vec<(ToolCall, SafetyLevel, String)>,\n    pub sudo_password: String,\n\n    // ── Gate/stream error state (from AgentFrame handlers) ──\n    pub last_gate_block: Option<GateBlocked>,\n    pub last_api_error: Option<ApiError>,\n    pub retry_progress: Option<RetryProgress>,\n    pub rate_limit_info: Option<RateLimitInfo>,\n}\n\nimpl AppState {\n    pub fn new(initial_mode: Mode) -> Self {\n        Self {\n            input_state: InputState::default(),\n            mode: initial_mode,\n            messages: Vec::new(),\n            scroll_offset: 0,\n            auto_scroll: true,\n            last_max_scroll: 0,\n            status_msg: String::new(),\n            balance: None,\n            token_estimate: 0,\n            api_usage: None,\n            tool_code_path: String::new(),\n            tool_code_content: String::new(),\n            tool_code_action: String::new(),\n            tool_code_status: None,\n            exec_scroll_offset: 0,\n            session_seed: String::new(),\n            session_pick_idx: 0,\n            tools_enabled: true,\n            auto_mode: false,\n            dev_mode: false,\n            skip_all: false,\n            dirty: false,\n            last_snapshot: Instant::now(),\n            pending_tools: Vec::new(),\n            sudo_password: String::new(),\n            last_gate_block: None,\n            last_api_error: None,\n            retry_progress: None,\n            rate_limit_info: None,\n        }\n    }\n\n    /// Sync the flat message cache (called after StreamDone processing).\n    pub fn set_messages(&mut self, msgs: Vec<Message>) {\n        self.messages = msgs;\n        self.dirty = true;\n    }\n\n    /// Append a user or assistant message to the display cache.\n    pub fn push_message(&mut self, msg: Message) {\n        self.messages.push(msg);\n        self.dirty = true;\n    }\n}\n\n// ─── RenderContext ──────────────────────────────────────────────────────\n\n/// Lightweight snapshot assembled once per render cycle.\n///\n/// Aggregates data from AppState + StreamBuffer + AgentConnection so that\n/// render functions access a single coherent view. AgentConnection is\n/// exposed as `ctx.agent` for agent-domain display data (health, exec, etc.).\npub(crate) struct RenderContext<'a> {\n    // From AppState\n    pub messages: &'a [Message],\n    pub mode: &'a Mode,\n    pub input_buffer: &'a str,\n    pub input_cursor: usize,\n    pub scroll_offset: usize,\n    pub auto_scroll: bool,\n    pub last_max_scroll: usize,\n    pub status_msg: &'a str,\n    pub balance: Option<&'a str>,\n    pub token_estimate: u32,\n    pub api_usage: Option<&'a UsageInfo>,\n    pub tool_code_path: &'a str,\n    pub tool_code_content: &'a str,\n    pub tool_code_action: &'a str,\n    pub tool_code_status: Option<&'a str>,\n    pub exec_scroll_offset: usize,\n    pub session_seed: &'a str,\n    pub tools_enabled: bool,\n    pub auto_mode: bool,\n    pub dev_mode: bool,\n    pub skip_all: bool,\n    pub exit_prompt: bool,\n\n    // From InputState (sub-structs for render access)\n    pub slash_open: bool,\n    pub slash_items: &'a [(String, String)],\n    pub slash_filter: &'a str,\n    pub slash_idx: usize,\n    pub slash_submenu: Option<&'a super::input::state::SlashSubMenu>,\n    pub session_list: &'a [dsx_types::SessionMeta],\n    pub intent_question: &'a str,\n    pub intent_options: &'a [String],\n\n    // From StreamBuffer\n    pub stream_content: &'a str,\n    pub stream_reasoning: &'a str,\n    pub stream_tool_progress: &'a [(String, String)],\n    pub stream_cancelled: bool,\n\n    // Direct access to AgentConnection for agent-domain render data\n    pub agent: &'a AgentConnection,\n\n    // Agent execution state (from AgentConnection)\n    pub exec_pending: usize,\n    pub exec_started_at: Option<Instant>,\n\n    // Stream buffer metadata (from StreamBuffer)\n    pub last_activity: Instant,\n\n    // Config display fields (convenience copies from agent.config())\n    pub config_model: &'a str,\n    pub config_lang: &'a str,\n    pub config_effort: Option<&'a str>,\n    pub config_context_limit: u32,\n\n    // From AppState (gate/stream error)\n    pub last_gate_block: Option<&'a GateBlocked>,\n    pub last_api_error: Option<&'a ApiError>,\n    pub retry_progress: Option<&'a RetryProgress>,\n    pub rate_limit_info: Option<&'a RateLimitInfo>,\n\n    // Tool confirmation state (from AppState, relayed for render)\n    pub pending_tools: &'a [(ToolCall, SafetyLevel, String)],\n    pub sudo_password: &'a str,\n    pub session_pick_idx: usize,\n}\n\nimpl<'a> RenderContext<'a> {\n    pub fn from_parts(\n        app: &'a AppState,\n        buf: &'a StreamBuffer,\n        agent: &'a AgentConnection,\n    ) -> Self {\n        let config = &agent.config;\n        Self {\n            messages: &app.messages,\n            mode: &app.mode,\n            input_buffer: &app.input_state.chat.buffer,\n            input_cursor: app.input_state.chat.cursor,\n            scroll_offset: app.scroll_offset,\n            auto_scroll: app.auto_scroll,\n            last_max_scroll: app.last_max_scroll,\n            status_msg: &app.status_msg,\n            balance: app.balance.as_deref(),\n            token_estimate: app.token_estimate,\n            api_usage: app.api_usage.as_ref(),\n            tool_code_path: &app.tool_code_path,\n            tool_code_content: &app.tool_code_content,\n            tool_code_action: &app.tool_code_action,\n            tool_code_status: app.tool_code_status,\n            exec_scroll_offset: app.exec_scroll_offset,\n            session_seed: &app.session_seed,\n            tools_enabled: app.tools_enabled,\n            auto_mode: app.auto_mode,\n            dev_mode: app.dev_mode,\n            skip_all: app.skip_all,\n            exit_prompt: app.input_state.exit_prompt,\n\n            slash_open: app.input_state.slash.open,\n            slash_items: &app.input_state.slash.items,\n            slash_filter: &app.input_state.slash.filter,\n            slash_idx: app.input_state.slash.idx,\n            slash_submenu: app.input_state.slash.submenu.as_ref(),\n            session_list: &app.input_state.session.list,\n            intent_question: &app.input_state.intent.question,\n            intent_options: &app.input_state.intent.options,\n\n            stream_content: &buf.content,\n            stream_reasoning: &buf.reasoning,\n            stream_tool_progress: &buf.tool_progress,\n            stream_cancelled: buf.cancelled,\n            last_activity: buf.last_activity,\n\n            agent,\n            exec_pending: agent.exec_pending,\n            exec_started_at: agent.exec_started_at,\n\n            config_model: &config.model,\n            config_lang: &config.prompt_lang,\n            config_effort: config.effort.as_deref(),\n            config_context_limit: config.context_limit,\n\n            last_gate_block: app.last_gate_block.as_ref(),\n            last_api_error: app.last_api_error.as_ref(),\n            retry_progress: app.retry_progress.as_ref(),\n            rate_limit_info: app.rate_limit_info.as_ref(),\n\n            pending_tools: &app.pending_tools,\n            sudo_password: &app.sudo_password,\n            session_pick_idx: app.session_pick_idx,\n        }\n    }\n\n    /// TUI i18n text bundle for the current config language.\n    pub fn tt(&self) -> &'static super::tui_text::TuiText {\n        super::tui_text::tui_text(self.config_lang)\n    }\n\n    /// Display-ready token count.\n    pub fn tokens_used(&self) -> u32 {\n        self.api_usage.map(|u| u.total_tokens).unwrap_or(self.token_estimate)\n    }\n\n    /// Context usage ratio (0.0–1.0).\n    pub fn context_pct(&self) -> f64 {\n        dsx_types::context_usage_ratio(self.token_estimate, self.config_context_limit)\n    }\n}\n","numLines":561,"startLine":1,"totalLines":561}},"sourceToolAssistantUUID":"f3ca1c2a-d532-4f2e-a7bd-16d8a67e6297","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
