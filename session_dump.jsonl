{"parentUuid":"4c2ad747-ee2b-4c3e-9bda-63d5acdf5740","isSidechain":false,"teamName":"dsx","attachment":{"type":"edited_text_file","filename":"/home/qaqtamsy/Desktop/dsx/crates/dsx-tools/src/stubs.rs","snippet":"1\t//! Phase 4 migration stubs for dsx-tools.\n2\t//! Types/functions from other crates that will be provided via IPC.\n3\t\n4\tuse dsx_types::{AgentPhase, DebugLevel, TaskPhase};\n5\tuse std::path::PathBuf;\n6\t\n7\t// ── StreamEvent stub (was in old api module) ──\n8\t// Phase 4: Tools returns ToolResult via IPC, not StreamEvent.\n9\t\n10\t#[derive(Debug, Clone)]\n11\tpub enum StreamEvent {\n12\t    ExecDone(String, String),\n13\t    ExecProgress(String),\n...\n21\t    Flow, Calm, Anxious, Frustrated, Confused, Panic,\n22\t}\n23\t\n24\t// ── ErrorKind stub (was in health module) ──\n25\t\n26\t#[derive(Debug, Clone)]\n27\tpub enum ErrorKind {\n28\t    ToolParameter, FileAccess, ExecFailure, NetworkFailure, ApiError,\n29\t    SudoFailure, Panic, SessionMissing, ToolNotFound,\n30\t    Unknown, Permission, Config, Io, Timeout,\n31\t}\n32\t\n33\t// ── RouterCommand stub (was in dsx-types/state) ──\n34\t\n35\t#[derive(Debug, Clone)]\n36\tpub enum RouterCommand {\n37\t    SetPhase { phase: TaskPhase, level: DebugLevel },\n38\t}\n39\t\n40\t// ── Session seed holder (was CURRENT_SESSION OnceLock) ──\n41\t\n42\tuse std::sync::OnceLock;\n43\tpub static CURRENT_SESSION: OnceLock<String> = OnceLock::new();\n44\t\n45\t// ── PhaseConfig stub (was in dsx-agent::router) ──\n46\t\n47\t#[derive(Debug, Clone)]\n48\tpub struct PhaseConfig {\n49\t    pub model: &'static str,\n50\t    pub effort: Option<&'static str>,\n51\t    pub max_tokens: u32,\n52\t}\n53\t\n54\t// ── Router stubs ──\n55\t\n56\tpub fn parse_status_args(_args: &str) -> (TaskPhase, DebugLevel) {\n57\t    (TaskPhase::Coding, DebugLevel::Medium)\n58\t}\n59\t\n60\tpub fn set_phase(_phase: TaskPhase, _level: DebugLevel) {}\n61\t\n62\tpub fn phase_config(phase: TaskPhase, level: DebugLevel) -> PhaseConfig {\n63\t    // Simplified config matching dsx-agent::router logic\n64\t    let (model, max_tokens) = match phase {\n65\t        TaskPhase::Explore => (\"deepseek-v4-flash\", 64_000u32),\n66\t        TaskPhase::Plan => (\"deepseek-v4-pro\", 300_000),\n67\t        TaskPhase::Coding => (\"deepseek-v4-flash\", 96_000),\n68\t        TaskPhase::Debug => (\"deepseek-v4-pro\", match level {\n69\t            DebugLevel::High => 128_000,\n70\t            _ => 96_000,\n71\t        }),\n72\t        TaskPhase::Chat => (\"deepseek-v4-flash\", 96_000),\n73\t    };\n74\t    PhaseConfig { model, effort: Some(\"high\"), max_tokens }\n75\t}\n76\t\n77\t// ── PitfallEntry stub (was in dsx-agent::memory) ──\n78\t\n79\t#[derive(Debug, Clone)]\n80\tpub struct PitfallEntry {\n81\t    pub emotion: String,\n82\t    pub error_kind: String,\n83\t    pub tool: String,\n84\t    pub description: String,\n85\t    pub lesson: String,\n86\t    pub files: Vec<String>,\n87\t    pub frequency: u32,\n88\t    pub first_seen: u64,\n89\t    pub last_seen: u64,\n90\t}\n91\t\n92\t#[derive(Debug, Clone)]\n93\tpub struct PitfallGuide {\n94\t    pub entries: Vec<PitfallEntry>,\n95\t}\n96\t\n97\timpl PitfallGuide {\n98\t    pub fn upsert(&mut self, _emotion: AgentEmotion, _kind: ErrorKind, _tool: &str,\n99\t                  _description: &str, _lesson: &str, _files: &[String]) {\n100\t        self.entries.push(PitfallEntry {\n101\t            emotion: format!(\"{:?}\", _emotion),\n102\t            error_kind: format!(\"{:?}\", _kind),\n103\t            tool: _tool.to_string(),\n104\t            description: _description.to_string(),\n105\t            lesson: _lesson.to_string(),\n106\t            files: _files.to_vec(),\n107\t            frequency: 1,\n108\t            first_seen: 0,\n109\t            last_seen: 0,\n110\t        });\n111\t    }\n112\t}\n113\t\n114\timpl Default for PitfallGuide {\n115\t    fn default() -> Self {\n116\t        Self { entries: Vec::new() }\n117\t    }\n118\t}\n119\t\n120\t// ── Session I/O stubs (was in dsx-agent::session) ──\n121\t\n122\tpub fn read_memory(_seed: &str, _tier: &str) -> String {\n123\t    String::new()\n124\t}\n125\t\n126\tpub fn write_memory(_seed: &str, _tier: &str, _content: &str) {}\n127\t\n128\tpub fn append_memory(_seed: &str, _tier: &str, _line: &str) {}\n129\t\n130\tpub fn forget_memory_key(_seed: &str, _key: &str) {}\n131\t\n132\tpub fn load_pitfalls() -> PitfallGuide {\n133\t    PitfallGuide::default()\n134\t}\n135\t\n136\tpub fn save_pitfalls(_guide: &PitfallGuide) {}\n137\t\n138\tpub fn write_plan(_seed: &str, _name: &str, _goal: &str) -> Option<PathBuf> {\n139\t    None\n140\t}\n141\t\n142\tpub fn update_plan_status(_seed: &str, _name: &str, _new_status: &str) -> Option<String> {\n143\t    None\n144\t}\n145\t\n146\tpub fn read_plan_content(_seed: &str, _name: &str) -> Option<String> {\n147\t    None\n148\t}\n149\t\n150\tpub fn list_plans(_seed: &str) -> Vec<(String, String, PathBuf)> {\n151\t    Vec::new()\n152\t}"},"type":"attachment","uuid":"3a3086fe-cadc-40ba-a884-c37df5aa6346","timestamp":"2026-05-14T17:04:25.907Z","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.141","gitBranch":"master","slug":"gentle-orbiting-karp"}
{"parentUuid":"3a3086fe-cadc-40ba-a884-c37df5aa6346","isSidechain":false,"teamName":"dsx","attachment":{"type":"edited_text_file","filename":"/home/qaqtamsy/Desktop/dsx/crates/dsx-tools/src/lib.rs","snippet":"1\t//! ToolManager IPC 服务框架。\n2\t//!\n3\t//! 提供两大组件：\n4\t//! 1. **ToolManager** — 工具注册 + 安全分类 + 请求路由\n5\t//! 2. **向后兼容** — 保留 `execute_tool()` 垫片供 TUI 渐进迁移\n6\t//!\n7\t//! 子模块通过 `pub fn register(mgr: &mut ToolManager)` 注册各自 handler。\n8\t\n9\tpub mod exec;\n10\tpub use exec::{exec_command, exec_with_sudo, spawn_exec_async, spawn_exec_async_with_sudo, spawn_exec_pty};\n11\tpub mod explore;\n12\tpub mod file;\n13\tmod git;\n14\tmod safety;\n15\tmod web;\n16\t\n17\t// D02 module — depends on crate::session/crate::skills, enabled in monolith build\n18\tpub mod meta;\n19\t\n20\t// D03 modules — tool handlers for ask, memory, plan, status, task\n21\tpub mod ask;\n22\tpub mod memory;\n23\tpub mod plan;\n24\tpub mod status;\n25\tpub mod task;\n26\t\n27\tpub mod ipc;\n28\tpub mod registration;\n29\tpub mod stubs;\n30\t\n31\tuse std::collections::HashMap;\n32\tuse std::sync::atomic::AtomicBool;\n33\tuse std::sync::{Arc, OnceLock};\n34\tuse std::time::Duration;\n35\t\n36\tuse dsx_types::{SafetyLevel, TaskPhase, ToolDef, AnthropicTool};\n37\t\n38\tpub use safety::SafetyVerdict;\n39\t\n40\t// ── 全局状态 ──\n41\t\n42\t/// 全局取消标志 — TUI 按 Esc 时设置，长工具在循环中检查。\n43\tpub static CANCEL: AtomicBool = AtomicBool::new(false);\n44\t\n45\t/// 当前会话 seed — 由 TUI 启动时设置，memory 工具使用。\n46\tpub static CURRENT_SESSION: OnceLock<String> = OnceLock::new();\n47\tpub static AUTO_MODE: AtomicBool = AtomicBool::new(false);\n48\t\n49\tpub fn set_current_session(seed: &str) {\n50\t    let _ = CURRENT_SESSION.set(seed.to_string());\n51\t}\n52\t\n53\t// ── 工具键（名称 + 二级操作）──\n54\t\n55\t#[derive(Clone, Debug, PartialEq, Eq, Hash)]\n56\tpub struct ToolKey {\n57\t    pub name: String,\n58\t    pub action: String,\n59\t}\n60\t\n61\timpl ToolKey {\n62\t    pub fn new(name: impl Into<String>, action: impl Into<String>) -> Self {\n63\t        Self { name: name.into(), action: action.into() }\n64\t    }\n65\t}\n66\t\n67\timpl std::fmt::Display for ToolKey {\n68\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n69\t        write!(f, \"{}/{}\", self.name, self.action)\n70\t    }\n71\t}\n72\t\n73\t// ── handler 上下文与返回值 ──\n74\t\n75\t/// handler 执行上下文：包含请求参数和进度通道。\n76\tpub struct ToolCallCtx {\n77\t    pub id: String,\n78\t    pub name: String,\n79\t    pub action: String,\n80\t    pub args: serde_json::Value,\n81\t    /// 可选进度发送通道 — handler 可在执行期间推送进度帧。\n82\t    pub tx_progress: Option<std::sync::mpsc::Sender<String>>,\n83\t}\n84\t\n85\timpl ToolCallCtx {\n86\t    /// 从旧式 name+args 构建（兼容垫片使用）。\n87\t    pub fn from_str(name: &str, action: &str, args: &str) -> Self {\n88\t        let v: serde_json::Value = serde_json::from_str(args).unwrap_or(serde_json::Value::Null);\n89\t        let args = if v.is_null() {\n90\t            // 尝试解析为旧式 JSON 参数\n91\t            serde_json::from_str(args).unwrap_or(serde_json::json!({}))\n92\t        } else {\n93\t            v\n94\t        };\n95\t        Self {\n96\t            id: String::new(),\n97\t            name: name.to_string(),\n98\t            action: action.to_string(),\n99\t            args,\n100\t            tx_progress: None,\n101\t        }\n102\t    }\n103\t\n104\t    /// 便捷方法：读取命名参数。\n105\t    pub fn get_str(&self, key: &str) -> Option<&str> {\n106\t        self.args.get(key).and_then(|v| v.as_str())\n107\t    }\n108\t\n109\t    pub fn get_u64(&self, key: &str) -> Option<u64> {\n110\t        self.args.get(key).and_then(|v| v.as_u64())\n111\t    }\n112\t\n113\t    pub fn get_bool(&self, key: &str) -> Option<bool> {\n114\t        self.args.get(key).and_then(|v| v.as_bool())\n115\t    }\n116\t}\n117\t\n118\t/// handler 返回值。\n119\t#[derive(Clone, Debug)]\n120\tpub struct ToolResult {\n121\t    pub success: bool,\n122\t    pub content: String,\n123\t}\n124\t\n125\timpl ToolResult {\n126\t    pub fn ok(content: impl Into<String>) -> Self {\n127\t        Self { success: true, content: content.into() }\n128\t    }\n129\t\n130\t    pub fn err(content: impl Into<String>) -> Self {\n131\t        Self { success: false, content: content.into() }\n132\t    }\n133\t}\n134\t\n135\t// ── 参数解析工具（供子模块共享）──\n136\t\n137\t/// Parse a string parameter from JSON args (legacy compat).\n138\tpub fn parse_arg(args: &str, key: &str) -> String {\n139\t    serde_json::from_str::<serde_json::Value>(args)\n140\t        .ok()\n141\t        .and_then(|v| v.get(key).and_then(|v| v.as_str()).map(String::from))\n142\t        .unwrap_or_default()\n143\t}\n144\t\n145\tpub fn parse_arg_or(args: &str, key: &str, default: &str) -> String {\n146\t    serde_json::from_str::<serde_json::Value>(args)\n147\t        .ok()\n148\t        .and_then(|v| v.get(key).and_then(|v| v.as_str()).map(String::from))\n149\t        .unwrap_or_else(|| default.to_string())\n150\t}\n151\t\n152\tpub fn parse_opt(args: &str, key: &str) -> Option<String> {\n153\t    serde_json::from_str::<serde_json::Value>(args)\n154\t        .ok()\n155\t        .and_then(|v| v.get(key).and_then(|v| v.as_str()).map(String::from))\n156\t}\n157\t\n158\tpub fn parse_opt_bool(args: &str, key: &str) -> Option<bool> {\n159\t    let v: serde_json::Value = serde_json::from_str(args).ok()?;\n160\t    let val = v.get(key)?;\n161\t    val.as_bool().or_else(|| val.as_str().and_then(|s| s.parse::<bool>().ok()))\n162\t}\n163\t\n164\t// ── 工具句柄 ──\n165\t\n166\t/// 一个工具操作（name/action）的完整定义。\n167\tpub struct ToolHandler {\n168\t    pub key: ToolKey,\n169\t    pub description: &'static str,\n170\t    pub input_schema: serde_json::Value,\n171\t    pub handler: fn(ToolCallCtx) -> ToolResult,\n172\t    pub safety: fn(&ToolCallCtx) -> SafetyVerdict,\n173\t    pub default_timeout: Duration,\n174\t}\n175\t\n176\timpl ToolHandler {\n177\t    pub fn to_tool_def(&self) -> ToolDef {\n178\t        ToolDef {\n179\t            call_type: \"function\".into(),\n180\t            function: dsx_types::ToolFunction {\n181\t                name: self.key.name.to_string(),\n182\t                description: self.description.to_string(),\n183\t                parameters: self.input_schema.clone(),\n184\t            },\n185\t        }\n186\t    }\n187\t}\n188\t\n189\t// ── ToolManager ──\n190\t\n191\tpub struct ToolManager {\n192\t    handlers: HashMap<ToolKey, ToolHandler>,\n193\t    /// 若 Some，仅允许列表中 name 的工具通过。\n194\t    allowed: Option<Vec<String>>,\n195\t    /// inflight 任务的取消标志（id → should_cancel）。\n196\t    inflight_tasks: HashMap<String, Arc<AtomicBool>>,\n197\t}\n198\t\n199\timpl ToolManager {\n200\t    pub fn new() -> Self {\n201\t        Self {\n202\t            handlers: HashMap::new(),\n203\t            allowed: None,\n204\t            inflight_tasks: HashMap::new(),\n205\t        }\n206\t    }\n207\t\n208\t    // ── 注册 ──\n209\t\n210\t    pub fn register(&mut self, handler: ToolHandler) {\n211\t        self.handlers.insert(handler.key.clone(), handler);\n212\t    }\n213\t\n214\t    // ── Init（IPC 中由 ToolsInit 帧触发）──\n215\t\n216\t    pub fn apply_init(&mut self, allowed_tools: Vec<String>, session_seed: &str, auto_mode: bool) {\n217\t        self.allowed = Some(allowed_tools);\n218\t        let _ = CURRENT_SESSION.set(session_seed.to_string());\n219\t        AUTO_MODE.store(auto_mode, std::sync::atomic::Ordering::Relaxed);\n220\t    }\n221\t\n222\t    // ── 定义查询 ──\n223\t\n224\t    pub fn all_defs(&self) -> Vec<ToolDef> {\n225\t        // 按 name 分组，每个 name 只暴露第一个 action 的定义（保持兼容）\n226\t        let mut seen = std::collections::HashSet::new();\n227\t        let mut defs = Vec::new();\n228\t        // 按工具名固定顺序排列\n229\t        for name in &[\"explore\", \"exec\", \"read_file\", \"write_file\", \"edit_file\", \"edit_file_diff\", \"list_dir\", \"search\", \"list_skills\", \"read_skill_ref\", \"glance\", \"web\", \"git\"] {\n230\t            for (key, handler) in &self.handlers {\n231\t                if key.name == *name && seen.insert(key.name.clone()) {\n232\t                    defs.push(handler.to_tool_def());\n233\t                }\n234\t            }\n235\t        }\n236\t        // 未在排序列表中的工具\n237\t        for (key, handler) in &self.handlers {\n238\t            if seen.insert(key.name.clone()) {\n239\t                defs.push(handler.to_tool_def());\n240\t            }\n241\t        }\n242\t        defs\n243\t    }\n244\t\n245\t    pub fn all_anthropic_defs(&self) -> Vec<AnthropicTool> {\n246\t        // 先用 Vec<(usize, AnthropicTool)> 收集，保持原始注册顺序\n247\t        let mut tools: Vec<AnthropicTool> = Vec::new();\n248\t        for def in self.all_defs() {\n249\t            tools.push(AnthropicTool {\n250\t                name: def.function.name,\n251\t                description: def.function.description,\n252\t                input_schema: def.function.parameters,\n253\t            });\n254\t        }\n255\t        tools\n256\t    }\n257\t\n\n... [281 lines truncated] ..."},"type":"attachment","uuid":"21c5a847-8078-4198-aa87-3971cf4c3d6e","timestamp":"2026-05-14T17:04:25.907Z","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.141","gitBranch":"master","slug":"gentle-orbiting-karp"}
