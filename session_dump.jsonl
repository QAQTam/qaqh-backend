\"type\":\"list_sessions\"}\"#);\n        while let Some(resp) = read_line(&mut agent_reader) {\n            println!(\"{resp}\");\n            if resp.contains(\"done\") { break; }\n        }\n    } else if cli.list_skills {\n        send(&mut agent_writer, r#\"{\"type\":\"list_skills\"}\"#);\n        while let Some(resp) = read_line(&mut agent_reader) {\n            println!(\"{resp}\");\n            if resp.contains(\"done\") { break; }\n        }\n    } else {\n        // Interactive mode — simple readline loop\n        let stdin = std::io::stdin();\n        let mut input = String::new();\n        println!(\"dsx v{} — type /help for commands, Ctrl+D to exit\",\n                 option_env!(\"CARGO_PKG_VERSION\").unwrap_or(\"4.0.0\"));\n        loop {\n            input.clear();\n            print!(\"> \");\n            let _ = std::io::stdout().flush();\n            match stdin.read_line(&mut input) {\n                Err(_) | Ok(0) => break, // error or EOF\n                Ok(_) => {}\n            }\n            let msg = input.trim();\n            if msg.is_empty() { continue; }\n            if msg == \"/quit\" || msg == \"/exit\" {\n                send(&mut agent_writer, r#\"{\"type\":\"shutdown\"}\"#);\n                while let Some(resp) = read_line(&mut agent_reader) {\n                    if resp.contains(\"\\\"shutdown_ack\\\"\") { break; }\n                }\n                break;\n            }\n            send(&mut agent_writer, &format!(r#\"{{\"type\":\"user_input\",\"text\":\"{}\"}}\"#, msg));\n            while let Some(resp) = read_line(&mut agent_reader) {\n                println!(\"  ← {resp}\");\n                if resp.contains(\"\\\"done\\\"\") || resp.contains(\"\\\"error\\\"\") { break; }\n            }\n        }\n    }\n\n    // Close agent's stdin pipe so agent sees EOF and exits cleanly\n    drop(agent_writer);\n    let _ = child.wait();\n    Ok(())\n}\n","userModified":false},"sourceToolAssistantUUID":"7b6bbb3b-2d13-4777-9fb2-ca6