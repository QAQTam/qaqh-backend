{"parentUuid":"9aa9111e-0de9-47a9-aa51-0729dd198582","isSidechain":false,"message":{"id":"d15bef79-c6f5-412a-82d6-87b53d506dfd","type":"message","role":"assistant","model":"deepseek-v4-flash","content":[{"type":"text","text":"CPU 还是满的——即使有 sleep，如果每次 `draw()` 很重或 `poll()` 行为异常，还是烧 CPU。改成仅状态变更时才渲染。"}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":98,"cache_creation_input_tokens":0,"cache_read_input_tokens":254720,"output_tokens":2939,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"},"stop_details":null},"type":"assistant","uuid":"c54cc574-da50-43eb-896a-ef7f679d8f8b","timestamp":"2026-05-15T04:16:10.983Z","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
{"parentUuid":"c54cc574-da50-43eb-896a-ef7f679d8f8b","isSidechain":false,"message":{"id":"d15bef79-c6f5-412a-82d6-87b53d506dfd","type":"message","role":"assistant","model":"deepseek-v4-flash","content":[{"type":"tool_use","id":"call_00_IfONWTbi0UC9VXorSrXl7259","name":"Edit","input":{"replace_all":false,"file_path":"/home/qaqtamsy/Desktop/dsx/crates/dsx-tui/src/lib.rs","old_string":"/// Main ratatui event loop: poll keyboard → handle input → poll agent → render.\nfn event_loop(\n    terminal: &mut ratatui::Terminal<ratatui::backend::CrosstermBackend<std::io::Stdout>>,\n    conn: &mut AgentConnection,\n    state: &mut AppState,\n    stream: &mut StreamBuffer,\n    commands: &[(String, String)],\n) -> anyhow::Result<()> {\n    use crossterm::event::{Event, KeyCode, KeyModifiers};\n    use crate::input::action::InputAction;\n\n    loop {\n        let frame_start = std::time::Instant::now();\n\n        // ── Poll keyboard ──\n        if crossterm::event::poll(std::time::Duration::from_millis(10))? {\n            match crossterm::event::read()? {\n                Event::Key(key) => {\n                    // Ctrl+C / Ctrl+D to quit\n                    if (key.code == KeyCode::Char('c') || key.code == KeyCode::Char('d'))\n                        && key.modifiers == KeyModifiers::CONTROL\n                    {\n                        return Ok(());\n                    }\n\n                    let action = crate::input::chat::handle_chat_key(\n                        &mut state.input_state,\n                        key,\n                        commands,\n                    );\n                    match action {\n                        InputAction::SendMessage(text) => {\n                            let trimmed = text.trim().to_string();\n                            if !trimmed.is_empty() {\n                                // Local commands\n                                if trimmed == \"/quit\" || trimmed == \"/exit\" {\n                                    return Ok(());\n                                }\n                                // Send to agent\n                                state.push_message(Message::user(&trimmed));\n                                conn.send_frame(TuiFrame::UserInput { text: trimmed });\n                                stream.clear();\n                                state.mode = Mode::Streaming;\n                            }\n                        }\n                        InputAction::ScrollUp(n) => {\n                            state.scroll_offset = state.scroll_offset.saturating_add(n);\n                            state.auto_scroll = false;\n                        }\n                        InputAction::ScrollDown(n) => {\n                            state.scroll_offset = state.scroll_offset.saturating_sub(n);\n                        }\n                        _ => {}\n                    }\n                }\n                Event::Resize(w, h) => {\n                    let _ = (w, h);\n                }\n                _ => {}\n            }\n        }\n\n        // ── Poll agent frames ──\n        for frame in conn.drain_frames() {\n            match frame {\n                AgentFrame::StreamPayload { content } => {\n                    stream.apply_payload(&content, None, &[]);\n                }\n                AgentFrame::StreamDone => {\n                    let msg = stream.to_message();\n                    state.push_message(msg);\n                    stream.clear();\n                    state.mode = Mode::Chat;\n                }\n                AgentFrame::StreamError { message } => {\n                    state.status_msg = message;\n                    stream.clear();\n                    state.mode = Mode::Chat;\n                }\n                AgentFrame::ShutdownAck => {\n                    return Ok(());\n                }\n            }\n        }\n\n        // ── Render ──\n        terminal.draw(|f| {\n            crate::render::render_all(f, state, conn, stream);\n        })?;\n\n        // ── Throttle: ensure at most ~60fps, prevents CPU spin ──\n        let elapsed = frame_start.elapsed();\n        let min_frame = std::time::Duration::from_millis(16);\n        if elapsed < min_frame {\n            std::thread::sleep(min_frame - elapsed);\n        }\n    }\n}","new_string":"/// Main ratatui event loop: poll keyboard → handle input → poll agent → render.\nfn event_loop(\n    terminal: &mut ratatui::Terminal<ratatui::backend::CrosstermBackend<std::io::Stdout>>,\n    conn: &mut AgentConnection,\n    state: &mut AppState,\n    stream: &mut StreamBuffer,\n    commands: &[(String, String)],\n) -> anyhow::Result<()> {\n    use crossterm::event::{Event, KeyCode, KeyModifiers};\n    use crate::input::action::InputAction;\n\n    let mut need_render = true;\n\n    loop {\n        let mut dirty = false;\n\n        // ── Poll keyboard (non-blocking) ──\n        while crossterm::event::poll(std::time::Duration::ZERO)? {\n            match crossterm::event::read()? {\n                Event::Key(key) => {\n                    // Ctrl+C / Ctrl+D to quit\n                    if (key.code == KeyCode::Char('c') || key.code == KeyCode::Char('d'))\n                        && key.modifiers == KeyModifiers::CONTROL\n                    {\n                        return Ok(());\n                    }\n\n                    let action = crate::input::chat::handle_chat_key(\n                        &mut state.input_state,\n                        key,\n                        commands,\n                    );\n                    match action {\n                        InputAction::SendMessage(text) => {\n                            let trimmed = text.trim().to_string();\n                            if !trimmed.is_empty() {\n                                if trimmed == \"/quit\" || trimmed == \"/exit\" {\n                                    return Ok(());\n                                }\n                                state.push_message(Message::user(&trimmed));\n                                conn.send_frame(TuiFrame::UserInput { text: trimmed });\n                                stream.clear();\n                                state.mode = Mode::Streaming;\n                                dirty = true;\n                            }\n                        }\n                        InputAction::ScrollUp(n) => {\n                            state.scroll_offset = state.scroll_offset.saturating_add(n);\n                            state.auto_scroll = false;\n                            dirty = true;\n                        }\n                        InputAction::ScrollDown(n) => {\n                            state.scroll_offset = state.scroll_offset.saturating_sub(n);\n                            dirty = true;\n                        }\n                        _ => dirty = true,\n                    }\n                }\n                Event::Resize(_, _) => dirty = true,\n                _ => {}\n            }\n        }\n\n        // ── Poll agent frames ──\n        for frame in conn.drain_frames() {\n            dirty = true;\n            match frame {\n                AgentFrame::StreamPayload { content } => {\n                    stream.apply_payload(&content, None, &[]);\n                }\n                AgentFrame::StreamDone => {\n                    let msg = stream.to_message();\n                    state.push_message(msg);\n                    stream.clear();\n                    state.mode = Mode::Chat;\n                }\n                AgentFrame::StreamError { message } => {\n                    state.status_msg = message;\n                    stream.clear();\n                    state.mode = Mode::Chat;\n                }\n                AgentFrame::ShutdownAck => {\n                    return Ok(());\n                }\n            }\n        }\n\n        // ── Render (only when something changed, at most ~30fps) ──\n        if dirty || need_render {\n            terminal.draw(|f| {\n                crate::render::render_all(f, state, conn, stream);\n            })?;\n            need_render = false;\n            std::thread::sleep(std::time::Duration::from_millis(33));\n        } else {\n            // Nothing to do — sleep until next keyboard poll cycle\n            std::thread::sleep(std::time::Duration::from_millis(50));\n        }\n    }\n}"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":98,"cache_creation_input_tokens":0,"cache_read_input_tokens":254720,"output_tokens":2939,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"},"stop_details":null},"type":"assistant","uuid":"ea0ba8e1-d584-4385-9546-e46ebec52e20","timestamp":"2026-05-15T04:16:19.343Z","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
