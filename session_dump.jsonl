se std::time::Duration;","-","-use dsx_hp::client;","-use dsx_hp::config::Config;","-use dsx_hp::ipc_traits::HealthProbe;","-use dsx_hp::monitor;","-use dsx_hp::pipeline::judge;","-use dsx_hp::registry::ProcessRegistry;","-use dsx_hp::types::{HpError, ProcessKind, Verdict};","-use dsx_hp::StreamEvent;","-use dsx_types::{AnthropicContent, AnthropicMessage};","-","-static HP_CONFIG: OnceLock<Config> = OnceLock::new();","-","-// ── Health service implementation ──","-","-/// Concrete implementation of the `HealthProbe` trait.","-///","-/// Owns the process registry and delegates pipeline judgment.","-/// Runs synchronously; the IPC layer wraps calls in async tasks.","-struct HealthService {","-    registry: ProcessRegistry,","-}","-","-impl HealthService {","-    fn new(timeout_secs: u64) -> Self {","-        Self {","-            registry: ProcessRegistry::new(timeout_secs),","-        }","-    }","-}","-","-impl HealthProbe for HealthService {","-    fn register(","-        &mut self,","-        kind: ProcessKind,","-        name: &str,","-        pid: u32,","-    ) -> Result<(), HpError> {","-        self.registry.register(kind, name, pid)","-    }","-","-    fn heartbeat(&mut self, pid: u32) -> Result<(), HpError> {","-        self.registry.heartbeat(pid)","-    }","-","-    fn unregister(&mut self, pid: u32) -> Result<(), HpError> {","-        self.registry.unregister(pid)","-    }","-","-    fn judge(&self) -> Vec<Verdict> {","-        // monitor_state is placeholder — in production the Agent","-        // pushes MonitorState updates via IPC frames.","-        let monitor_state = monitor::MonitorState::new();","-        judge(&self.registry, &monitor_state)","-    }","-","-    fn query(&self, pid: u32) -> Result<dsx_hp::types::ProcessHealth, HpError> {","-        self.registry.health(pid)","-    }","-","-    fn list_processes(&self) -> Vec<dsx_hp::types::ProcessSummary> {","-        self.registry.summaries()","-    }","-}","-","-// ── Main ──","-"," fn main() {","-    // 0. Load API config from environment","-    let hp_cfg = Config {","-        base_url: std::env::var(\"ANTHROPIC_BASE_URL\")","-            .unwrap_or_else(|_| \"https://api.deepseek.com\".into()),","-        api_key: std::env::var(\"ANTHROPIC_AUTH_TOKEN\")","-            .unwrap_or_default(),","-    };","-    if hp_cfg.api_key.is_empty() {","-        eprintln!(\"dsx-hp: WARNING — no ANTHROPIC_AUTH_TOKEN set, api_chat will fail\");","-    } else {","-        HP_CONFIG.set(hp_cfg).ok();","-        eprintln!(\"dsx-hp: API proxy configured (base_url={})\", &std::env::var(\"ANTHROPIC_BASE_URL\").unwrap_or_else(|_| \"https://api.deepseek.com\".into()));","-    }","-","-    // 1. CLI defaults","-    let port = std::env::var(\"DSX_HP_PORT\")","-        .ok()","-        .and_then(|v| v.parse::<u16>().ok())","-        .unwrap_or(0); // 0 = OS-assigned","-","-    let timeout_secs = std::env::var(\"DSX_HP_TIMEOUT\")","-        .ok()","-        .and_then(|v| v.parse::<u64>().ok())","-        .unwrap_or(30);","-","-    let addr = format!(\"127.0.0.1:{port}\");","-","-    // 2. Bind TCP listener","-    let listener = TcpListener::bind(&addr).expect(\"dsx-hp: failed to bind TCP listener\");","-    let actual_port = listener.local_addr().unwrap().port();","-","-    // 3. Write port file","-    write_port_file(actual_port);","-    eprintln!(\"dsx-hp: listening on 127.0.0.1:{actual_port} (timeout={timeout_secs}s)\");","-","-    // 4. Create health service","-    let service = Arc::new(Mutex::new(HealthService::new(timeout_secs)));","-","-    // 5. Accept loop","-    let (_shutdown_tx, shutdown_rx) = mpsc::channel::<()>();","-","-    // Register self as the HP process","-    {","-        let mut svc = service.lock().unwrap();","-        svc.register(ProcessKind::Tui, \"dsx-hp\", std::process::id())","-            .ok();","-    }","-","-    // Heartbeat ticker — self-heartbeat every 15s","-    let svc_heartbeat = service.clone();","-    let _hb_ticker = thread::spawn(move || lo