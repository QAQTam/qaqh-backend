o HP\n89\t                    let mut hp_w = hp.as_ref().unwrap().try_clone().unwrap();\n90\t                    write_frame(&mut hp_w, &frame);\n91\t                    let mut hp_r = BufReader::new(hp.as_ref().unwrap().try_clone().unwrap());\n92\t                    if let Some(resp) = read_frame(&mut hp_r) {\n93\t                        write_frame(&mut tui_writer, &resp);\n94\t                    }\n95\t                    write_frame(&mut tui_writer, r#\"{\"type\":\"done\"}\"#);\n96\t                } else if frame.contains(\"\\\"type\\\":\\\"shutdown\\\"\") {\n97\t                    write_frame(&mut tui_writer, r#\"{\"type\":\"shutdown_ack\"}\"#);\n98\t                    break;\n99\t                } else {\n100\t                    write_frame(&mut tui_writer, &format!(r#\"{{\"type\":\"echo\",\"data\":{frame}}}\"#));\n101\t                    write_frame(&mut tui_writer, r#\"{\"type\":\"done\"}\"#);\n102\t                }\n103\t            }\n104\t            None => break,\n105\t        }\n106\t    }\n107\t\n108\t    // Cleanup: close tools stdin first so tools exits, THEN wait\n109\t    drop(tools_writer);\n110\t    let _ = tools_child.wait();\n111\t    if let Some(ref hp) = hp {\n112\t        let mut hp_w = hp.try_clone().unwrap();\n113\t        let frame = format!(r#\"{{\"type\":\"unregister\",\"pid\":{}}}\"#, std::process::id());\n114\t        write_frame(&mut hp_w, &frame);\n115\t    }\n116\t    eprintln!(\"dsx-agent: shutdown complete\");\n117\t}\n118\t"}]},"uuid":"27151e3a-a47e-4286-8bdf-5c1bfa5994f2","timestamp":"2026-05-15T03:30:02.083Z","toolUseResult":{"type":"text","file":{"filePath":"/home/qaqtamsy/Desktop/dsx/crates/dsx-agent/src/main.rs","content":"//! dsx-agent — central process. Connects TUI ↔ Agent ↔ Tools ↔ HP.\n\nuse std::io::{BufRead, BufReader, Write};\nuse std::net::TcpStream;\nuse std::process::{Command, Stdio};\n\n// ── JSON-LP helpers ──\n\nfn read_frame(reader: &mut BufReader<impl std::io::Read>) -> Option<String> {\n    let mut line = String::new();\n    reader.read_line(&mut line).ok().filter(|n| *n > 0).map(|_| line.trim().to_string())\n}\n\nfn write_frame(writer: &mut impl Write, frame: &str) {\n    let _ = writeln!(writer, \"{frame}\");\n    let _ = writer.flush();\n}\n\n// ── HP connection ──\n\nfn hp_port() -> u16 {\n    let path = std::env::var(\"XDG_RUNTIME_DIR\")\n        .map(std::path::PathBuf::from)\n        .unwrap_or_else(|_| std::path::PathBuf::from(\"/tmp\"))\n        .join(\"dsx/hp.port\");\n    std::fs::read_to_string(&path).ok().and_then(|s| s.trim().parse().ok()).unwrap_or(0)\n}\n\n// ── Main ──\n\nfn main() {\n    eprintln!(\"dsx-agent starting\");\n\n    // 1. Connect to HP\n    let port = hp_port();\n    let hp = if port > 0 {\n        TcpStream::connect(format!(\"127.0.0.1:{port}\"))\n            .map_err(|e| { eprintln!(\"dsx-agent: cannot connect HP: {e}\"); e })\n            .ok()\n    } else {\n        eprintln!(\"dsx-agent: HP not running (no hp.port) — continuing without health daemon\");\n        None\n    };\n\n    if let Some(ref hp) = hp {\n        let frame = format!(r#\"{{\"type\":\"register\",\"kind\":\"Agent\",\"name\":\"dsx-agent\",\"pid\":{}}}\"#, std::process::id());\n        let mut hp_write = hp.try_clone().unwrap();\n        write_frame(&mut hp_write, &frame);\n    }\n\n    // 2. Spawn dsx-tools\n    let exe = std::env::current_exe().unwrap();\n    let tools_path = exe.with_file_name(\"dsx-tools\");\n    let mut tools_child = Command::new(&tools_path)\n        .stdin(Stdio::piped())\n        .stdout(Stdio::piped())\n        .spawn()\n        .expect(\"dsx-agent: failed to spawn dsx-tools\");\n\n    let tools_stdin = tools_child.stdin.take().unwrap();\n    let tools_stdout = tools_child.stdout.take().unwrap();\n    let mut tools_reader = BufReader::new(tools_stdout);\n    let mut tools_writer = tools_stdin;\n\n    // Send Init first — tools waits for Init before sending ToolsReady\n    write_frame(&mut tools_writer, r#\"{\"type\":\"tools_init\",\"allowed_tools\":[],\"session_seed\":\"pipe\",\"auto_mode\":true}\"#);\n    let ready = read_frame(&mut tools_reader).unwrap_or_default();\n    eprintln!(\"dsx-agent: tools → {ready}\");\n\n    // 3. Main loop: read from TUI (stdin), forward to HP/Tools, write to TUI (stdout)\n    let stdin = std::io::stdin();\n    let mut tui_reader = BufReader::new(stdin.lock());\n    let mut tui_writer = std::io::stdout();\n\n    loop {\n        match read_frame(&mut tui_reader) {\n            Some(frame) => {\n                eprintln!(\"dsx-agent: tui ← {frame}\");\n\n                if frame.contains(\"\\\"type\\\":\\\"tool_call\\\"\") {\n                    // Forward to Tools\n                    write_frame(&mut tools_writer, &frame);\n                    if let Some(resp) = read_frame(&mut tools_reader) {\n                        write_frame(&mut tui_writer, &resp);\n                    }\n                    write_frame(&mut tui_writer, r#\"{\"type\":\"done\"}\"#);\n                } else if frame.contains(\"\\\"type\\\":\\\"api_request\\\"\") && hp.is_some() {\n                    // Forward to HP\n                    let mut hp_w = hp.as_ref().unwrap().try_clone().unwrap();\n                    write_frame(&mut hp_w, &frame);\n                    let mut hp_r = BufReader::new(hp.as_ref().unwrap().try_clone().unwrap());\n                    if let Some(resp) = read_frame(&mut hp_r) {\n                        write_frame(&mut tui_writer, &resp);\n                    }\n                    write_frame(&mut tui_writer, r#\"{\"type\":\"done\"}\"#);\n                } else if frame.contains(\"\\\"type\\\":\\\"shutdown\\\"\") {\n                    write_frame(&mut tui_writer, r#\"{\"type\":\"shutdown_ack\"}\"#);\n                    break;\n                } else {\n                    write_frame(&mut tui_writer, &format!(r#\"{{\"type\":\"echo\",\"data\":{frame}}}\"#));\n                    write_frame(&mut tui_writer, r#\"{\"type\":\"done\"}\"#);\n                }\n            }\n            None => break,\n        }\n    }\n\n    // Cleanup: close tools stdin first so tools exits, THEN wait\n    drop(tools_writer);\n    let _ = tools_child.wait();\n    if let Some(ref hp) = hp {\n        let mut hp_w = hp.try_clone().unwrap();\n        let frame = format!(r#\"{{\"type\":\"unregister\",\"pid\":{}}}\"#, std::process::id());\n        write_frame(&mut hp_w, &frame);\n    }\n    eprintln!(\"dsx-agent: shutdown complete\");\n}\n","numLines":118,"startLine":1,"totalLines":118}},"sourceToolAssistantUUID":"1b22cd0a-ea3e-42aa-8c1d-10d9f75b7ea6","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.141","gitBranch":"master","slug":"gentle-orbiting-karp"}
