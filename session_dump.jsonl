{"parentUuid":"f063d7a8-2531-4e61-a8e4-b11e63ea8112","isSidechain":false,"promptId":"ddf8f9ab-d801-42d7-9251-c7fccf1f1f0f","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01_FtByXYo9u9mKFWbnoYdE5832","type":"tool_result","content":"1\t//! AgentState: the orchestrator-owned state, independent of TUI.\n2\t//!\n3\t//! This is the extracted core of the old `App` struct — all fields and methods\n4\t//! that belong to the orchestration/memory/health/session domains, not to UI.\n5\t//!\n6\t//! In the new architecture:\n7\t//!   - dsx-agent owns AgentState\n8\t//!   - dsx-tui embeds and delegates to AgentState (temporarily)\n9\t//!   - Orchestrator modules take &mut AgentState, never &mut App\n10\t\n11\tuse std::time::Instant;\n12\t\n13\tuse crate::config;\n14\tuse crate::conversation::ContextAssembler;\n15\tuse crate::health::monitor::MonitorState;\n16\tuse crate::health::DsAgentsHealthPlatform;\n17\tuse crate::memory::{LongTermMemory, PitfallGuide, SemanticMemory, ShortTermMemory};\n18\tuse crate::session;\n19\tuse crate::skills::SkillIndex;\n20\tuse crate::tokenizer;\n21\tuse dsx_types::{AgentPhase, Message, SafetyLevel, TaskPhase, ToolCall, UsageInfo};\n22\t\n23\t// ── AgentState ──\n24\t\n25\tpub struct AgentState {\n26\t    /// Canonical conversation context with strict alternation guarantees.\n27\t    pub ctx: ContextAssembler,\n28\t    /// Flat view, synced from ctx. Orchestrator reads this; TUI reads this.\n29\t    pub messages: Vec<Message>,\n30\t\n31\t    // ── Configuration ──\n32\t    pub config: crate::config::Config,\n33\t    pub tools_enabled: bool,\n34\t\n35\t    // ── Token tracking ──\n36\t    pub token_estimate: u32,\n37\t    pub token_breakdown: Option<crate::tokenizer::TokenBreakdown>,\n38\t    pub api_usage: Option<UsageInfo>,\n39\t    pub session_tokens: u64,\n40\t    pub cache_hit_pct: f64,\n41\t    pub reasoning_tokens: u32,\n42\t\n43\t    // ── Explore-before-read state machine ──\n44\t    pub has_explored: bool,\n45\t    pub turns_since_last_read: u32,\n46\t\n47\t    // ── Pending tool confirmation ──\n48\t    pub pending_tools: Vec<(ToolCall, SafetyLevel, String)>,\n49\t    pub tool_results: Vec<(String, String)>,\n50\t\n51\t    // ── Session persistence ──\n52\t    pub session_seed: String,\n53\t    pub session_start: u64,\n54\t\n55\t    // ── Crash recovery ──\n56\t    pub dirty: bool,\n57\t    pub last_snapshot: Instant,\n58\t\n59\t    // ── Tool chain safety ──\n60\t    pub tool_failures: u32,\n61\t    pub tool_calls_this_turn: u32,\n62\t    pub turn_scores: Vec<f32>,\n63\t    pub auto_verify: Vec<String>,\n64\t    pub consecutive_tool_turns: u32,\n65\t\n66\t    // ── ask_user flow ──\n67\t    pub intent_question: String,\n68\t    pub intent_options: Vec<String>,\n69\t\n70\t    // ── Skill matching ──\n71\t    pub skill_index: SkillIndex,\n72\t    pub active_skill_bodies: Vec<(String, String)>,\n73\t\n74\t    // ── Exec orchestration ──\n75\t    pub exec_buffer: String,\n76\t    pub exec_pending: usize,\n77\t    pub exec_started_at: Option<Instant>,\n78\t    pub exec_child_pids: Vec<u32>,\n79\t\n80\t    // ── Sudo ──\n81\t    pub sudo_pending: Vec<(ToolCall, String)>,\n82\t    pub sudo_password: String,\n83\t\n84\t    // ── Phase detection ──\n85\t    pub phase: AgentPhase,\n86\t    pub phase_count: u32,\n87\t\n88\t    // ── Project knowledge ──\n89\t    pub project_map: String,\n90\t    pub semantic_memory: SemanticMemory,\n91\t    pub long_mem: LongTermMemory,\n92\t    pub short_mem: ShortTermMemory,\n93\t    pub pitfall_guide: PitfallGuide,\n94\t\n95\t    // ── Mode flags ──\n96\t    pub auto_mode: bool,\n97\t    pub current_task_phase: TaskPhase,\n98\t    pub dev_mode: bool,\n99\t\n100\t    // ── Tool code view state ──\n101\t    pub tool_code_path: String,\n102\t    pub tool_code_content: String,\n103\t    pub tool_code_action: String,\n104\t    pub tool_code_status: Option<&'static str>,\n105\t\n106\t    // ── Health / monitoring ──\n107\t    pub monitor: MonitorState,\n108\t    pub health: DsAgentsHealthPlatform,\n109\t    pub files_written_this_turn: Vec<String>,\n110\t    pub skip_all: bool,\n111\t    pub gate_message: Option<String>,\n112\t    pub health_status_line: String,\n113\t    pub pending_notes: Vec<String>,\n114\t\n115\t    // ── Streaming state (agent-owned — pending IPC serialisation) ──\n116\t    pub stream_content: String,\n117\t    pub stream_reasoning: String,\n118\t    pub stream_tool_progress: Vec<(String, String)>,\n119\t    pub stream_cancelled: bool,\n120\t    pub last_activity: Instant,\n121\t}\n122\t\n123\timpl AgentState {\n124\t    pub fn new(config: crate::config::Config) -> Self {\n125\t        let prompt = config::system_prompt(&config.prompt_lang);\n126\t        let auto_mode = config.auto_mode;\n127\t        let mut ctx = ContextAssembler::new();\n128\t        ctx.push_system(Message::system(&prompt));\n129\t\n130\t        // Scan skills once at startup\n131\t        let skill_index = SkillIndex::scan();\n132\t\n133\t        let mut state = Self {\n134\t            ctx,\n135\t            messages: vec![Message::system(prompt)],\n136\t            config,\n137\t            tools_enabled: true,\n138\t            token_estimate: 0,\n139\t            token_breakdown: None,\n140\t            api_usage: None,\n141\t            session_tokens: 0,\n142\t            cache_hit_pct: 0.0,\n143\t            reasoning_tokens: 0,\n144\t            has_explored: false,\n145\t            turns_since_last_read: 0,\n146\t            pending_tools: Vec::new(),\n147\t            tool_results: Vec::new(),\n148\t            session_seed: String::new(),\n149\t            session_start: 0,\n150\t            dirty: false,\n151\t            last_snapshot: Instant::now(),\n152\t            tool_failures: 0,\n153\t            tool_calls_this_turn: 0,\n154\t            turn_scores: Vec::new(),\n155\t            auto_verify: Vec::new(),\n156\t            consecutive_tool_turns: 0,\n157\t            intent_question: String::new(),\n158\t            intent_options: Vec::new(),\n159\t            skill_index,\n160\t            active_skill_bodies: Vec::new(),\n161\t            exec_buffer: String::new(),\n162\t            exec_pending: 0,\n163\t            exec_started_at: None,\n164\t            exec_child_pids: Vec::new(),\n165\t            sudo_pending: Vec::new(),\n166\t            sudo_password: String::new(),\n167\t            phase: AgentPhase::Idle,\n168\t            phase_count: 0,\n169\t            project_map: String::new(),\n170\t            semantic_memory: SemanticMemory::new(),\n171\t            long_mem: LongTermMemory::default(),\n172\t            short_mem: ShortTermMemory::new(\"\", \"\"),\n173\t            pitfall_guide: session::load_pitfalls(),\n174\t            auto_mode,\n175\t            current_task_phase: TaskPhase::Coding,\n176\t            dev_mode: false,\n177\t            tool_code_path: String::new(),\n178\t            tool_code_content: String::new(),\n179\t            tool_code_action: String::new(),\n180\t            tool_code_status: None,\n181\t            monitor: MonitorState::new(),\n182\t            health: DsAgentsHealthPlatform::new(),\n183\t            files_written_this_turn: Vec::new(),\n184\t            skip_all: false,\n185\t            gate_message: None,\n186\t            health_status_line: String::new(),\n187\t            pending_notes: Vec::new(),\n188\t            stream_content: String::new(),\n189\t            stream_reasoning: String::new(),\n190\t            stream_tool_progress: Vec::new(),\n191\t            stream_cancelled: false,\n192\t            last_activity: Instant::now(),\n193\t        };\n194\t\n195\t        // Seed invariants if fresh\n196\t        if state.long_mem.architecture.is_empty() {\n197\t            state.long_mem.add_invariant(\"tool_use/tool_result MUST be adjacent in messages — API 400 if interleaved\");\n198\t            state.long_mem.add_invariant(\"Sudo password via stdin pipe, NEVER in command string\");\n199\t            state.long_mem.add_invariant(\"exec_pending gates agent loop to prevent double-request race\");\n200\t        }\n201\t\n202\t        crate::tools::AUTO_MODE.store(auto_mode, std::sync::atomic::Ordering::Relaxed);\n203\t        state\n204\t    }\n205\t\n206\t    // ── Token helpers ──\n207\t\n208\t    pub fn tokens_used(&self) -> u32 {\n209\t        self.api_usage.as_ref().map(|u| u.total_tokens).unwrap_or(self.token_estimate)\n210\t    }\n211\t\n212\t    pub fn context_pct(&self) -> f64 {\n213\t        tokenizer::context_usage_ratio(self.token_estimate, self.config.context_limit)\n214\t    }\n215\t\n216\t    // ── Context helpers ──\n217\t\n218\t    /// Unified system note entry. Delegates to ContextAssembler.\n219\t    pub fn system_note(&mut self, tag: &str, msg: String) {\n220\t        self.ctx.annotate(tag, &msg);\n221\t    }\n222\t\n223\t    /// Flush pending annotations and sync flat messages.\n224\t    pub fn flush_notes(&mut self) {\n225\t        self.ctx.flush_annotations();\n226\t        self.sync_messages();\n227\t    }\n228\t\n229\t    /// Sync flat messages from ContextAssembler.\n230\t    pub fn sync_messages(&mut self) {\n231\t        self.messages = self.ctx.to_vec();\n232\t    }\n233\t\n234\t    // ── Repair / persist ──\n235\t\n236\t    /// Repair orphan tool_use/tool_result pairs — prevents API 400.\n237\t    pub fn repair_messages(&mut self) {\n238\t        let msgs = std::mem::take(&mut self.messages);\n239\t        let (mut new_ctx, repairs) = ContextAssembler::from_legacy(msgs);\n240\t        self.ctx = new_ctx;\n241\t        self.sync_messages();\n242\t        if !repairs.is_empty() {\n243\t            log::warn!(\"repair: {}\", repairs.join(\"; \"));\n244\t        }\n245\t    }\n246\t\n247\t    /// Save session to disk if seeded and non-empty.\n248\t    pub fn maybe_save_session(&mut self) {\n249\t        self.repair_messages();\n250\t        let msgs = self.ctx.to_vec();\n251\t        if msgs.len() > 1 && !self.session_seed.is_empty() {\n252\t            session::finalize_session(\n253\t                &self.session_seed,\n254\t                &msgs,\n255\t                &self.config.model,\n256\t                self.config.effort.as_deref(),\n257\t                None,\n258\t            );\n259\t        }\n260\t    }\n261\t\n262\t    // ── Learning / memory extraction ──\n263\t\n264\t    /// Scan all assistant messages for architecture decisions and error patterns.\n265\t    pub fn extract_reasoning_insights(&mut self) {\n266\t        for msg in &self.messages {\n267\t            if msg.role != \"assistant\" { continue; }\n268\t            let Some(ref reasoning) = msg.reasoning_content else { continue };\n269\t            if reasoning.len() < 20 { continue; }\n270\t\n271\t            let arch_keywords = [\n272\t                \"I'll use\", \"I will use\", \"Let's use\", \"改用\", \"采用\",\n273\t                \"approach\", \"design\", \"pattern\", \"方案\", \"架构\",\n274\t                \"decided to\", \"better to\", \"recommend\",\n275\t            ];\n276\t            for kw in &arch_keywords {\n277\t                if let Some(pos) = reasoning.find(kw) {\n278\t                    let start = pos.saturating_sub(30);\n279\t                    let end = reasoning.len().min(pos + kw.len() + 80);\n280\t                    let snippet = &reasoning[start..end];\n281\t                    self.semantic_memory.add_arch_decision(kw, snippet);\n282\t                    break;\n283\t                }\n284\t            }\n285\t\n286\t            let error_keywords = [\"Error:\", \"error[\", \"panic:\", \"bug:\", \"fixed by\", \"原因是\", \"修复\"];\n287\t            for kw in &error_keywords {\n288\t                if let Some(pos) = reasoning.find(kw) {\n289\t                    let start = pos.saturating_sub(20);\n290\t                    let end = reasoning.len().min(pos + kw.len() + 100);\n291\t                    let snippet = &reasoning[start..end];\n292\t                    self.semantic_memory.add_error_pattern(kw, snippet, None);\n293\t                    break;\n294\t                }\n295\t            }\n296\t        }\n297\t    }\n298\t\n299\t    /// Phase detection from reasoning text (hysteresis).\n300\t    pub fn update_phase(&mut self, reasoning: &str) {\n301\t        let (detected, _conf) = crate::orchestrator::phase_detector::detect_phase(reasoning);\n302\t        if detected == self.phase {\n303\t            self.phase_count += 1;\n304\t        } else {\n305\t            self.phase_count = self.phase_count.saturating_sub(1);\n306\t            if self.phase_count == 0 {\n307\t                self.phase = detected;\n308\t                self.phase_count = 1;\n309\t            }\n310\t        }\n311\t    }\n312\t}\n313\t\n314\t// ── ToolResultAppender ──\n315\t//\n316\t// Unified entry point for writing tool results to the context.\n317\t// Eliminates the 3+ scattered `push_tool` call sites in the orchestrator.\n318\t\n319\tuse crate::orchestrator::{arg_parser, tracker};\n320\tuse crate::tools::wrap_tool_result;\n321\t\n322\tpub struct ToolResultAppender<'a> {\n323\t    pub state: &'a mut AgentState,\n324\t}\n325\t\n326\timpl<'a> ToolResultAppender<'a> {\n327\t    pub fn new(state: &'a mut AgentState) -> Self {\n328\t        Self { state }\n329\t    }\n330\t\n331\t    /// Append a tool result to the context and record all side effects.\n332\t    ///\n333\t    /// This is the ONLY entry point for pushing tool results. It handles:\n334\t    /// 1. ContextAssembler push (authoritative)\n335\t    /// 2. Side-effect tracking (tool_results vec, file tracking, health)\n336\t    /// 3. Tool-code preview state\n337\t    ///\n338\t    /// Returns: whether the tool succeeded (result does NOT start with [ERROR]/[FAIL]).\n339\t    pub fn append(&mut self, tool_name: &str, tc_id: &str, args: &str, raw: &str) -> bool {\n340\t        let failed = raw.starts_with(\"[ERROR]\") || raw.starts_with(\"[FAIL]\");\n341\t        let result = wrap_tool_result(tool_name, raw);\n342\t\n343\t        // 1. Push to ContextAssembler (authoritative message store)\n344\t        if let Err(e) = self.state.ctx.push_tool_result(tc_id, &result) {\n345\t            log::warn!(\"ToolResultAppender: push_tool_result failed for {}: {:?}\", tc_id, e);\n346\t            let _ = self.state.ctx.push_tool_result_for(tc_id, &result);\n347\t        }\n348\t\n349\t        // 2. Side-effect tracking\n350\t        self.state.tool_results.push((tool_name.to_string(), result.clone()));\n351\t        if failed {\n352\t            self.state.health.record_error(tool_name, raw);\n353\t            self.state.health.consecutive_failures = self.state.health.consecutive_failures.saturating_add(1);\n354\t            self.state.health.tool_failures_this_turn += 1;\n355\t        } else {\n356\t            self.state.health.consecutive_failures = 0;\n357\t        }\n358\t\n359\t        // 3. Tool-code preview\n360\t        tracker::track_tool_code(self.state, tool_name, args, raw);\n361\t\n362\t        // 4. File tracking (for sandbox enforcement)\n363\t        if !failed && tool_name == \"file\" {\n364\t            let action = arg_parser::tool_action(args);\n365\t            if action == \"write\" || action == \"edit\" {\n366\t                tracker::track_file_written(self.state, args);\n367\t            }\n368\t        }\n369\t\n370\t        // 5. Auto-verify on Rust file edit\n371\t        if raw.starts_with(\"[OK]\") && tool_name == \"file\" {\n372\t            let action = arg_parser::tool_action(args);\n373\t            if (action == \"write\" || action == \"edit\") && !self.state.auto_verify.contains(&\"cargo check\".to_string()) {\n374\t                if let Some(path) = arg_parser::parse_file_arg(args) {\n375\t                    if path.ends_with(\".rs\") {\n376\t                        self.state.auto_verify.push(\"cargo check\".to_string());\n377\t                    }\n378\t                }\n379\t            }\n380\t        }\n381\t\n382\t        !failed\n383\t    }\n384\t\n385\t    /// Consume self and return the underlying state.\n386\t    pub fn into_inner(self) -> &'a mut AgentState {\n387\t        self.state\n388\t    }\n389\t}\n390\t"}]},"uuid":"4c2524ef-eaf2-4971-8292-90167040b01c","timestamp":"2026-05-15T03:19:53.796Z","toolUseResult":{"type":"text","file":{"filePath":"/home/qaqtamsy/Desktop/dsx/crates/dsx-agent/src/agent.rs","content":"//! AgentState: the orchestrator-owned state, independent of TUI.\n//!\n//! This is the extracted core of the old `App` struct — all fields and methods\n//! that belong to the orchestration/memory/health/session domains, not to UI.\n//!\n//! In the new architecture:\n//!   - dsx-agent owns AgentState\n//!   - dsx-tui embeds and delegates to AgentState (temporarily)\n//!   - Orchestrator modules take &mut AgentState, never &mut App\n\nuse std::time::Instant;\n\nuse crate::config;\nuse crate::conversation::ContextAssembler;\nuse crate::health::monitor::MonitorState;\nuse crate::health::DsAgentsHealthPlatform;\nuse crate::memory::{LongTermMemory, PitfallGuide, SemanticMemory, ShortTermMemory};\nuse crate::session;\nuse crate::skills::SkillIndex;\nuse crate::tokenizer;\nuse dsx_types::{AgentPhase, Message, SafetyLevel, TaskPhase, ToolCall, UsageInfo};\n\n// ── AgentState ──\n\npub struct AgentState {\n    /// Canonical conversation context with strict alternation guarantees.\n    pub ctx: ContextAssembler,\n    /// Flat view, synced from ctx. Orchestrator reads this; TUI reads this.\n    pub messages: Vec<Message>,\n\n    // ── Configuration ──\n    pub config: crate::config::Config,\n    pub tools_enabled: bool,\n\n    // ── Token tracking ──\n    pub token_estimate: u32,\n    pub token_breakdown: Option<crate::tokenizer::TokenBreakdown>,\n    pub api_usage: Option<UsageInfo>,\n    pub session_tokens: u64,\n    pub cache_hit_pct: f64,\n    pub reasoning_tokens: u32,\n\n    // ── Explore-before-read state machine ──\n    pub has_explored: bool,\n    pub turns_since_last_read: u32,\n\n    // ── Pending tool confirmation ──\n    pub pending_tools: Vec<(ToolCall, SafetyLevel, String)>,\n    pub tool_results: Vec<(String, String)>,\n\n    // ── Session persistence ──\n    pub session_seed: String,\n    pub session_start: u64,\n\n    // ── Crash recovery ──\n    pub dirty: bool,\n    pub last_snapshot: Instant,\n\n    // ── Tool chain safety ──\n    pub tool_failures: u32,\n    pub tool_calls_this_turn: u32,\n    pub turn_scores: Vec<f32>,\n    pub auto_verify: Vec<String>,\n    pub consecutive_tool_turns: u32,\n\n    // ── ask_user flow ──\n    pub intent_question: String,\n    pub intent_options: Vec<String>,\n\n    // ── Skill matching ──\n    pub skill_index: SkillIndex,\n    pub active_skill_bodies: Vec<(String, String)>,\n\n    // ── Exec orchestration ──\n    pub exec_buffer: String,\n    pub exec_pending: usize,\n    pub exec_started_at: Option<Instant>,\n    pub exec_child_pids: Vec<u32>,\n\n    // ── Sudo ──\n    pub sudo_pending: Vec<(ToolCall, String)>,\n    pub sudo_password: String,\n\n    // ── Phase detection ──\n    pub phase: AgentPhase,\n    pub phase_count: u32,\n\n    // ── Project knowledge ──\n    pub project_map: String,\n    pub semantic_memory: SemanticMemory,\n    pub long_mem: LongTermMemory,\n    pub short_mem: ShortTermMemory,\n    pub pitfall_guide: PitfallGuide,\n\n    // ── Mode flags ──\n    pub auto_mode: bool,\n    pub current_task_phase: TaskPhase,\n    pub dev_mode: bool,\n\n    // ── Tool code view state ──\n    pub tool_code_path: String,\n    pub tool_code_content: String,\n    pub tool_code_action: String,\n    pub tool_code_status: Option<&'static str>,\n\n    // ── Health / monitoring ──\n    pub monitor: MonitorState,\n    pub health: DsAgentsHealthPlatform,\n    pub files_written_this_turn: Vec<String>,\n    pub skip_all: bool,\n    pub gate_message: Option<String>,\n    pub health_status_line: String,\n    pub pending_notes: Vec<String>,\n\n    // ── Streaming state (agent-owned — pending IPC serialisation) ──\n    pub stream_content: String,\n    pub stream_reasoning: String,\n    pub stream_tool_progress: Vec<(String, String)>,\n    pub stream_cancelled: bool,\n    pub last_activity: Instant,\n}\n\nimpl AgentState {\n    pub fn new(config: crate::config::Config) -> Self {\n        let prompt = config::system_prompt(&config.prompt_lang);\n        let auto_mode = config.auto_mode;\n        let mut ctx = ContextAssembler::new();\n        ctx.push_system(Message::system(&prompt));\n\n        // Scan skills once at startup\n        let skill_index = SkillIndex::scan();\n\n        let mut state = Self {\n            ctx,\n            messages: vec![Message::system(prompt)],\n            config,\n            tools_enabled: true,\n            token_estimate: 0,\n            token_breakdown: None,\n            api_usage: None,\n            session_tokens: 0,\n            cache_hit_pct: 0.0,\n            reasoning_tokens: 0,\n            has_explored: false,\n            turns_since_last_read: 0,\n            pending_tools: Vec::new(),\n            tool_results: Vec::new(),\n            session_seed: String::new(),\n            session_start: 0,\n            dirty: false,\n            last_snapshot: Instant::now(),\n            tool_failures: 0,\n            tool_calls_this_turn: 0,\n            turn_scores: Vec::new(),\n            auto_verify: Vec::new(),\n            consecutive_tool_turns: 0,\n            intent_question: String::new(),\n            intent_options: Vec::new(),\n            skill_index,\n            active_skill_bodies: Vec::new(),\n            exec_buffer: String::new(),\n            exec_pending: 0,\n            exec_started_at: None,\n            exec_child_pids: Vec::new(),\n            sudo_pending: Vec::new(),\n            sudo_password: String::new(),\n            phase: AgentPhase::Idle,\n            phase_count: 0,\n            project_map: String::new(),\n            semantic_memory: SemanticMemory::new(),\n            long_mem: LongTermMemory::default(),\n            short_mem: ShortTermMemory::new(\"\", \"\"),\n            pitfall_guide: session::load_pitfalls(),\n            auto_mode,\n            current_task_phase: TaskPhase::Coding,\n            dev_mode: false,\n            tool_code_path: String::new(),\n            tool_code_content: String::new(),\n            tool_code_action: String::new(),\n            tool_code_status: None,\n            monitor: MonitorState::new(),\n            health: DsAgentsHealthPlatform::new(),\n            files_written_this_turn: Vec::new(),\n            skip_all: false,\n            gate_message: None,\n            health_status_line: String::new(),\n            pending_notes: Vec::new(),\n            stream_content: String::new(),\n            stream_reasoning: String::new(),\n            stream_tool_progress: Vec::new(),\n            stream_cancelled: false,\n            last_activity: Instant::now(),\n        };\n\n        // Seed invariants if fresh\n        if state.long_mem.architecture.is_empty() {\n            state.long_mem.add_invariant(\"tool_use/tool_result MUST be adjacent in messages — API 400 if interleaved\");\n            state.long_mem.add_invariant(\"Sudo password via stdin pipe, NEVER in command string\");\n            state.long_mem.add_invariant(\"exec_pending gates agent loop to prevent double-request race\");\n        }\n\n        crate::tools::AUTO_MODE.store(auto_mode, std::sync::atomic::Ordering::Relaxed);\n        state\n    }\n\n    // ── Token helpers ──\n\n    pub fn tokens_used(&self) -> u32 {\n        self.api_usage.as_ref().map(|u| u.total_tokens).unwrap_or(self.token_estimate)\n    }\n\n    pub fn context_pct(&self) -> f64 {\n        tokenizer::context_usage_ratio(self.token_estimate, self.config.context_limit)\n    }\n\n    // ── Context helpers ──\n\n    /// Unified system note entry. Delegates to ContextAssembler.\n    pub fn system_note(&mut self, tag: &str, msg: String) {\n        self.ctx.annotate(tag, &msg);\n    }\n\n    /// Flush pending annotations and sync flat messages.\n    pub fn flush_notes(&mut self) {\n        self.ctx.flush_annotations();\n        self.sync_messages();\n    }\n\n    /// Sync flat messages from ContextAssembler.\n    pub fn sync_messages(&mut self) {\n        self.messages = self.ctx.to_vec();\n    }\n\n    // ── Repair / persist ──\n\n    /// Repair orphan tool_use/tool_result pairs — prevents API 400.\n    pub fn repair_messages(&mut self) {\n        let msgs = std::mem::take(&mut self.messages);\n        let (mut new_ctx, repairs) = ContextAssembler::from_legacy(msgs);\n        self.ctx = new_ctx;\n        self.sync_messages();\n        if !repairs.is_empty() {\n            log::warn!(\"repair: {}\", repairs.join(\"; \"));\n        }\n    }\n\n    /// Save session to disk if seeded and non-empty.\n    pub fn maybe_save_session(&mut self) {\n        self.repair_messages();\n        let msgs = self.ctx.to_vec();\n        if msgs.len() > 1 && !self.session_seed.is_empty() {\n            session::finalize_session(\n                &self.session_seed,\n                &msgs,\n                &self.config.model,\n                self.config.effort.as_deref(),\n                None,\n            );\n        }\n    }\n\n    // ── Learning / memory extraction ──\n\n    /// Scan all assistant messages for architecture decisions and error patterns.\n    pub fn extract_reasoning_insights(&mut self) {\n        for msg in &self.messages {\n            if msg.role != \"assistant\" { continue; }\n            let Some(ref reasoning) = msg.reasoning_content else { continue };\n            if reasoning.len() < 20 { continue; }\n\n            let arch_keywords = [\n                \"I'll use\", \"I will use\", \"Let's use\", \"改用\", \"采用\",\n                \"approach\", \"design\", \"pattern\", \"方案\", \"架构\",\n                \"decided to\", \"better to\", \"recommend\",\n            ];\n            for kw in &arch_keywords {\n                if let Some(pos) = reasoning.find(kw) {\n                    let start = pos.saturating_sub(30);\n                    let end = reasoning.len().min(pos + kw.len() + 80);\n                    let snippet = &reasoning[start..end];\n                    self.semantic_memory.add_arch_decision(kw, snippet);\n                    break;\n                }\n            }\n\n            let error_keywords = [\"Error:\", \"error[\", \"panic:\", \"bug:\", \"fixed by\", \"原因是\", \"修复\"];\n            for kw in &error_keywords {\n                if let Some(pos) = reasoning.find(kw) {\n                    let start = pos.saturating_sub(20);\n                    let end = reasoning.len().min(pos + kw.len() + 100);\n                    let snippet = &reasoning[start..end];\n                    self.semantic_memory.add_error_pattern(kw, snippet, None);\n                    break;\n                }\n            }\n        }\n    }\n\n    /// Phase detection from reasoning text (hysteresis).\n    pub fn update_phase(&mut self, reasoning: &str) {\n        let (detected, _conf) = crate::orchestrator::phase_detector::detect_phase(reasoning);\n        if detected == self.phase {\n            self.phase_count += 1;\n        } else {\n            self.phase_count = self.phase_count.saturating_sub(1);\n            if self.phase_count == 0 {\n                self.phase = detected;\n                self.phase_count = 1;\n            }\n        }\n    }\n}\n\n// ── ToolResultAppender ──\n//\n// Unified entry point for writing tool results to the context.\n// Eliminates the 3+ scattered `push_tool` call sites in the orchestrator.\n\nuse crate::orchestrator::{arg_parser, tracker};\nuse crate::tools::wrap_tool_result;\n\npub struct ToolResultAppender<'a> {\n    pub state: &'a mut AgentState,\n}\n\nimpl<'a> ToolResultAppender<'a> {\n    pub fn new(state: &'a mut AgentState) -> Self {\n        Self { state }\n    }\n\n    /// Append a tool result to the context and record all side effects.\n    ///\n    /// This is the ONLY entry point for pushing tool results. It handles:\n    /// 1. ContextAssembler push (authoritative)\n    /// 2. Side-effect tracking (tool_results vec, file tracking, health)\n    /// 3. Tool-code preview state\n    ///\n    /// Returns: whether the tool succeeded (result does NOT start with [ERROR]/[FAIL]).\n    pub fn append(&mut self, tool_name: &str, tc_id: &str, args: &str, raw: &str) -> bool {\n        let failed = raw.starts_with(\"[ERROR]\") || raw.starts_with(\"[FAIL]\");\n        let result = wrap_tool_result(tool_name, raw);\n\n        // 1. Push to ContextAssembler (authoritative message store)\n        if let Err(e) = self.state.ctx.push_tool_result(tc_id, &result) {\n            log::warn!(\"ToolResultAppender: push_tool_result failed for {}: {:?}\", tc_id, e);\n            let _ = self.state.ctx.push_tool_result_for(tc_id, &result);\n        }\n\n        // 2. Side-effect tracking\n        self.state.tool_results.push((tool_name.to_string(), result.clone()));\n        if failed {\n            self.state.health.record_error(tool_name, raw);\n            self.state.health.consecutive_failures = self.state.health.consecutive_failures.saturating_add(1);\n            self.state.health.tool_failures_this_turn += 1;\n        } else {\n            self.state.health.consecutive_failures = 0;\n        }\n\n        // 3. Tool-code preview\n        tracker::track_tool_code(self.state, tool_name, args, raw);\n\n        // 4. File tracking (for sandbox enforcement)\n        if !failed && tool_name == \"file\" {\n            let action = arg_parser::tool_action(args);\n            if action == \"write\" || action == \"edit\" {\n                tracker::track_file_written(self.state, args);\n            }\n        }\n\n        // 5. Auto-verify on Rust file edit\n        if raw.starts_with(\"[OK]\") && tool_name == \"file\" {\n            let action = arg_parser::tool_action(args);\n            if (action == \"write\" || action == \"edit\") && !self.state.auto_verify.contains(&\"cargo check\".to_string()) {\n                if let Some(path) = arg_parser::parse_file_arg(args) {\n                    if path.ends_with(\".rs\") {\n                        self.state.auto_verify.push(\"cargo check\".to_string());\n                    }\n                }\n            }\n        }\n\n        !failed\n    }\n\n    /// Consume self and return the underlying state.\n    pub fn into_inner(self) -> &'a mut AgentState {\n        self.state\n    }\n}\n","numLines":390,"startLine":1,"totalLines":390}},"sourceToolAssistantUUID":"f063d7a8-2531-4e61-a8e4-b11e63ea8112","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.141","gitBranch":"master","slug":"gentle-orbiting-karp"}
