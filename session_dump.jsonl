{"parentUuid":"8faf65ef-f07d-41d2-9779-ea2b0d80d4b6","isSidechain":false,"teamName":"dsx-integration","attachment":{"type":"edited_text_file","filename":"/home/qaqtamsy/Desktop/dsx/crates/dsx-agent/src/runner.rs","snippet":"1\t//! dsx-agent — central process. Connects TUI ↔ Agent ↔ Tools ↔ HP.\n2\t//!\n3\t//! Wires all intelligence modules (session, memory, orchestrator, context,\n4\t//! skills, router, tokenizer, health) into the HP-bridged conversation loop.\n5\t//!\n6\t//! Uses shared dsx-proto types for all IPC channels (TUI, Tools, HP).\n7\t\n8\tuse std::io::{BufRead, BufReader, Write};\n9\tuse std::net::TcpStream;\n10\tuse std::process::{Command, Stdio};\n11\t\n12\tuse dsx_proto::{\n13\t    self, TuiToAgent, AgentToTui, AgentToTools, ToolsToAgent, AgentToHp, HpToAgent,\n14\t};\n15\t\n16\tuse crate::agent::{AgentState, ToolResultAppender};\n17\tuse crate::config::Config;\n18\tuse crate::dsc_log;\n19\tuse crate::memory;\n20\tuse crate::orchestrator::{gates, learning, phase_detector, tracker, turn_scorer, session_persistence};\n21\tuse crate::router;\n22\tuse crate::session;\n23\tuse crate::tokenizer;\n24\tuse crate::tools;\n25\tuse dsx_types::{AgentPhase, Message, ToolCall, FunctionCall};\n26\t\n27\t// ── HP connection ──\n28\t\n29\tfn hp_port() -> u16 {\n30\t    let home = std::env::var(\"HOME\").unwrap_or_else(|_| \"/tmp\".into());\n31\t    let path = std::path::PathBuf::from(home).join(\".dsx\").join(\"hp.port\");\n32\t    std::fs::read_to_string(&path).ok().and_then(|s| s.trim().parse().ok()).unwrap_or(0)\n33\t}\n34\t\n35\t/// Connect to HP, register, and return the TCP stream.\n36\t/// Uses set_nonblocking(false) + single stream for reliable read/write.\n37\tfn connect_hp() -> Option<TcpStream> {\n38\t    let port = hp_port();\n39\t    if port == 0 {\n40\t        eprintln!(\"dsx-agent: HP not running (no hp.port) — continuing without AI\");\n41\t        return None;\n42\t    }\n43\t\n44\t    let mut stream = match TcpStream::connect(format!(\"127.0.0.1:{port}\")) {\n45\t        Ok(s) => s,\n46\t        Err(e) => {\n47\t            eprintln!(\"dsx-agent: cannot connect HP: {e}\");\n48\t            return None;\n49\t        }\n50\t    };\n51\t\n52\t    let pid = std::process::id();\n53\t    let reg = AgentToHp::Register {\n54\t        kind: \"Agent\".into(),\n55\t        name: \"dsx-agent\".into(),\n56\t        pid,\n57\t    };\n58\t    let _ = dsx_proto::write_frame(&mut stream, &reg);\n59\t\n60\t    eprintln!(\"dsx-agent: connected to HP on port {port}\");\n61\t    Some(stream)\n62\t}\n63\t\n64\t// ── Session initialization ──\n65\t\n66\tfn init_session(agent: &mut AgentState) {\n67\t    let lives = session::find_live_sessions();\n68\t    if let Some(meta) = lives.first() {\n69\t        eprintln!(\"dsx-agent: found live session {} ({} msgs, {})\",\n70\t            meta.seed, meta.message_count, meta.last_summary);\n71\t        if let Some(file) = session::load_session(&meta.seed) {\n72\t            agent.session_seed = file.seed.clone();\n73\t            agent.session_start = file.created_at;\n74\t            let (ctx, repairs) = crate::conversation::ContextAssembler::from_legacy(file.messages);\n75\t            agent.ctx = ctx;\n76\t            agent.sync_messages();\n77\t            if !repairs.is_empty() {\n78\t                log::warn!(\"session restore repairs: {}\", repairs.join(\"; \"));\n79\t            }\n80\t            agent.short_mem = memory::ShortTermMemory::new(&file.seed, &file.model);\n81\t            if let Some(phase) = file.task_phase {\n82\t                router::set_phase(phase, dsx_types::DebugLevel::Medium);\n83\t                agent.current_task_phase = phase;\n84\t            }\n85\t            dsc_log::set_session(&agent.session_seed);\n86\t            tools::set_current_session(&agent.session_seed);\n87\t            eprintln!(\"dsx-agent: session {} restored ({} messages)\", agent.session_seed, agent.messages.len());\n88\t            return;\n89\t        }\n90\t    }\n91\t\n92\t    // Fresh session\n93\t    agent.session_seed = session::generate_seed();\n94\t    agent.session_start = session::now_epoch();\n95\t    agent.short_mem = memory::ShortTermMemory::new(&agent.session_seed, &agent.config.model);\n96\t    dsc_log::set_session(&agent.session_seed);\n97\t    tools::set_current_session(&agent.session_seed);\n98\t    session::save_live_snapshot(\n99\t        &agent.session_seed, &agent.messages,\n100\t        &agent.config.model, agent.config.effort.as_deref(), None, None,\n101\t    );\n102\t    eprintln!(\"dsx-agent: new session {}\", agent.session_seed);\n103\t}\n104\t\n105\tfn health_status(agent: &AgentState) -> String {\n106\t    let assessment = agent.health.assess();\n107\t    format!(\n108\t        \"[{} {} {} | tier:{:?} | {}% | t{}]\",\n109\t        if assessment.level == crate::health::HealthLevel::Red { \"RED\" }\n110\t        else if assessment.level == crate::health::HealthLevel::Yellow { \"YLW\" }\n111\t        else { \"OK\" },\n112\t        assessment.emotion.emoji(),\n113\t        assessment.emotion.label(),\n114\t        agent.health.context_tier,\n115\t        (assessment.success_rate * 100.0) as u32,\n116\t        agent.health.turn,\n117\t    )\n118\t}\n119\t\n120\t// ── Message conversion ──\n121\t\n122\t/// Convert HP tool_calls JSON (flat or nested) to ToolCall vec.\n123\tfn parse_tool_calls(tcs: &serde_json::Value) -> Vec<ToolCall> {\n124\t    let arr = match tcs.as_array() { Some(a) => a, None => return vec![] };\n125\t    arr.iter().filter_map(|tc| {\n126\t        let id = tc.get(\"id\").and_then(|i| i.as_str()).unwrap_or(\"\");\n127\t        // Support both flat {name, arguments} and nested {function: {name, arguments}}\n128\t        let (name, arguments) = if let Some(func) = tc.get(\"function\") {\n129\t            let n = func.get(\"name\").and_then(|v| v.as_str()).unwrap_or(\"\");\n130\t            let a = func.get(\"arguments\").and_then(|v| v.as_str()).unwrap_or(\"{}\");\n131\t            (n, a)\n132\t        } else {\n133\t            let n = tc.get(\"name\").and_then(|v| v.as_str()).unwrap_or(\"\");\n134\t            let a = tc.get(\"arguments\").and_then(|v| v.as_str()).unwrap_or(\"{}\");\n135\t            (n, a)\n136\t        };\n137\t        if id.is_empty() || name.is_empty() { return None; }\n138\t        Some(ToolCall {\n139\t            id: id.to_string(),\n140\t            call_type: \"function\".to_string(),\n141\t            function: FunctionCall { name: name.to_string(), arguments: arguments.to_string() },\n142\t        })\n143\t    }).collect()\n144\t}\n145\t\n146\t// ── User input handler (fully wired) ──\n147\t\n148\t/// Handle a TuiToAgent::UserInput frame with full module integration.\n149\tfn handle_user_input(\n150\t    agent: &mut AgentState,\n151\t    text: &str,\n152\t    hp: &mut TcpStream,\n153\t    tools_reader: &mut impl BufRead,\n154\t    tools_writer: &mut impl Write,\n155\t    tui_writer: &mut impl Write,\n156\t    tui_reader: &mut impl BufRead,\n157\t) {\n158\t    if text.is_empty() { return; }\n159\t\n160\t    // ── Session init on first message ──\n161\t    if agent.session_seed.is_empty() {\n162\t        init_session(agent);\n163\t        if agent.auto_mode {\n164\t            let phase = router::detect_initial_phase(text);\n165\t            router::set_phase(phase, dsx_types::DebugLevel::Medium);\n166\t            agent.current_task_phase = phase;\n167\t            log::info!(\"auto initial phase: {:?}\", phase);\n168\t        }\n169\t    }\n170\t\n171\t    // ── Skill matching ──\n172\t    let matched = agent.skill_index.match_skills(text);\n173\t    agent.active_skill_bodies.clear();\n174\t    for skill in &matched {\n175\t        if let Some(body) = agent.skill_index.load_skill_body(&skill.name) {\n176\t            agent.active_skill_bodies.push((skill.name.clone(), body));\n177\t        }\n178\t    }\n179\t\n180\t    // ── Push user message to ContextAssembler ──\n181\t    let _ = agent.ctx.push_user(text);\n182\t    agent.sync_messages();\n183\t\n184\t    // ── Reset per-turn state ──\n185\t    agent.tool_results.clear();\n186\t    agent.tool_code_content.clear();\n187\t    agent.tool_code_path.clear();\n188\t    agent.tool_code_action.clear();\n189\t    agent.tool_code_status = None;\n190\t    agent.phase = AgentPhase::Idle;\n191\t    agent.phase_count = 0;\n192\t    agent.tool_failures = 0;\n193\t    agent.tool_calls_this_turn = 0;\n194\t    agent.files_written_this_turn.clear();\n195\t    agent.monitor.tool_calls_this_turn = 0;\n196\t    agent.monitor.tool_failures_this_turn = 0;\n197\t\n198\t    // Live snapshot after user message\n199\t    session::save_live_snapshot(\n200\t        &agent.session_seed, &agent.messages,\n201\t        &agent.config.model, agent.config.effort.as_deref(), None, None,\n202\t    );\n203\t\n204\t    // ── Tool-calling loop (up to 10 rounds) ──\n205\t    for _round in 0..10 {\n\n... [486 lines truncated] ..."},"type":"attachment","uuid":"7c4a9f0e-904d-4f31-95b5-5e5ad76a78ec","timestamp":"2026-05-15T07:35:58.111Z","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
{"parentUuid":"7c4a9f0e-904d-4f31-95b5-5e5ad76a78ec","isSidechain":false,"teamName":"dsx-integration","attachment":{"type":"edited_text_file","filename":"/home/qaqtamsy/Desktop/dsx/crates/dsx-tui/src/lib.rs","snippet":"1\t//! DSX TUI — main event loop.\n2\t//!\n3\t//! Lifecycle:\n4\t//!   1. Initialize AppState + AgentConnection + StreamBuffer\n5\t//!   2. Loop: poll keyboard → dispatch InputAction → poll IPC → render → snapshot\n6\t//!   3. Shutdown: flush session, terminate agent, restore terminal\n7\t\n8\tuse clap::Parser;\n9\tuse dsx_types::{Message, ToolCall, FunctionCall, SafetyLevel};\n10\tuse std::io::{BufRead, BufReader, Write};\n11\tuse std::process::{Command, Stdio};\n12\t\n13\tuse crate::mode::Mode;\n14\tuse crate::input::action::InputAction;\n15\tuse crate::state::{AgentConnection, AppState, StreamBuffer};\n16\t\n17\tfn read_line(reader: &mut BufReader<impl std::io::Read>) -> Option<String> {\n18\t    let mut line = String::new();\n19\t    reader.read_line(&mut line).ok().filter(|n| *n > 0).map(|_| line.trim().to_string())\n20\t}\n21\t\n22\tfn send(writer: &mut impl Write, frame: &str) {\n23\t    let _ = writeln!(writer, \"{frame}\");\n24\t    let _ = writer.flush();\n25\t}\n26\t\n27\t#[derive(clap::Parser)]\n28\t#[command(name = \"dsx\", about = \"DeepSeek X\")]\n29\tstruct Cli {\n30\t    #[arg(long)] resume: bool,\n31\t    #[arg(long)] list_sessions: bool,\n32\t    #[arg(long)] list_skills: bool,\n33\t    #[arg(long)] readline: bool,\n34\t    #[arg(long)] demo: bool,\n35\t}\n36\t\n37\tpub mod app;\n38\tpub mod mode;\n39\tpub mod state;\n40\tpub mod status;\n41\tpub mod tui_text;\n42\tpub mod utils;\n43\t\n44\tpub mod input {\n45\t    pub mod chat;\n46\t    pub mod confirm;\n47\t    pub mod picker;\n48\t    pub mod sudo;\n49\t    pub mod action;\n50\t    pub mod state;\n51\t}\n52\t\n53\tpub mod render;\n54\t\n55\t// ── Phase 4 stubs for cross-crate dependencies ──\n56\t\n57\t/// Save a field to ~/.dsx/config.json (merges with existing).\n58\tfn save_dsx_config(key: &str, value: &str) {\n59\t    let home = std::env::var(\"HOME\").unwrap_or_else(|_| \"/tmp\".into());\n60\t    let path = std::path::PathBuf::from(&home).join(\".dsx\").join(\"config.json\");\n61\t    let mut cfg = serde_json::json!({});\n62\t    if let Ok(data) = std::fs::read_to_string(&path) {\n63\t        if let Ok(v) = serde_json::from_str::<serde_json::Value>(&data) {\n64\t            cfg = v;\n65\t        }\n66\t    }\n67\t    cfg[key] = serde_json::json!(value);\n68\t    let _ = std::fs::create_dir_all(path.parent().unwrap());\n69\t    let _ = std::fs::write(&path, serde_json::to_string_pretty(&cfg).unwrap());\n70\t}\n71\t\n72\t/// Path to the HP daemon's port file.\n73\tfn hp_port_path() -> std::path::PathBuf {\n74\t    let home = std::env::var(\"HOME\").unwrap_or_else(|_| \"/tmp\".into());\n75\t    std::path::PathBuf::from(home).join(\".dsx\").join(\"hp.port\")\n76\t}\n77\t\n78\t/// Auto-start the HP daemon if it isn't already running.\n79\t/// Verifies the port is actually reachable (not a stale port file).\n80\tfn ensure_hp_running() {\n81\t    let port_path = hp_port_path();\n82\t\n83\t    // If port file exists, verify HP is actually alive\n84\t    if port_path.exists() {\n85\t        if let Ok(port_str) = std::fs::read_to_string(&port_path) {\n86\t            if let Ok(port) = port_str.trim().parse::<u16>() {\n87\t                if std::net::TcpStream::connect_timeout(\n88\t                    &format!(\"127.0.0.1:{port}\").parse().unwrap(),\n89\t                    std::time::Duration::from_millis(200),\n90\t                ).is_ok() {\n91\t                    return; // HP is alive\n92\t                }\n93\t            }\n94\t        }\n95\t        // Stale port file — remove and restart\n96\t        let _ = std::fs::remove_file(&port_path);\n97\t    }\n98\t\n99\t    eprintln!(\"dsx: starting HP daemon...\");\n100\t    let exe = match std::env::current_exe() {\n101\t        Ok(e) => e,\n102\t        Err(_) => return,\n103\t    };\n104\t    // Spawn HP in background (detached)\n105\t    let _ = Command::new(&exe)\n106\t        .arg(\"hp\")\n107\t        .stdout(Stdio::null())\n108\t        .stderr(Stdio::null())\n109\t        .spawn();\n110\t    // Wait for port file (up to 5s)\n111\t    for _ in 0..50 {\n112\t        if port_path.exists() { return; }\n113\t        std::thread::sleep(std::time::Duration::from_millis(100));\n114\t    }\n115\t    eprintln!(\"dsx: WARNING — HP daemon did not start in time\");\n116\t}\n117\t\n118\t/// Run the TUI: parse args (stripping umbrella subcommand if present).\n119\tpub fn run() -> anyhow::Result<()> {\n120\t    let args: Vec<String> = std::env::args().collect();\n121\t    let skip = args.get(1).map_or(false, |a| !a.starts_with('-'));\n122\t    let cli = Cli::parse_from(\n123\t        std::env::args().take(1).chain(std::env::args().skip(if skip { 2 } else { 1 })),\n124\t    );\n125\t\n126\t    // --readline: bypass ratatui AND AgentConnection entirely\n127\t    if cli.readline {\n128\t        return run_readline_direct();\n129\t    }\n130\t\n131\t    // --demo: pure TUI render with stub data, no processes\n132\t    if cli.demo {\n133\t        return run_demo();\n134\t    }\n135\t\n136\t    run_impl(cli)\n137\t}\n138\t\n139\tfn run_impl(_cli: Cli) -> anyhow::Result<()> {\n140\t    use std::io::{BufRead, Write};\n141\t    use std::process::{Command, Stdio};\n142\t\n143\t    ensure_hp_running();\n144\t\n145\t    // Spawn agent directly with raw pipes (same approach as --demo/--readline)\n146\t    let exe = std::env::current_exe()?;\n147\t    let agent_bin = if std::env::var(\"DSX_SINGLE_BINARY\").is_ok() {\n148\t        exe\n149\t    } else {\n150\t        exe.with_file_name(\"dsx-agent\")\n151\t    };\n152\t    let mut cmd = Command::new(&agent_bin);\n153\t    if std::env::var(\"DSX_SINGLE_BINARY\").is_ok() {\n154\t        cmd.arg(\"agent\");\n155\t    }\n156\t    let mut child = cmd\n157\t        .stdin(Stdio::piped())\n158\t        .stdout(Stdio::piped())\n159\t        .stderr(Stdio::null()) // prevent agent stderr from corrupting raw mode display\n160\t        .spawn()\n161\t        .map_err(|e| anyhow::anyhow!(\"cannot spawn agent: {e}\"))?;\n162\t    let mut agent_writer = child.stdin.take().unwrap();\n163\t    let mut agent_reader = BufReader::new(child.stdout.take().unwrap());\n164\t\n165\t    // Stub AgentConnection for render_all (needs config display fields)\n166\t    let stub_config = stubs::config::Config::load()?;\n167\t    let prompt_lang = stub_config.prompt_lang.clone();\n168\t    let stub_auto = stub_config.auto_mode;\n169\t    let mut conn = AgentConnection::spawn(None, stub_config)?;\n170\t\n171\t    // TUI state\n172\t    let mut state = AppState::new(Mode::Chat);\n173\t    state.auto_mode = stub_auto;\n174\t    let mut stream = StreamBuffer::new();\n175\t\n176\t    // Slash commands (localized)\n177\t    let tt = crate::tui_text::tui_text(&prompt_lang);\n178\t    let build_commands = |lang: &str| -> Vec<(String, String)> {\n179\t        let t = crate::tui_text::tui_text(lang);\n180\t        vec![\n181\t            (\"/help\".into(),    t.slash_help.to_string()),\n182\t            (\"/model\".into(),   t.slash_model.to_string()),\n183\t            (\"/effort\".into(),  t.slash_effort.to_string()),\n184\t            (\"/lang\".into(),    t.slash_lang.to_string()),\n185\t            (\"/auto\".into(),    t.slash_auto.to_string()),\n186\t            (\"/compact\".into(), t.slash_compact.to_string()),\n187\t            (\"/balance\".into(), t.slash_balance.to_string()),\n188\t            (\"/clear\".into(),   t.slash_clear.to_string()),\n189\t            (\"/quit\".into(),    t.slash_quit.to_string()),\n190\t        ]\n191\t    };\n192\t    state.slash_commands = build_commands(&prompt_lang);\n193\t\n194\t    // Terminal setup\n195\t    crossterm::terminal::enable_raw_mode()?;\n196\t    let mut stdout = std::io::stdout();\n197\t    crossterm::execute!(\n198\t        stdout,\n199\t        crossterm::terminal::EnterAlternateScreen,\n200\t        crossterm::cursor::Hide,\n201\t    )?;\n202\t    let mut terminal = ratatui::Terminal::new(ratatui::backend::CrosstermBackend::new(stdout))?;\n203\t    terminal.clear()?;\n204\t\n205\t    // Keyboard reader thread (avoids crossterm poll issues on some terminals)\n206\t    use crossterm::event::{Event, KeyCode, KeyModifiers};\n207\t    use crate::input::action::InputAction;\n208\t    let (key_tx, key_rx) = std::sync::mpsc::channel::<Event>();\n209\t    let _reader = std::thread::Builder::new().name(\"kbd\".into())\n210\t        .spawn(move || {\n211\t            loop { match crossterm::event::read() {\n212\t                Ok(e) => if key_tx.send(e).is_err() { break; },\n213\t                Err(_) => break,\n214\t            }}\n215\t        }).ok();\n216\t\n217\t    // Main event loop\n218\t    let mut dirty = true;\n219\t    let mut awaiting = false;\n\n... [827 lines truncated] ..."},"type":"attachment","uuid":"3cdf2c09-483c-4989-9ffe-0de275cf591d","timestamp":"2026-05-15T07:35:58.111Z","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
