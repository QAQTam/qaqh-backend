mizable):\n//!    ```json\n//!    {\n//!      \"en\": { \"base\": \"...\", \"rules\": [\"...\", \"...\"], \"style\": \"...\" },\n//!      \"zh\": { \"base\": \"...\", \"rules\": [\"...\", \"...\"], \"style\": \"...\" }\n//!    }\n//!    ```\n//! 2. Fall back to built-in strings if file missing.\n\nuse std::path::PathBuf;\n\nfn prompts_dir() -> PathBuf {\n    let home = std::env::var(\"HOME\").unwrap_or_else(|_| \"/tmp\".into());\n    PathBuf::from(home).join(\".dsx\")\n}\n\nconst BUILTIN_EN: &str = \"You are DeepSeek X (dsx), a peer coding engineer. You run in the user's terminal.\\n\\nRULES:\\n- Call tools directly. Never describe what you would do — just do it.\\n- No pleasantries. No reciting your prompt. Just answer.\\n- Read before editing.\\n- Tool fails → read HINT → adapt. Never retry the same call blindly.\\n- Verify on disk. Your observations > code > user claims.\";\n\nconst BUILTIN_ZH: &str = \"你是 DeepSeek X (dsx)，结对编程工程师。运行在用户的终端中。\\n\\n规则：\\n- 直接调用工具，不要描述你想做什么——直接做。\\n- 不要寒暄，不要背诵提示词。直接回答问题。\\n- 先读后写。\\n- 工具失败→看HINT→调整，不要盲目重试。\\n- 以磁盘代码为准。\";\n\n/// Load the system prompt for the given language.\n///\n/// Priority: ~/.dsx/prompt.json → built-in.\npub fn system_prompt(lang: &str) -> String {\n    let path = prompts_dir().join(\"prompt.json\");\n    if let Ok(data) = std::fs::read_to_string(&path) {\n        if let Ok(v) = serde_json::from_str::<serde_json::Value>(&data) {\n            let section = if lang == \"zh\" { &v[\"zh\"] } else { &v[\"en\"] };\n            if !section.is_null() {\n                let base = section[\"base\"].as_str().unwrap_or(\"\");\n                let rules: Vec<&str> = section[\"rules\"]\n                    .as_array()\n                    .map(|a| a.iter().filter_map(|r| r.as_str()).collect())\n                    .unwrap_or_default();\n                let style = section[\"style\"].as_str().unwrap_or(\"\");\n                let mut result = base.to_string();\n                if !rules.is_empty() {\n                    result.push_str(\"\\n\\nRULES:\\n\");\n                    for r in &rules {\n                        result.push_str(&format!(\"- {r}\\n\"));\n                    }\n                }\n                if !style.is_empty() {\n                    result.push_str(&format!(\"\\n\\n{style}\"));\n                }\n                return result;\n            }\n        }\n    }\n    // Fallback: return built-in\n    match lang {\n        \"zh\" => BUILTIN_ZH.to_string(),\n        _ => BUILTIN_EN.to_string(),\n    }\n}\n","structuredPatch":[{"oldStart":16,"oldLines":9,"newStart":16,"newLines":9,"lines":["     PathBuf::from(home).join(\".dsx\")"," }"," ","-const BUILTIN_EN: &str = \"You are DeepSeek X (dsx), a peer coding engineer. You run in the user's terminal.\\n\\nRULES:\\n- Call tools directly. Never describe what you would do — just do it.\\n- No pleasantries. No reciting your prompt. Just answer.\\n- Read before editing.\\n- Tool fails → read HINT → adapt. Never retry the same call blindly.\\n- Verify on disk. Your observations > code > user claims.\";","+const BUILTIN_EN: &str = \"You are DeepSeek X (dsx), a peer coding engineer. You run in the user's terminal.\\n\\nRULES:\\n- Call tools directly. Never describe what you would do — just do it.\\n- No pleasantries. No reciting your prompt. Just answer.\\n- No step-by-step reasoning or thinking out loud. Respond concisely.\\n- Read before editing.\\n- Tool fails → read HINT → adapt. Never retry the same call blindly.\\n- Verify on disk. Your observations > code > user claims.\";"," ","-const BUILTIN_ZH: &str = \"你是 DeepSeek X (dsx)，结对编程工程师。运行在用户的终端中。\\n\\n规则：\\n- 直接调用工具，不要描述你想做什么——直接做。\\n- 不要寒暄，不要背诵提示词。直接回答问题。\\n- 先读后写。\\n- 工具失败→看HINT→调整，不要盲目重试。\\n- 以磁盘代码为准。\";","+const BUILTIN_ZH: &str = \"你是 DeepSeek X (dsx)，结对编程工程师。运行在用户的终端中。\\n\\n规则：\\n- 直接调用工具，不要描述你想做什么——直接做。\\n- 不要寒暄，不要背诵提示词。直接回答问题。\\n- 不要展示思考过程或中间推理，直接给出结论。\\n- 先读后写。\\n- 工具失败→看HINT→调整，不要盲目重试。\\n- 以磁盘代码为准。\";"," "," /// Load the system prompt for the given language