       let arguments = tc.get(\"arguments\").and_then(|a| a.as_str()).unwrap_or(\"{}\");\n137\t        if id.is_empty() || name.is_empty() { return None; }\n138\t        Some(ToolCall {\n139\t            id: id.to_string(),\n140\t            call_type: \"function\".to_string(),\n141\t            function: FunctionCall {\n142\t                name: name.to_string(),\n143\t                arguments: arguments.to_string(),\n144\t            },\n145\t        })\n146\t    }).collect()\n147\t}\n148\t\n149\t/// Convert agent.messages to JSON Values for HP protocol.\n150\tfn messages_to_json(messages: &[Message]) -> Vec<serde_json::Value> {\n151\t    messages.iter().filter_map(|m| {\n152\t        let mut v = serde_json::json!({\"role\": m.role.clone()});\n153\t        if let Some(ref c) = m.content { v[\"content\"] = serde_json::json!(c); }\n154\t        if let Some(ref tcs) = m.tool_calls {\n155\t            // Convert to HP flat format\n156\t            let flat: Vec<serde_json::Value> = tcs.iter().map(|tc| {\n157\t                serde_json::json!({\n158\t                    \"id\": tc.id,\n159\t                    \"name\": tc.function.name,\n160\t                    \"arguments\": tc.function.arguments,\n161\t                })\n162\t            }).collect();\n163\t            v[\"tool_calls\"] = serde_json::json!(flat);\n164\t        }\n165\t        // Use \"tool_result\" role for HP protocol compatibility\n166\t        if m.role == \"tool\" {\n167\t            v[\"role\"] = serde_json::json!(\"tool_result\");\n168\t        }\n169\t        if let Some(ref tid) = m.tool_call_id {\n170\t            v[\"tool_call_id\"] = serde_json::json!(tid);\n171\t        }\n172\t        if let Some(ref r) = m.reasoning_content { v[\"reasoning_content\"] = serde_json::json!(r); }\n173\t        if let Some(ref ts) = m.thinking_signature { v[\"thinking_signature\"] = serde_json::json!(ts); }\n174\t        Some(v)\n175\t    }).collect()\n176\t}\n177\t\n178\t/// Build context token estimate using real tokenizer.\n179\tfn estimate_tokens(messages: &[Message]) -> usize {\n180\t    let t = tokenizer::estimate_messages_tokens(messages) as usize;\n181\t    if t > 0 { t } else { messages.len() * 50 }\n182\t}\n183\t\n184\t// ── User input handler (wired) ──\n185\t\n186\t/// Handle a user_input frame with full module integration:\n187\t/// - ContextAssembler for message management\n188\t/// - Skill matching\n189\t/// - Router phase detection\n190\t/// - Gates before tool execution\n191\t/// - Tracker for file operations\n192\t/// - Turn scoring, learning extraction, memory update\n193\t/// - Session persistence\n194\tfn handle_user_input(\n195\t    agent: &mut AgentState,\n196\t    frame: &str,\n197\t    hp_reader: &mut Option<BufReader<Box<dyn std::io::Read + Send>>>,\n198\t    hp_writer: &mut Option<Box<dyn std::io::Write + Send>>,\n199\t    tools_reader: &mut impl BufRead,\n200\t    tools_writer: &mut impl Write,\n201\t    tui_writer: &mut impl Write,\n202\t) {\n203\t    // Parse TUI frame\n204\t    let v: serde_json::Value = match serde_json::from_str(frame) {\n205\t        Ok(v) => v,\n206\t        Err(_) => { let _ = writeln!(tui_writer, \"{{\\\"type\\\":\\\"error\\\",\\\"message\\\":\\\"invalid frame\\\"}}\"); return; }\n207\t    };\n208\t    let text = match v.get(\"text\").and_then(|t| t.as_str()) {\n209\t        Some(t) if !t.is_empty() => t,\n210\t        _ => return,\n211\t    };\n212\t\n213\t    let reader = match hp_reader {\n214\t        Some(r) => r,\n215\t        None => { write_frame(tui_writer, &format!(\"{{\\\"type\\\":\\\"echo\\\",\\\"data\\\":{frame}}}\")); return; }\n216\t    };\n217\t    let writer = match hp_writer {\n218\t        Some(w) => w,\n219\t        None => { write_frame(tui_writer, &format!(\"{{\\\"type\\\":\\\"echo\\\",\\\"data\\\":{frame}}}\")); return; }"}]},"uuid":"ef99e322-cc72-4d5c-a01d-9042b809e914","timestamp":"2026-05-15T05:53:18.595Z","toolUseResult":{"type":"text","file":{"filePath":"/home/qaqtamsy/Desktop/dsx/crates/dsx-agent/src/runner.rs","content":"    agent.session_seed = session::generate_seed();\n    agent.session_start = session::now_epoch();\n    agent.short_mem = memory::ShortTermMemory::new(&agent.session_seed, &agent.config.model);\n    dsc_log::set_session(&agent.session_seed);\n    tools::set_current_session(&agent.session_seed);\n    // Initial live snapshot (empty)\n    session::save_live_snapshot(\n        &agent.session_seed, &agent.messages,\n        &agent.config.model, agent.config.effort.as_deref(), None, None,\n    );\n    eprintln!(\"dsx-agent: new session {}\", agent.session_seed);\n}\n\n/// Save health status line for HP reporting.\nfn health_status(agent: &AgentState) -> String {\n    let assessment = agent.health.assess();\n    format!(\n        \"[{} {} {} | tier:{:?} | {}% | t{}]\",\n        if assessment.level == crate::health::HealthLevel::Red { \"RED\" }\n        else if assessment.level == crate::health::HealthLevel::Yellow { \"YLW\" }\n        else { \"OK\" },\n        assessment.emotion.emoji(),\n        assessment.emotion.label(),\n        agent.health.context_tier,\n        (assessment.success_rate * 100.0) as u32,\n        agent.health.turn,\n    )\n}\n\n// ── Message conversion helpers ──\n\n/// Convert HP tool_calls JSON (flat format) to ToolCall vec.\nfn parse_tool_calls_from_json(tcs: &[serde_json::Value]) -> Vec<ToolCall> {\n    tcs.iter().filter_map(|tc| {\n        let id = tc.get(\"id\").and_then(|i| i.as_str()).unwrap_or(\"\");\n        let name = tc.get(\"name\").and_then(|n| n.as_str()).unwrap_or(\"\");\n        let arguments = tc.get(\"arguments\").and_then(|a| a.as_str()).unwrap_or(\"{}\");\n        if id.is_empty() || name.is_empty() { return None; }\n        Some(ToolCall {\n            id: id.to_string(),\n            call_type: \"function\".to_string(),\n            function: FunctionCall {\n                name: name.to_string(),\n                arguments: arguments.to_string(),\n            },\n        })\n    }).collect()\n}\n\n/// Convert agent.messages to JSON Values for HP protocol.\nfn messages_to_json(messages: &[Message]) -> Vec<serde_json::Value> {\n    messages.iter().filter_map(|m| {\n        let mut v = serde_json::json!({\"role\": m.role.clone()});\n        if let Some(ref c) = m.content { v[\"content\"] = serde_json::json!(c); }\n        if let Some(ref tcs) = m.tool_calls {\n            // Convert to HP flat format\n            let flat: Vec<serde_json::Value> = tcs.iter().map(|tc| {\n                serde_json::json!({\n                    \"id\": tc.id,\n                    \"name\": tc.function.name,\n                    \"arguments\": tc.function.arguments,\n                })\n            }).collect();\n            v[\"tool_calls\"] = serde_json::json!(flat);\n        }\n        // Use \"tool_result\" role for HP protocol compatibility\n        if m.role == \"tool\" {\n            v[\"role\"] = serde_json::json!(\"tool_result\");\n        }\n        if let Some(ref tid) = m.tool_call_id {\n            v[\"tool_call_id\"] = serde_json::json!(tid);\n        }\n        if let Some(ref r) = m.reasoning_content { v[\"reasoning_content\"] = serde_json::json!(r); }\n        if let Some(ref ts) = m.thinking_signature { v[\"thinking_signature\"] = serde_json::json!(ts); }\n        Some(v)\n    }).collect()\n}\n\n/// Build context token estimate using real tokenizer.\nfn estimate_tokens(messages: &[Message]) -> usize {\n    let t = tokenizer::estimate_messages_tokens(messages) as usize;\n    if t > 0 { t } else { messages.len() * 50 }\n}\n\n// ── User input handler (wired) ──\n\n/// Handle a user_input frame with full module integration:\n/// - ContextAssembler for message management\n/// - Skill matching\n/// - Router phase detection\n/// - Gates before tool execution\n/// - Tracker for file operations\n/// - Turn scoring, learning extraction, memory update\n/// - Session persistence\nfn handle_user_input(\n    agent: &mut AgentState,\n    frame: &str,\n    hp_reader: &mut Option<BufReader<Box<dyn std::io::Read + Send>>>,\n    hp_writer: &mut Option<Box<dyn std::io::Write + Send>>,\n    tools_reader: &mut impl BufRead,\n    tools_writer: &mut impl Write,\n    tui_writer: &mut impl Write,\n) {\n    // Parse TUI frame\n    let v: serde_json::Value = match serde_json::from_str(frame) {\n        Ok(v) => v,\n        Err(_) => { let _ = writeln!(tui_writer, \"{{\\\"type\\\":\\\"error\\\",\\\"message\\\":\\\"invalid frame\\\"}}\"); return; }\n    };\n    let text = match v.get(\"text\").and_then(|t| t.as_str()) {\n        Some(t) if !t.is_empty() => t,\n        _ => return,\n    };\n\n    let reader = match hp_reader {\n        Some(r) => r,\n        None => { write_frame(tui_writer, &format!(\"{{\\\"type\\\":\\\"echo\\\",\\\"data\\\":{frame}}}\")); return; }\n    };\n    let writer = match hp_writer {\n        Some(w) => w,\n        None => { write_frame(tui_writer, &format!(\"{{\\\"type\\\":\\\"echo\\\",\\\"data\\\":{frame}}}\")); return; }","numLines":120,"startLine":100,"totalLines":660}},"sourceToolAssistantUUID":"9f68ea16-260e-462b-bcf5-b8dd1a8c49a1","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
