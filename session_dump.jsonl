et reasoning effort\".into()),\n        (\"/lang\".into(),  \"Change language\".into()),\n    ];\n\n    // Terminal setup\n    crossterm::terminal::enable_raw_mode()?;\n    let mut stdout = std::io::stdout();\n    crossterm::execute!(\n        stdout,\n        crossterm::terminal::EnterAlternateScreen,\n        crossterm::cursor::Hide,\n    )?;\n    let mut terminal = ratatui::Terminal::new(ratatui::backend::CrosstermBackend::new(stdout))?;\n    terminal.clear()?;\n\n    // Main event loop\n    let result = event_loop(&mut terminal, &mut conn, &mut state, &mut stream, &commands);\n\n    // Cleanup\n    let _ = terminal.clear();\n    let _ = crossterm::execute!(\n        std::io::stdout(),\n        crossterm::terminal::LeaveAlternateScreen,\n        crossterm::cursor::Show,\n    );\n    crossterm::terminal::disable_raw_mode()?;\n    conn.shutdown();\n\n    result\n}\n\n/// Main ratatui event loop: poll keyboard → handle input → poll agent → render.\nfn event_loop(\n    terminal: &mut ratatui::Terminal<ratatui::backend::CrosstermBackend<std::io::Stdout>>,\n    conn: &mut AgentConnection,\n    state: &mut AppState,\n    stream: &mut StreamBuffer,\n    commands: &[(String, String)],\n) -> anyhow::Result<()> {\n    use crossterm::event::{Event, KeyCode, KeyModifiers};\n\n    loop {\n        // ── Poll keyboard ──\n        if crossterm::event::poll(std::time::Duration::from_millis(16))? {\n            match crossterm::event::read()? {\n                Event::Key(key) => {\n                    // Ctrl+C / Ctrl+D to quit\n                    if key.code == KeyCode::Char('c') && key.modifiers == KeyModifiers::CONTROL\n                        || key.code == KeyCode::Char('d') && key.modifiers == KeyModifiers::CONTROL\n                    {\n                        return Ok(());\n                    }\n\n                    let action = crate::input::chat::handle_chat_key(\n                        &mut state.input_state,\n                        key,\n                        