{"parentUuid":"bbd08fa5-ad56-44b3-ae80-50757adfe0e7","isSidechain":false,"teamName":"dsx-integration","promptId":"e8cab011-c873-483b-b840-3d27ded1852a","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00_GmnziizvNYvnmjiMYLD27521","type":"tool_result","content":"50\t/// 当前会话 seed — 由 TUI 启动时设置，memory 工具使用。\n51\tpub static CURRENT_SESSION: OnceLock<String> = OnceLock::new();\n52\tpub static AUTO_MODE: AtomicBool = AtomicBool::new(false);\n53\t\n54\tpub fn set_current_session(seed: &str) {\n55\t    let _ = CURRENT_SESSION.set(seed.to_string());\n56\t}\n57\t\n58\t// ── 工具键（名称 + 二级操作）──\n59\t\n60\t#[derive(Clone, Debug, PartialEq, Eq, Hash)]\n61\tpub struct ToolKey {\n62\t    pub name: String,\n63\t    pub action: String,\n64\t}\n65\t\n66\timpl ToolKey {\n67\t    pub fn new(name: impl Into<String>, action: impl Into<String>) -> Self {\n68\t        Self { name: name.into(), action: action.into() }\n69\t    }\n70\t}\n71\t\n72\timpl std::fmt::Display for ToolKey {\n73\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n74\t        write!(f, \"{}/{}\", self.name, self.action)\n75\t    }\n76\t}\n77\t\n78\t// ── handler 上下文与返回值 ──\n79\t\n80\t/// handler 执行上下文：包含请求参数和进度通道。\n81\tpub struct ToolCallCtx {\n82\t    pub id: String,\n83\t    pub name: String,\n84\t    pub action: String,\n85\t    pub args: serde_json::Value,\n86\t    /// 可选进度发送通道 — handler 可在执行期间推送进度帧。\n87\t    pub tx_progress: Option<std::sync::mpsc::Sender<String>>,\n88\t}\n89\t\n90\timpl ToolCallCtx {\n91\t    /// 从旧式 name+args 构建（兼容垫片使用）。\n92\t    pub fn from_str(name: &str, action: &str, args: &str) -> Self {\n93\t        let v: serde_json::Value = serde_json::from_str(args).unwrap_or(serde_json::Value::Null);\n94\t        let args = if v.is_null() {\n95\t            // 尝试解析为旧式 JSON 参数\n96\t            serde_json::from_str(args).unwrap_or(serde_json::json!({}))\n97\t        } else {\n98\t            v\n99\t        };\n100\t        Self {\n101\t            id: String::new(),\n102\t            name: name.to_string(),\n103\t            action: action.to_string(),\n104\t            args,\n105\t            tx_progress: None,\n106\t        }\n107\t    }\n108\t\n109\t    /// 便捷方法：读取命名参数。\n110\t    pub fn get_str(&self, key: &str) -> Option<&str> {\n111\t        self.args.get(key).and_then(|v| v.as_str())\n112\t    }\n113\t\n114\t    pub fn get_u64(&self, key: &str) -> Option<u64> {\n115\t        self.args.get(key).and_then(|v| v.as_u64())\n116\t    }\n117\t\n118\t    pub fn get_bool(&self, key: &str) -> Option<bool> {\n119\t        self.args.get(key).and_then(|v| v.as_bool())\n120\t    }\n121\t}\n122\t\n123\t/// handler 返回值。\n124\t#[derive(Clone, Debug)]\n125\tpub struct ToolResult {\n126\t    pub success: bool,\n127\t    pub content: String,\n128\t}\n129\t\n130\timpl ToolResult {\n131\t    pub fn ok(content: impl Into<String>) -> Self {\n132\t        Self { success: true, content: content.into() }\n133\t    }\n134\t\n135\t    pub fn err(content: impl Into<String>) -> Self {\n136\t        Self { success: false, content: content.into() }\n137\t    }\n138\t}\n139\t\n140\t// ── 参数解析工具（供子模块共享）──\n141\t\n142\t/// Parse a string parameter from JSON args (legacy compat).\n143\tpub fn parse_arg(args: &str, key: &str) -> String {\n144\t    serde_json::from_str::<serde_json::Value>(args)\n145\t        .ok()\n146\t        .and_then(|v| v.get(key).and_then(|v| v.as_str()).map(String::from))\n147\t        .unwrap_or_default()\n148\t}\n149\t\n150\tpub fn parse_arg_or(args: &str, key: &str, default: &str) -> String {\n151\t    serde_json::from_str::<serde_json::Value>(args)\n152\t        .ok()\n153\t        .and_then(|v| v.get(key).and_then(|v| v.as_str()).map(String::from))\n154\t        .unwrap_or_else(|| default.to_string())\n155\t}\n156\t\n157\tpub fn parse_opt(args: &str, key: &str) -> Option<String> {\n158\t    serde_json::from_str::<serde_json::Value>(args)\n159\t        .ok()\n160\t        .and_then(|v| v.get(key).and_then(|v| v.as_str()).map(String::from))\n161\t}\n162\t\n163\tpub fn parse_opt_bool(args: &str, key: &str) -> Option<bool> {\n164\t    let v: serde_json::Value = serde_json::from_str(args).ok()?;\n165\t    let val = v.get(key)?;\n166\t    val.as_bool().or_else(|| val.as_str().and_then(|s| s.parse::<bool>().ok()))\n167\t}\n168\t\n169\t// ── 工具句柄 ──\n170\t\n171\t/// 一个工具操作（name/action）的完整定义。\n172\tpub struct ToolHandler {\n173\t    pub key: ToolKey,\n174\t    pub description: &'static str,\n175\t    pub input_schema: serde_json::Value,\n176\t    pub handler: fn(ToolCallCtx) -> ToolResult,\n177\t    pub safety: fn(&ToolCallCtx) -> SafetyVerdict,\n178\t    pub default_timeout: Duration,\n179\t}\n180\t\n181\timpl ToolHandler {\n182\t    pub fn to_tool_def(&self) -> ToolDef {\n183\t        ToolDef {\n184\t            call_type: \"function\".into(),\n185\t            function: dsx_types::ToolFunction {\n186\t                name: self.key.name.to_string(),\n187\t                description: self.description.to_string(),\n188\t                parameters: self.input_schema.clone(),\n189\t            },\n190\t        }\n191\t    }\n192\t}\n193\t\n194\t// ── ToolManager ──\n195\t\n196\tpub struct ToolManager {\n197\t    handlers: HashMap<ToolKey, ToolHandler>,\n198\t    /// 若 Some，仅允许列表中 name 的工具通过。\n199\t    allowed: Option<Vec<String>>,\n200\t    /// inflight 任务的取消标志（id → should_cancel）。\n201\t    inflight_tasks: HashMap<String, Arc<AtomicBool>>,\n202\t}\n203\t\n204\timpl ToolManager {\n205\t    pub fn new() -> Self {\n206\t        Self {\n207\t            handlers: HashMap::new(),\n208\t            allowed: None,\n209\t            inflight_tasks: HashMap::new(),\n210\t        }\n211\t    }\n212\t\n213\t    // ── 注册 ──\n214\t\n215\t    pub fn register(&mut self, handler: ToolHandler) {\n216\t        self.handlers.insert(handler.key.clone(), handler);\n217\t    }\n218\t\n219\t    // ── Init（IPC 中由 ToolsInit 帧触发）──\n220\t\n221\t    pub fn apply_init(&mut self, allowed_tools: Vec<String>, session_seed: &str, auto_mode: bool) {\n222\t        self.allowed = Some(allowed_tools);\n223\t        let _ = CURRENT_SESSION.set(session_seed.to_string());\n224\t        AUTO_MODE.store(auto_mode, std::sync::atomic::Ordering::Relaxed);\n225\t    }\n226\t\n227\t    // ── 定义查询 ──\n228\t\n229\t    pub fn all_defs(&self) -> Vec<ToolDef> {\n230\t        // 按 name 分组，每个 name 只暴露第一个 action 的定义（保持兼容）\n231\t        let mut seen = std::collections::HashSet::new();\n232\t        let mut defs = Vec::new();\n233\t        // 按工具名固定顺序排列\n234\t        for name in &[\"explore\", \"exec\", \"read_file\", \"write_file\", \"edit_file\", \"edit_file_diff\", \"list_dir\", \"search\", \"list_skills\", \"read_skill_ref\", \"glance\", \"web\", \"git\"] {\n235\t            for (key, handler) in &self.handlers {\n236\t                if key.name == *name && seen.insert(key.name.clone()) {\n237\t                    defs.push(handler.to_tool_def());\n238\t                }\n239\t            }\n240\t        }\n241\t        // 未在排序列表中的工具\n242\t        for (key, handler) in &self.handlers {\n243\t            if seen.insert(key.name.clone()) {\n244\t                defs.push(handler.to_tool_def());\n245\t            }\n246\t        }\n247\t        defs\n248\t    }\n249\t\n250\t    pub fn all_anthropic_defs(&self) -> Vec<AnthropicTool> {\n251\t        // 先用 Vec<(usize, AnthropicTool)> 收集，保持原始注册顺序\n252\t        let mut tools: Vec<AnthropicTool> = Vec::new();\n253\t        for def in self.all_defs() {\n254\t            tools.push(AnthropicTool {\n255\t                name: def.function.name,\n256\t                description: def.function.description,\n257\t                input_schema: def.function.parameters,\n258\t            });\n259\t        }\n260\t        tools\n261\t    }\n262\t\n263\t    pub fn filtered_defs(&self) -> Vec<ToolDef> {\n264\t        match &self.allowed {\n265\t            Some(allowed) => self.all_defs().into_iter()\n266\t                .filter(|d| allowed.contains(&d.function.name))\n267\t                .collect(),\n268\t            None => self.all_defs(),\n269\t        }\n270\t    }\n271\t\n272\t    // ── 安全分类（兼容垫片用）──\n273\t\n274\t    pub fn classify_tool(&self, name: &str, args: &str, action: &str) -> (SafetyLevel, String) {\n275\t        let key = ToolKey::new(name, action);\n276\t        let args_val: serde_json::Value = serde_json::from_str(args).unwrap_or(serde_json::Value::Null);\n277\t        match self.handlers.get(&key) {\n278\t            Some(h) => {\n279\t                let ctx = ToolCallCtx {\n280\t                    id: String::new(),\n281\t                    name: name.to_string(),\n282\t                    action: action.to_string(),\n283\t                    args: args_val,\n284\t                    tx_progress: None,\n285\t                };\n286\t                match (h.safety)(&ctx) {\n287\t                    SafetyVerdict::Allow => (SafetyLevel::Safe, String::new()),\n288\t                    SafetyVerdict::Confirm(p) => (SafetyLevel::Confirm, p),\n289\t                    SafetyVerdict::Block(p) => (SafetyLevel::Danger, p),\n290\t                }\n291\t            }\n292\t            None => (SafetyLevel::Confirm, format!(\"Allow {}?\", name)),\n293\t        }\n294\t    }\n295\t\n296\t    // ── 执行（兼容垫片入口）──\n297\t\n298\t    /// 同步执行（向后兼容）。IPC 模式下请走 `handle_frame`。\n299\t    pub fn execute(&self, name: &str, args: &str, action: &str) -> String {\n300\t        CANCEL.store(false, std::sync::atomic::Ordering::Relaxed);\n301\t        let key = ToolKey::new(name, action);\n302\t        let Some(handler) = self.handlers.get(&key) else {\n303\t            // 尝试不带 action（旧式单层调用）\n304\t            let fallback = self.handlers.iter()\n305\t                .find(|(k, _)| k.name == name)\n306\t                .map(|(_, h)| h);\n307\t            return match fallback {\n308\t                Some(h) => self.execute_handler(h, name, action, args),\n309\t                None => format!(\"[ERROR] Unknown tool: {}/{}\\n[HINT] Available tools: explore, exec, read_file, write_file, edit_file, edit_file_diff, list_dir, search, list_skills, read_skill_ref, glance, web, git\", name, action),\n310\t            };\n311\t        };\n312\t        self.execute_handler(handler, name, action, args)\n313\t    }\n314\t\n315\t    fn execute_handler(&self, handler: &ToolHandler, name: &str, action: &str, args: &str) -> String {\n316\t        use std::sync::mpsc;\n317\t        let args_val: serde_json::Value = serde_json::from_str(args).unwrap_or(serde_json::Value::Null);\n318\t\n319\t        // 提取超时值（在 args_val 被 move 之前）\n320\t        let timeout_override = args_val.get(\"timeout_secs\")\n321\t            .and_then(|v| v.as_u64())\n322\t            .filter(|&n| n > 0 && n <= 3600);\n323\t\n324\t        // 安全检查\n325\t        let ctx = ToolCallCtx {\n326\t            id: String::new(),\n327\t            name: name.to_string(),\n328\t            action: action.to_string(),\n329\t            args: args_val,\n330\t            tx_progress: None,\n331\t        };\n332\t        match (handler.safety)(&ctx) {\n333\t            SafetyVerdict::Block(reason) => {\n334\t                return format!(\"[ERROR] Blocked: {}\", reason);\n335\t            }\n336\t            SafetyVerdict::Confirm(_) => { /* 兼容模式下自动允许 */ }\n337\t            SafetyVerdict::Allow => {}\n338\t        }\n339\t\n340\t        // 超时计算\n341\t        let timeout = timeout_override\n342\t            .map(Duration::from_secs)\n343\t            .unwrap_or(handler.default_timeout);\n344\t\n345\t        let (tx, rx) = mpsc::channel::<Result<ToolResult, Box<dyn std::any::Any + Send>>>();\n346\t        let handler_fn = handler.handler; // fn pointer is Copy + 'static\n347\t        let ctx = ToolCallCtx {\n348\t            id: String::new(),\n349\t            name: name.to_string(),\n350\t            action: action.to_string(),\n351\t            args: ctx.args,\n352\t            tx_progress: None,\n353\t        };\n354\t        std::thread::spawn(move || {\n355\t            let _ = tx.send(std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {\n356\t                (handler_fn)(ctx)\n357\t            })));\n358\t        });\n359\t\n360\t        match rx.recv_timeout(timeout) {\n361\t            Ok(Ok(tr)) => tr.content,\n362\t            Ok(Err(panic_info)) => {\n363\t                let msg = if let Some(s) = panic_info.downcast_ref::<String>() { s.clone() }\n364\t                    else if let Some(s) = panic_info.downcast_ref::<&str>() { s.to_string() }\n365\t                    else { \"unknown panic\".to_string() };\n366\t                format!(\"[ERROR] Tool '{}/{}' panicked\\n[HINT] Report this to the user. Panic: {}\", name, action, msg)\n367\t            }\n368\t            Err(mpsc::RecvTimeoutError::Timeout) => {\n369\t                format!(\"[ERROR] Tool '{}/{}' timed out after {}s\", name, action, timeout.as_secs())\n370\t            }\n371\t            Err(mpsc::RecvTimeoutError::Disconnected) => {\n372\t                format!(\"[ERROR] Tool '{}/{}' crashed (thread panicked)\", name, action)\n373\t            }\n374\t        }\n375\t    }\n376\t\n377\t    // ── IPC 路由 ──\n378\t\n379\t    /// 处理一个入站 CallReq 帧，返回对应的出站帧。\n380\t    pub fn handle_req(&mut self, id: String, name: &str, action: &str, args: serde_json::Value, timeout_secs: Option<u64>) -> ipc::OutboundFrame {\n381\t        // 授权检查\n382\t        if let Some(ref allowed) = self.allowed {\n383\t            if !allowed.contains(&name.to_string()) {\n384\t                return ipc::OutboundFrame::ToolError {\n385\t                    id, error: format!(\"Tool '{}' not in allowed list\", name), code: \"FORBIDDEN\".into(),\n386\t                };\n387\t            }\n388\t        }\n389\t\n390\t        let key = ToolKey::new(name, action);\n391\t        let Some(handler) = self.handlers.get(&key) else {\n392\t            return ipc::OutboundFrame::ToolError {\n393\t                id, error: format!(\"Unknown tool: {}/{}\", name, action), code: \"UNKNOWN_TOOL\".into(),\n394\t            };\n395\t        };\n396\t\n397\t        // 安全检查\n398\t        let ctx = ToolCallCtx {\n399\t            id: id.clone(),\n400\t            name: name.to_string(),\n401\t            action: action.to_string(),\n402\t            args: args.clone(),\n403\t            tx_progress: None,\n404\t        };\n405\t        match (handler.safety)(&ctx) {\n406\t            SafetyVerdict::Block(reason) => {\n407\t                return ipc::OutboundFrame::ToolError {\n408\t                    id, error: reason, code: \"BLOCKED\".into(),\n409\t                };\n410\t            }\n411\t            SafetyVerdict::Confirm(prompt) => {\n412\t                return ipc::OutboundFrame::ToolConfirmReq {\n413\t                    id, tool_name: name.into(), action: action.into(),\n414\t                    danger_level: \"confirm\".into(), prompt,\n415\t                };\n416\t            }\n417\t            SafetyVerdict::Allow => {}\n418\t        }\n419\t\n420\t        // 超时\n421\t        let timeout = timeout_secs\n422\t            .filter(|&n| n > 0 && n <= 3600)\n423\t            .map(Duration::from_secs)\n424\t            .unwrap_or(handler.default_timeout);\n425\t\n426\t        // 执行（带进度通道、Panic 捕获、超时）\n427\t        let (tx_progress, rx_progress) = std::sync::mpsc::channel::<String>();\n428\t        let cancel_flag = Arc::new(AtomicBool::new(false));\n429\t        let cancel_flag_for_handler = cancel_flag.clone();\n430\t        self.inflight_tasks.insert(id.clone(), cancel_flag);\n431\t\n432\t        let ctx = ToolCallCtx {\n433\t            id: id.clone(),\n434\t            name: name.to_string(),\n435\t            action: action.to_string(),\n436\t            args,\n437\t            tx_progress: Some(tx_progress),\n438\t        };\n439\t\n440\t        // 先消费所有已有的进度消息（同步模式下 pre-collect）\n441\t        let mut progress_lines = Vec::new();\n442\t\n443\t        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {\n444\t            (handler.handler)(ctx)\n445\t        }));\n446\t\n447\t        // 消费剩余进度\n448\t        while let Ok(line) = rx_progress.try_recv() {\n449\t            progress_lines.push(line);\n450\t        }\n451\t\n452\t        self.inflight_tasks.remove(&id);\n453\t\n454\t        let (content, success, is_error) = match result {\n455\t            Ok(tr) => (tr.content, tr.success, if !tr.success { Some(true) } else { None }),\n456\t            Err(panic_info) => {\n457\t                let msg = if let Some(s) = panic_info.downcast_ref::<String>() { s.clone() }\n458\t                    else if let Some(s) = panic_info.downcast_ref::<&str>() { s.to_string() }\n459\t                    else { \"unknown panic\".to_string() };\n460\t                (format!(\"[ERROR] Tool panicked: {}\", msg), false, Some(true))\n461\t            }\n462\t        };\n463\t\n464\t        ipc::OutboundFrame::ToolResultMessage {\n465\t            id,\n466\t            name: name.into(),\n467\t            action: action.into(),\n468\t            success,\n469\t            content,\n470\t            is_error,\n471\t        }\n472\t    }\n473\t\n474\t    /// 取消工具。\n475\t    pub fn cancel_tool(&mut self, id: Option<&str>) {\n476\t        match id {\n477\t            Some(specific) => {\n478\t                if let Some(flag) = self.inflight_tasks.get(specific) {\n479\t                    flag.store(true, std::sync::atomic::Ordering::SeqCst);\n480\t                }\n481\t            }\n482\t            None => {\n483\t                CANCEL.store(true, std::sync::atomic::Ordering::SeqCst);\n484\t                for flag in self.inflight_tasks.values() {\n485\t                    flag.store(true, std::sync::atomic::Ordering::SeqCst);\n486\t                }\n487\t            }\n488\t        }\n489\t    }\n490\t}\n491\t\n492\t// ── 全局管理器 ──\n493\t\n494\tstatic TOOLS: OnceLock<std::sync::Mutex<ToolManager>> = OnceLock::new();\n495\t\n496\tfn manager_mutex() -> &'static std::sync::Mutex<ToolManager> {\n497\t    TOOLS.get_or_init(|| {\n498\t        std::sync::Mutex::new(registration::build_tool_manager())\n499\t    })\n500\t}\n501\t\n502\t// ── 公开 API（兼容现有调用者）──\n503\t\n504\tpub fn all_tools() -> Vec<ToolDef> {\n505\t    manager_mutex().lock().unwrap().all_defs()\n506\t}\n507\t\n508\tpub fn all_anthropic_tools() -> Vec<AnthropicTool> {\n509\t    manager_mutex().lock().unwrap().all_anthropic_defs()\n510\t}\n511\t\n512\tpub fn tools_for_phase(_phase: TaskPhase) -> Vec<ToolDef> {\n513\t    all_tools()\n514\t}\n515\t\n516\tpub fn tools_for_flash() -> Vec<ToolDef> {\n517\t    let keep: &[&str] = &[\"explore\", \"exec\", \"read_file\", \"write_file\", \"edit_file\", \"edit_file_diff\", \"list_dir\", \"search\", \"list_skills\", \"read_skill_ref\", \"glance\", \"web\"];\n518\t    all_tools().into_iter()\n519\t        .filter(|t| keep.contains(&t.function.name.as_str()))\n520\t        .collect()\n521\t}\n522\t\n523\tpub fn classify_tool(name: &str, action: &str, args: &str) -> (SafetyLevel, String) {\n524\t    manager_mutex().lock().unwrap().classify_tool(name, args, action)\n525\t}\n526\t\n527\tpub fn execute_tool(name: &str, args: &str) -> String {\n528\t    // 兼容垫片：从 JSON 中提取 action 字段，若无则默认为首个 action\n529\t    let action: String = serde_json::from_str::<serde_json::Value>(args)\n530\t        .ok()\n531\t        .and_then(|v| v.get(\"action\").and_then(|v| v.as_str()).map(String::from))\n532\t        .unwrap_or_default();\n533\t    manager_mutex().lock().unwrap().execute(name, args, &action)\n534\t}\n535\t\n536\t/// Wrap a tool result with the tool name for traceability in multi-tool turns.\n537\tpub fn wrap_tool_result(name: &str, result: &str) -> String {\n538\t    format!(\"── {} ──\\n{}\", name, result)\n539\t}\n540\t\n541\t// ── 兼容函数：旧调用点直接引用 exec::exec_command 等 ──\n542\t\n543\t// 这些由 exec.rs 中的 pub use 导出\n544\t"}]},"uuid":"109a3ce6-1b2e-4771-a10d-ca646b343d66","timestamp":"2026-05-15T05:48:59.637Z","toolUseResult":{"type":"text","file":{"filePath":"/home/qaqtamsy/Desktop/dsx/crates/dsx-tools/src/lib.rs","content":"/// 当前会话 seed — 由 TUI 启动时设置，memory 工具使用。\npub static CURRENT_SESSION: OnceLock<String> = OnceLock::new();\npub static AUTO_MODE: AtomicBool = AtomicBool::new(false);\n\npub fn set_current_session(seed: &str) {\n    let _ = CURRENT_SESSION.set(seed.to_string());\n}\n\n// ── 工具键（名称 + 二级操作）──\n\n#[derive(Clone, Debug, PartialEq, Eq, Hash)]\npub struct ToolKey {\n    pub name: String,\n    pub action: String,\n}\n\nimpl ToolKey {\n    pub fn new(name: impl Into<String>, action: impl Into<String>) -> Self {\n        Self { name: name.into(), action: action.into() }\n    }\n}\n\nimpl std::fmt::Display for ToolKey {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        write!(f, \"{}/{}\", self.name, self.action)\n    }\n}\n\n// ── handler 上下文与返回值 ──\n\n/// handler 执行上下文：包含请求参数和进度通道。\npub struct ToolCallCtx {\n    pub id: String,\n    pub name: String,\n    pub action: String,\n    pub args: serde_json::Value,\n    /// 可选进度发送通道 — handler 可在执行期间推送进度帧。\n    pub tx_progress: Option<std::sync::mpsc::Sender<String>>,\n}\n\nimpl ToolCallCtx {\n    /// 从旧式 name+args 构建（兼容垫片使用）。\n    pub fn from_str(name: &str, action: &str, args: &str) -> Self {\n        let v: serde_json::Value = serde_json::from_str(args).unwrap_or(serde_json::Value::Null);\n        let args = if v.is_null() {\n            // 尝试解析为旧式 JSON 参数\n            serde_json::from_str(args).unwrap_or(serde_json::json!({}))\n        } else {\n            v\n        };\n        Self {\n            id: String::new(),\n            name: name.to_string(),\n            action: action.to_string(),\n            args,\n            tx_progress: None,\n        }\n    }\n\n    /// 便捷方法：读取命名参数。\n    pub fn get_str(&self, key: &str) -> Option<&str> {\n        self.args.get(key).and_then(|v| v.as_str())\n    }\n\n    pub fn get_u64(&self, key: &str) -> Option<u64> {\n        self.args.get(key).and_then(|v| v.as_u64())\n    }\n\n    pub fn get_bool(&self, key: &str) -> Option<bool> {\n        self.args.get(key).and_then(|v| v.as_bool())\n    }\n}\n\n/// handler 返回值。\n#[derive(Clone, Debug)]\npub struct ToolResult {\n    pub success: bool,\n    pub content: String,\n}\n\nimpl ToolResult {\n    pub fn ok(content: impl Into<String>) -> Self {\n        Self { success: true, content: content.into() }\n    }\n\n    pub fn err(content: impl Into<String>) -> Self {\n        Self { success: false, content: content.into() }\n    }\n}\n\n// ── 参数解析工具（供子模块共享）──\n\n/// Parse a string parameter from JSON args (legacy compat).\npub fn parse_arg(args: &str, key: &str) -> String {\n    serde_json::from_str::<serde_json::Value>(args)\n        .ok()\n        .and_then(|v| v.get(key).and_then(|v| v.as_str()).map(String::from))\n        .unwrap_or_default()\n}\n\npub fn parse_arg_or(args: &str, key: &str, default: &str) -> String {\n    serde_json::from_str::<serde_json::Value>(args)\n        .ok()\n        .and_then(|v| v.get(key).and_then(|v| v.as_str()).map(String::from))\n        .unwrap_or_else(|| default.to_string())\n}\n\npub fn parse_opt(args: &str, key: &str) -> Option<String> {\n    serde_json::from_str::<serde_json::Value>(args)\n        .ok()\n        .and_then(|v| v.get(key).and_then(|v| v.as_str()).map(String::from))\n}\n\npub fn parse_opt_bool(args: &str, key: &str) -> Option<bool> {\n    let v: serde_json::Value = serde_json::from_str(args).ok()?;\n    let val = v.get(key)?;\n    val.as_bool().or_else(|| val.as_str().and_then(|s| s.parse::<bool>().ok()))\n}\n\n// ── 工具句柄 ──\n\n/// 一个工具操作（name/action）的完整定义。\npub struct ToolHandler {\n    pub key: ToolKey,\n    pub description: &'static str,\n    pub input_schema: serde_json::Value,\n    pub handler: fn(ToolCallCtx) -> ToolResult,\n    pub safety: fn(&ToolCallCtx) -> SafetyVerdict,\n    pub default_timeout: Duration,\n}\n\nimpl ToolHandler {\n    pub fn to_tool_def(&self) -> ToolDef {\n        ToolDef {\n            call_type: \"function\".into(),\n            function: dsx_types::ToolFunction {\n                name: self.key.name.to_string(),\n                description: self.description.to_string(),\n                parameters: self.input_schema.clone(),\n            },\n        }\n    }\n}\n\n// ── ToolManager ──\n\npub struct ToolManager {\n    handlers: HashMap<ToolKey, ToolHandler>,\n    /// 若 Some，仅允许列表中 name 的工具通过。\n    allowed: Option<Vec<String>>,\n    /// inflight 任务的取消标志（id → should_cancel）。\n    inflight_tasks: HashMap<String, Arc<AtomicBool>>,\n}\n\nimpl ToolManager {\n    pub fn new() -> Self {\n        Self {\n            handlers: HashMap::new(),\n            allowed: None,\n            inflight_tasks: HashMap::new(),\n        }\n    }\n\n    // ── 注册 ──\n\n    pub fn register(&mut self, handler: ToolHandler) {\n        self.handlers.insert(handler.key.clone(), handler);\n    }\n\n    // ── Init（IPC 中由 ToolsInit 帧触发）──\n\n    pub fn apply_init(&mut self, allowed_tools: Vec<String>, session_seed: &str, auto_mode: bool) {\n        self.allowed = Some(allowed_tools);\n        let _ = CURRENT_SESSION.set(session_seed.to_string());\n        AUTO_MODE.store(auto_mode, std::sync::atomic::Ordering::Relaxed);\n    }\n\n    // ── 定义查询 ──\n\n    pub fn all_defs(&self) -> Vec<ToolDef> {\n        // 按 name 分组，每个 name 只暴露第一个 action 的定义（保持兼容）\n        let mut seen = std::collections::HashSet::new();\n        let mut defs = Vec::new();\n        // 按工具名固定顺序排列\n        for name in &[\"explore\", \"exec\", \"read_file\", \"write_file\", \"edit_file\", \"edit_file_diff\", \"list_dir\", \"search\", \"list_skills\", \"read_skill_ref\", \"glance\", \"web\", \"git\"] {\n            for (key, handler) in &self.handlers {\n                if key.name == *name && seen.insert(key.name.clone()) {\n                    defs.push(handler.to_tool_def());\n                }\n            }\n        }\n        // 未在排序列表中的工具\n        for (key, handler) in &self.handlers {\n            if seen.insert(key.name.clone()) {\n                defs.push(handler.to_tool_def());\n            }\n        }\n        defs\n    }\n\n    pub fn all_anthropic_defs(&self) -> Vec<AnthropicTool> {\n        // 先用 Vec<(usize, AnthropicTool)> 收集，保持原始注册顺序\n        let mut tools: Vec<AnthropicTool> = Vec::new();\n        for def in self.all_defs() {\n            tools.push(AnthropicTool {\n                name: def.function.name,\n                description: def.function.description,\n                input_schema: def.function.parameters,\n            });\n        }\n        tools\n    }\n\n    pub fn filtered_defs(&self) -> Vec<ToolDef> {\n        match &self.allowed {\n            Some(allowed) => self.all_defs().into_iter()\n                .filter(|d| allowed.contains(&d.function.name))\n                .collect(),\n            None => self.all_defs(),\n        }\n    }\n\n    // ── 安全分类（兼容垫片用）──\n\n    pub fn classify_tool(&self, name: &str, args: &str, action: &str) -> (SafetyLevel, String) {\n        let key = ToolKey::new(name, action);\n        let args_val: serde_json::Value = serde_json::from_str(args).unwrap_or(serde_json::Value::Null);\n        match self.handlers.get(&key) {\n            Some(h) => {\n                let ctx = ToolCallCtx {\n                    id: String::new(),\n                    name: name.to_string(),\n                    action: action.to_string(),\n                    args: args_val,\n                    tx_progress: None,\n                };\n                match (h.safety)(&ctx) {\n                    SafetyVerdict::Allow => (SafetyLevel::Safe, String::new()),\n                    SafetyVerdict::Confirm(p) => (SafetyLevel::Confirm, p),\n                    SafetyVerdict::Block(p) => (SafetyLevel::Danger, p),\n                }\n            }\n            None => (SafetyLevel::Confirm, format!(\"Allow {}?\", name)),\n        }\n    }\n\n    // ── 执行（兼容垫片入口）──\n\n    /// 同步执行（向后兼容）。IPC 模式下请走 `handle_frame`。\n    pub fn execute(&self, name: &str, args: &str, action: &str) -> String {\n        CANCEL.store(false, std::sync::atomic::Ordering::Relaxed);\n        let key = ToolKey::new(name, action);\n        let Some(handler) = self.handlers.get(&key) else {\n            // 尝试不带 action（旧式单层调用）\n            let fallback = self.handlers.iter()\n                .find(|(k, _)| k.name == name)\n                .map(|(_, h)| h);\n            return match fallback {\n                Some(h) => self.execute_handler(h, name, action, args),\n                None => format!(\"[ERROR] Unknown tool: {}/{}\\n[HINT] Available tools: explore, exec, read_file, write_file, edit_file, edit_file_diff, list_dir, search, list_skills, read_skill_ref, glance, web, git\", name, action),\n            };\n        };\n        self.execute_handler(handler, name, action, args)\n    }\n\n    fn execute_handler(&self, handler: &ToolHandler, name: &str, action: &str, args: &str) -> String {\n        use std::sync::mpsc;\n        let args_val: serde_json::Value = serde_json::from_str(args).unwrap_or(serde_json::Value::Null);\n\n        // 提取超时值（在 args_val 被 move 之前）\n        let timeout_override = args_val.get(\"timeout_secs\")\n            .and_then(|v| v.as_u64())\n            .filter(|&n| n > 0 && n <= 3600);\n\n        // 安全检查\n        let ctx = ToolCallCtx {\n            id: String::new(),\n            name: name.to_string(),\n            action: action.to_string(),\n            args: args_val,\n            tx_progress: None,\n        };\n        match (handler.safety)(&ctx) {\n            SafetyVerdict::Block(reason) => {\n                return format!(\"[ERROR] Blocked: {}\", reason);\n            }\n            SafetyVerdict::Confirm(_) => { /* 兼容模式下自动允许 */ }\n            SafetyVerdict::Allow => {}\n        }\n\n        // 超时计算\n        let timeout = timeout_override\n            .map(Duration::from_secs)\n            .unwrap_or(handler.default_timeout);\n\n        let (tx, rx) = mpsc::channel::<Result<ToolResult, Box<dyn std::any::Any + Send>>>();\n        let handler_fn = handler.handler; // fn pointer is Copy + 'static\n        let ctx = ToolCallCtx {\n            id: String::new(),\n            name: name.to_string(),\n            action: action.to_string(),\n            args: ctx.args,\n            tx_progress: None,\n        };\n        std::thread::spawn(move || {\n            let _ = tx.send(std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {\n                (handler_fn)(ctx)\n            })));\n        });\n\n        match rx.recv_timeout(timeout) {\n            Ok(Ok(tr)) => tr.content,\n            Ok(Err(panic_info)) => {\n                let msg = if let Some(s) = panic_info.downcast_ref::<String>() { s.clone() }\n                    else if let Some(s) = panic_info.downcast_ref::<&str>() { s.to_string() }\n                    else { \"unknown panic\".to_string() };\n                format!(\"[ERROR] Tool '{}/{}' panicked\\n[HINT] Report this to the user. Panic: {}\", name, action, msg)\n            }\n            Err(mpsc::RecvTimeoutError::Timeout) => {\n                format!(\"[ERROR] Tool '{}/{}' timed out after {}s\", name, action, timeout.as_secs())\n            }\n            Err(mpsc::RecvTimeoutError::Disconnected) => {\n                format!(\"[ERROR] Tool '{}/{}' crashed (thread panicked)\", name, action)\n            }\n        }\n    }\n\n    // ── IPC 路由 ──\n\n    /// 处理一个入站 CallReq 帧，返回对应的出站帧。\n    pub fn handle_req(&mut self, id: String, name: &str, action: &str, args: serde_json::Value, timeout_secs: Option<u64>) -> ipc::OutboundFrame {\n        // 授权检查\n        if let Some(ref allowed) = self.allowed {\n            if !allowed.contains(&name.to_string()) {\n                return ipc::OutboundFrame::ToolError {\n                    id, error: format!(\"Tool '{}' not in allowed list\", name), code: \"FORBIDDEN\".into(),\n                };\n            }\n        }\n\n        let key = ToolKey::new(name, action);\n        let Some(handler) = self.handlers.get(&key) else {\n            return ipc::OutboundFrame::ToolError {\n                id, error: format!(\"Unknown tool: {}/{}\", name, action), code: \"UNKNOWN_TOOL\".into(),\n            };\n        };\n\n        // 安全检查\n        let ctx = ToolCallCtx {\n            id: id.clone(),\n            name: name.to_string(),\n            action: action.to_string(),\n            args: args.clone(),\n            tx_progress: None,\n        };\n        match (handler.safety)(&ctx) {\n            SafetyVerdict::Block(reason) => {\n                return ipc::OutboundFrame::ToolError {\n                    id, error: reason, code: \"BLOCKED\".into(),\n                };\n            }\n            SafetyVerdict::Confirm(prompt) => {\n                return ipc::OutboundFrame::ToolConfirmReq {\n                    id, tool_name: name.into(), action: action.into(),\n                    danger_level: \"confirm\".into(), prompt,\n                };\n            }\n            SafetyVerdict::Allow => {}\n        }\n\n        // 超时\n        let timeout = timeout_secs\n            .filter(|&n| n > 0 && n <= 3600)\n            .map(Duration::from_secs)\n            .unwrap_or(handler.default_timeout);\n\n        // 执行（带进度通道、Panic 捕获、超时）\n        let (tx_progress, rx_progress) = std::sync::mpsc::channel::<String>();\n        let cancel_flag = Arc::new(AtomicBool::new(false));\n        let cancel_flag_for_handler = cancel_flag.clone();\n        self.inflight_tasks.insert(id.clone(), cancel_flag);\n\n        let ctx = ToolCallCtx {\n            id: id.clone(),\n            name: name.to_string(),\n            action: action.to_string(),\n            args,\n            tx_progress: Some(tx_progress),\n        };\n\n        // 先消费所有已有的进度消息（同步模式下 pre-collect）\n        let mut progress_lines = Vec::new();\n\n        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {\n            (handler.handler)(ctx)\n        }));\n\n        // 消费剩余进度\n        while let Ok(line) = rx_progress.try_recv() {\n            progress_lines.push(line);\n        }\n\n        self.inflight_tasks.remove(&id);\n\n        let (content, success, is_error) = match result {\n            Ok(tr) => (tr.content, tr.success, if !tr.success { Some(true) } else { None }),\n            Err(panic_info) => {\n                let msg = if let Some(s) = panic_info.downcast_ref::<String>() { s.clone() }\n                    else if let Some(s) = panic_info.downcast_ref::<&str>() { s.to_string() }\n                    else { \"unknown panic\".to_string() };\n                (format!(\"[ERROR] Tool panicked: {}\", msg), false, Some(true))\n            }\n        };\n\n        ipc::OutboundFrame::ToolResultMessage {\n            id,\n            name: name.into(),\n            action: action.into(),\n            success,\n            content,\n            is_error,\n        }\n    }\n\n    /// 取消工具。\n    pub fn cancel_tool(&mut self, id: Option<&str>) {\n        match id {\n            Some(specific) => {\n                if let Some(flag) = self.inflight_tasks.get(specific) {\n                    flag.store(true, std::sync::atomic::Ordering::SeqCst);\n                }\n            }\n            None => {\n                CANCEL.store(true, std::sync::atomic::Ordering::SeqCst);\n                for flag in self.inflight_tasks.values() {\n                    flag.store(true, std::sync::atomic::Ordering::SeqCst);\n                }\n            }\n        }\n    }\n}\n\n// ── 全局管理器 ──\n\nstatic TOOLS: OnceLock<std::sync::Mutex<ToolManager>> = OnceLock::new();\n\nfn manager_mutex() -> &'static std::sync::Mutex<ToolManager> {\n    TOOLS.get_or_init(|| {\n        std::sync::Mutex::new(registration::build_tool_manager())\n    })\n}\n\n// ── 公开 API（兼容现有调用者）──\n\npub fn all_tools() -> Vec<ToolDef> {\n    manager_mutex().lock().unwrap().all_defs()\n}\n\npub fn all_anthropic_tools() -> Vec<AnthropicTool> {\n    manager_mutex().lock().unwrap().all_anthropic_defs()\n}\n\npub fn tools_for_phase(_phase: TaskPhase) -> Vec<ToolDef> {\n    all_tools()\n}\n\npub fn tools_for_flash() -> Vec<ToolDef> {\n    let keep: &[&str] = &[\"explore\", \"exec\", \"read_file\", \"write_file\", \"edit_file\", \"edit_file_diff\", \"list_dir\", \"search\", \"list_skills\", \"read_skill_ref\", \"glance\", \"web\"];\n    all_tools().into_iter()\n        .filter(|t| keep.contains(&t.function.name.as_str()))\n        .collect()\n}\n\npub fn classify_tool(name: &str, action: &str, args: &str) -> (SafetyLevel, String) {\n    manager_mutex().lock().unwrap().classify_tool(name, args, action)\n}\n\npub fn execute_tool(name: &str, args: &str) -> String {\n    // 兼容垫片：从 JSON 中提取 action 字段，若无则默认为首个 action\n    let action: String = serde_json::from_str::<serde_json::Value>(args)\n        .ok()\n        .and_then(|v| v.get(\"action\").and_then(|v| v.as_str()).map(String::from))\n        .unwrap_or_default();\n    manager_mutex().lock().unwrap().execute(name, args, &action)\n}\n\n/// Wrap a tool result with the tool name for traceability in multi-tool turns.\npub fn wrap_tool_result(name: &str, result: &str) -> String {\n    format!(\"── {} ──\\n{}\", name, result)\n}\n\n// ── 兼容函数：旧调用点直接引用 exec::exec_command 等 ──\n\n// 这些由 exec.rs 中的 pub use 导出\n","numLines":495,"startLine":50,"totalLines":544}},"sourceToolAssistantUUID":"bbd08fa5-ad56-44b3-ae80-50757adfe0e7","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
