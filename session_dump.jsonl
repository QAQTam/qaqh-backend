timpl ContextAssembler {\n165\t    // ── Construction ──\n166\t\n167\t    pub fn new() -> Self {\n168\t        Self {\n169\t            system_messages: Vec::new(),\n170\t            turns: Vec::new(),\n171\t            pending_annotations: Vec::new(),\n172\t            dirty: false,\n173\t        }\n174\t    }\n175\t\n176\t    // ── System messages ──\n177\t\n178\t    pub fn push_system(&mut self, msg: Message) {\n179\t        assert_eq!(msg.role, \"system\", \"push_system requires role=system\");\n180\t        self.system_messages.push(msg);\n181\t        self.dirty = true;\n182\t    }\n183\t\n184\t    pub fn set_system_messages(&mut self, msgs: Vec<Message>) {\n185\t        self.system_messages = msgs;\n186\t        self.dirty = true;\n187\t    }\n188\t\n189\t    // ── User messages ──\n190\t\n191\t    /// Push a user message. Fails if the current turn has incomplete steps.\n192\t    pub fn push_user(&mut self, text: &str) -> Result<(), AssemblerError> {\n193\t        if let Some(last) = self.turns.last() {\n194\t            if !last.all_steps_satisfied() {\n195\t                return Err(AssemblerError::TurnIncomplete {\n196\t                    missing: format!(\n197\t                        \"{} step(s) with missing tool results — cannot push user yet\",\n198\t                        last.total_missing_tools()\n199\t                    ),\n200\t                });\n201\t            }\n202\t            if last.steps.is_empty() {\n203\t                return Err(AssemblerError::TurnIncomplete {\n204\t                    missing: \"current turn has no assistant response yet\".into(),\n205\t                });\n206\t            }\n207\t        }\n208\t        self.turns.push(Turn::new(Message::user(text)));\n209\t        self.dirty = true;\n210\t        Ok(())\n211\t    }\n212\t\n213\t    /// Push user unconditionally (session restore, repair).\n214\t    pub fn push_user_unchecked(&mut self, text: &str) {\n215\t        if let Some(last) = self.turns.last_mut() {\