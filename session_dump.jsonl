{"parentUuid":"db5f2267-6374-47f7-9906-17212e8f186f","isSidechain":false,"teamName":"dsx-integration","attachment":{"type":"edited_text_file","filename":"/home/qaqtamsy/Desktop/dsx/crates/dsx-hp/src/runner.rs","snippet":"1\t//! dsx-hp — Health Platform daemon.\n2\t//!\n3\t//! A lightweight daemon that tracks process liveness, runs the health\n4\t//! judgment pipeline, and exposes a `HealthProbe` service over TCP.\n5\t//!\n6\t//! ## IPC protocol\n7\t//!\n8\t//! JSON-LP frames over TCP `localhost`. Port written to\n9\t//! `$XDG_RUNTIME_DIR/dsx/hp.port`.\n10\t//!\n11\t//! ## Build\n12\t//!\n13\t//! This is a separate binary target. Add to `Cargo.toml`:\n14\t//!\n15\t//! ```toml\n16\t//! [[bin]]\n17\t//! name = \"dsx-hp\"\n18\t//! path = \"src/dsx-hp/main.rs\"\n19\t//! ```\n20\t//!\n21\t//! ## Startup sequence\n22\t//!\n23\t//! 1. Parse CLI args (port, log level).\n24\t//! 2. Bind TCP listener on `127.0.0.1:{port}`.\n25\t//! 3. Write port to `$XDG_RUNTIME_DIR/dsx/hp.port`.\n26\t//! 4. Enter accept loop — one thread per connection.\n27\t//! 5. On SIGTERM/SIGINT: write empty port file, drain connections, exit.\n28\t\n29\tuse std::io::{BufRead, BufReader, Write};\n30\tuse std::net::{TcpListener, TcpStream};\n31\tuse std::sync::{mpsc, Arc, Mutex, OnceLock};\n32\tuse std::thread;\n33\tuse std::time::Duration;\n34\t\n35\tuse crate::config::Config;\n36\tuse crate::ipc_traits::HealthProbe;\n37\tuse crate::monitor;\n38\tuse crate::pipeline::judge;\n39\tuse crate::registry::ProcessRegistry;\n40\tuse crate::types::{HpError, ProcessKind, Verdict};\n41\tuse crate::StreamEvent;\n42\tuse dsx_gateway::GatewayConfig;\n43\tuse dsx_types::{AnthropicContent, AnthropicMessage, Message};\n44\t\n45\tstatic HP_CONFIG: OnceLock<Config> = OnceLock::new();\n46\t\n47\t// ── Health service implementation ──\n48\t\n49\t/// Concrete implementation of the `HealthProbe` trait.\n50\t///\n51\t/// Owns the process registry and delegates pipeline judgment.\n52\t/// Runs synchronously; the IPC layer wraps calls in async tasks.\n53\tstruct HealthService {\n54\t    registry: ProcessRegistry,\n55\t}\n56\t\n57\timpl HealthService {\n58\t    fn new(timeout_secs: u64) -> Self {\n59\t        Self {\n60\t            registry: ProcessRegistry::new(timeout_secs),\n61\t        }\n62\t    }\n63\t}\n64\t\n65\timpl HealthProbe for HealthService {\n66\t    fn register(\n67\t        &mut self,\n68\t        kind: ProcessKind,\n69\t        name: &str,\n70\t        pid: u32,\n71\t    ) -> Result<(), HpError> {\n72\t        self.registry.register(kind, name, pid)\n73\t    }\n74\t\n75\t    fn heartbeat(&mut self, pid: u32) -> Result<(), HpError> {\n76\t        self.registry.heartbeat(pid)\n77\t    }\n78\t\n79\t    fn unregister(&mut self, pid: u32) -> Result<(), HpError> {\n80\t        self.registry.unregister(pid)\n81\t    }\n82\t\n83\t    fn judge(&self) -> Vec<Verdict> {\n84\t        let monitor_state = monitor::MonitorState::new();\n85\t        judge(&self.registry, &monitor_state)\n86\t    }\n87\t\n88\t    fn query(&self, pid: u32) -> Result<crate::types::ProcessHealth, HpError> {\n89\t        self.registry.health(pid)\n90\t    }\n91\t\n92\t    fn list_processes(&self) -> Vec<crate::types::ProcessSummary> {\n93\t        self.registry.summaries()\n94\t    }\n95\t}\n96\t\n97\t// ── Main ──\n98\t\n99\t/// Load API config: ~/.dsx/config.json, with env var override.\n100\tfn load_hp_config() -> Config {\n101\t    let env_key = std::env::var(\"ANTHROPIC_AUTH_TOKEN\").unwrap_or_default();\n102\t    let env_url = std::env::var(\"ANTHROPIC_BASE_URL\").unwrap_or_default();\n103\t\n104\t    if !env_key.is_empty() {\n105\t        return Config {\n106\t            base_url: if env_url.is_empty() { \"https://api.deepseek.com\".into() } else { env_url },\n107\t            api_key: env_key,\n108\t            protocol: \"anthropic\".into(),\n109\t        };\n110\t    }\n111\t\n112\t    let cfg_path = std::path::PathBuf::from(\n113\t        std::env::var(\"HOME\").unwrap_or_else(|_| \"/tmp\".into()),\n114\t    ).join(\".dsx\").join(\"config.json\");\n115\t\n116\t    if let Ok(data) = std::fs::read_to_string(&cfg_path) {\n117\t        if let Ok(v) = serde_json::from_str::<serde_json::Value>(&data) {\n118\t            let api_key = v.get(\"api_key\").and_then(|k| k.as_str()).unwrap_or(\"\").to_string();\n119\t            let base_url = v.get(\"base_url\").and_then(|b| b.as_str()).unwrap_or(\"https://api.deepseek.com\").to_string();\n120\t            if !api_key.is_empty() {\n121\t                return Config { base_url, api_key, protocol: \"anthropic\".into() };\n122\t            }\n123\t        }\n124\t    }\n125\t\n126\t    Config { base_url: \"https://api.deepseek.com\".into(), api_key: String::new(), protocol: \"anthropic\".into() }\n127\t}\n128\t\n129\tpub fn run() {\n130\t    // 0. Load API config\n131\t    let hp_cfg = load_hp_config();\n132\t    if hp_cfg.api_key.is_empty() {\n133\t        eprintln!(\"dsx-hp: WARNING — no API key configured, run 'dsx config' to set up\");\n134\t    } else {\n135\t        let _ = HP_CONFIG.set(hp_cfg);\n136\t        eprintln!(\"dsx-hp: API proxy configured\");\n137\t    }\n138\t\n139\t    // 1. CLI defaults\n140\t    let port = std::env::var(\"DSX_HP_PORT\")\n141\t        .ok()\n142\t        .and_then(|v| v.parse::<u16>().ok())\n143\t        .unwrap_or(0); // 0 = OS-assigned\n144\t\n145\t    let timeout_secs = std::env::var(\"DSX_HP_TIMEOUT\")\n146\t        .ok()\n147\t        .and_then(|v| v.parse::<u64>().ok())\n148\t        .unwrap_or(30);\n149\t\n150\t    let addr = format!(\"127.0.0.1:{port}\");\n151\t\n152\t    // 2. Bind TCP listener\n153\t    let listener = TcpListener::bind(&addr).expect(\"dsx-hp: failed to bind TCP listener\");\n154\t    let actual_port = listener.local_addr().unwrap().port();\n155\t\n156\t    // 3. Write port file\n157\t    write_port_file(actual_port);\n158\t    eprintln!(\"dsx-hp: listening on 127.0.0.1:{actual_port} (timeout={timeout_secs}s)\");\n159\t\n160\t    // 4. Create health service\n161\t    let service = Arc::new(Mutex::new(HealthService::new(timeout_secs)));\n162\t\n163\t    // 5. Accept loop\n164\t    let (_shutdown_tx, shutdown_rx) = mpsc::channel::<()>();\n165\t\n166\t    // Register self as the HP process\n167\t    {\n168\t        let mut svc = service.lock().unwrap();\n169\t        svc.register(ProcessKind::Tui, \"dsx-hp\", std::process::id())\n170\t            .ok();\n171\t    }\n172\t\n173\t    // Heartbeat ticker — self-heartbeat every 15s\n174\t    let svc_heartbeat = service.clone();\n175\t    let _hb_ticker = thread::spawn(move || loop {\n176\t        thread::sleep(Duration::from_secs(15));\n177\t        if shutdown_rx.try_recv().is_ok() {\n178\t            break;\n179\t        }\n180\t        if let Ok(mut svc) = svc_heartbeat.lock() {\n181\t            svc.heartbeat(std::process::id()).ok();\n182\t        }\n183\t    });\n184\t\n185\t    // Signal handler (SIGINT/SIGTERM)\n186\t    let svc_shutdown = service.clone();\n187\t    let _sig_handler = thread::spawn(move || {\n188\t        let _ = svc_shutdown;\n189\t        thread::park();\n190\t    });\n191\t\n192\t    // Accept connections\n193\t    for stream in listener.incoming() {\n194\t        match stream {\n195\t            Ok(stream) => {\n196\t                let svc = service.clone();\n197\t                thread::spawn(|| handle_connection(stream, svc));\n198\t            }\n199\t            Err(e) => {\n200\t                eprintln!(\"dsx-hp: accept error: {e}\");\n201\t            }\n202\t        }\n203\t    }\n204\t\n205\t    // Cleanup on exit\n206\t    clear_port_file();\n207\t}\n208\t\n209\t// ── Connection handler ──\n210\t\n211\tfn handle_connection(\n212\t    stream: TcpStream,\n213\t    service: Arc<Mutex<HealthService>>,\n214\t) {\n215\t    let peer = stream.peer_addr().ok();\n216\t    let mut reader = BufReader::new(stream.try_clone().unwrap());\n217\t\n218\t    let mut buf = String::new();\n219\t    loop {\n220\t        buf.clear();\n221\t        match reader.read_line(&mut buf) {\n222\t            Ok(0) => break, // EOF\n223\t            Ok(_) => {\n224\t                let trimmed = buf.trim();\n225\t                if trimmed.is_empty() {\n226\t                    continue;\n227\t                }\n228\t                if trimmed.contains(\"\\\"api_chat\\\"\") {\n229\t                    if let Ok(mut w) = stream.try_clone() {\n230\t                        handle_api_chat_streaming(trimmed, &mut w);\n231\t                    }\n232\t                } else {\n233\t                    let response = dispatch_frame(trimmed, &service);\n234\t                    if let Ok(mut w) = stream.try_clone() {\n235\t                        let _ = writeln!(w, \"{response}\");\n236\t                        let _ = w.flush();\n237\t                    }\n238\t                }\n239\t            }\n240\t            Err(_) => break,\n241\t        }\n242\t    }\n243\t\n244\t    if let Some(addr) = peer {\n\n... [371 lines truncated] ..."},"type":"attachment","uuid":"d08bfc1e-79c9-4f6a-89d1-9cab019203a6","timestamp":"2026-05-15T08:42:03.718Z","userType":"external","entrypoint":"cli","cwd":"/home/qaqtamsy/Desktop/dsx","sessionId":"40da231b-9053-442b-b857-d081c20c78fb","version":"2.1.142","gitBranch":"master","slug":"gentle-orbiting-karp"}
