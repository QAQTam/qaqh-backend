l,\n}\n\npub mod app;\npub mod commands;\npub mod mode;\npub mod state;\npub mod status;\npub mod tui_text;\npub mod utils;\npub mod workspace;\n\npub mod input {\n    pub mod chat;\n    pub mod confirm;\n    pub mod picker;\n    pub mod sudo;\n    pub mod action;\n    pub mod state;\n}\n\npub mod render;\n\n// ── Phase 4 stubs for cross-crate dependencies ──\n\n/// Path to the HP daemon's port file.\nfn hp_port_path() -> std::path::PathBuf {\n    let home = std::env::var(\"HOME\").unwrap_or_else(|_| \"/tmp\".into());\n    std::path::PathBuf::from(home).join(\".dsx\").join(\"hp.port\")\n}\n\n/// Auto-start the HP daemon if it isn't already running.\n/// Verifies the port is actually reachable (not a stale port file).\nfn ensure_hp_running() {\n    let port_path = hp_port_path();\n\n    // If port file exists, verify HP is actually alive\n    if port_path.exists() {\n        if let Ok(port_str) = std::fs::read_to_string(&port_path) {\n            if let Ok(port) = port_str.trim().parse::<u16>() {\n                if std::net::TcpStream::connect_timeout(\n                    &format!(\"127.0.0.1:{port}\").parse().unwrap(),\n                    std::time::Duration::from_millis(200),\n                ).is_ok() {\n                    return; // HP is alive\n                }\n            }\n        }\n        // Stale port file — remove and restart\n        let _ = std::fs::remove_file(&port_path);\n    }\n\n    eprintln!(\"dsx: starting HP daemon...\");\n    let exe = match std::env::current_exe() {\n        Ok(e) => e,\n        Err(_) => return,\n    };\n    // Spawn HP in background (detached)\n    let _ = Command::new(&exe)\n        .arg(\"hp\")\n        .stdout(Stdio::null())\n        .stderr(Stdio::null())\n        .spawn();\n    // Wait for port file (up to 5s)\n    for _ in 0..50 {\n        if port_path.exists() { return; }\n        std::thread::sleep(std::time::Duration::from_millis(100));\n    }\n    eprintln!(\"dsx: WARNING — HP daemon did not start in time\")